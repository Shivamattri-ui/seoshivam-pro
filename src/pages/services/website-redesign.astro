  html.light .bb .ui-cl .ai-a{color:#141413}
  html.light .bb .ui-cl .ai-cite{background:#F0EEE6;color:#3D3D3A}
  html.light .bb .ui-cl .ai-comp{background:#fff;box-shadow:0 0 0 1px rgba(0,0,0,.08),0 4px 14px rgba(0,0,0,.05);color:#73726C}
  /* Google AI Mode */
  .bb .ui-gg{background:#1F1F1F;color:#E3E3E3;font-family:'Google Sans','Google Sans Text',Roboto,Arial,sans-serif}
  .bb .ui-gg .ai-head{gap:10px;font-size:15px;color:#E3E3E3}
  .bb .ui-gg .ai-head img{width:20px;height:20px}
  .bb .ui-gg .ai-head b{font-weight:500}
  .bb .ui-gg .ai-q{background:#303134;border-radius:22px 22px 6px 22px;padding:10px 18px;font-size:15px;line-height:1.5}
  .bb .ui-gg .ai-a{font-size:15.5px;line-height:1.7;color:#E3E3E3}
  .bb .ui-gg .ai-a b{font-weight:500;color:#fff}
  .bb .ui-gg .ai-cite{background:#303134;color:#A8C7FA;padding:1px 7px}
  .bb .ui-gg .ai-cite svg{width:13px;height:13px}
