    border:1.5px dashed color-mix(in srgb,var(--wm) 75%,transparent);background:color-mix(in srgb,var(--stage) 60%,transparent)}
  .lk .pg-void .url{margin:0;color:var(--wd);background:transparent;box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--wm) 40%,transparent)}
