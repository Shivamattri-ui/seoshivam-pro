  .sp-ph-main{scale:1.02;transition:scale 1.6s cubic-bezier(.16,1,.3,1)}
  /* motion clones: the long-exposure copy of the same frame. --land/--lx come from the scroll landing, hover overrides them */
  .sp-ph-g{background-image:var(--sp-phm);transition:translate 1.1s cubic-bezier(.16,1,.3,1),opacity .8s ease}
