  .lk .g-url{font:500 11.5px var(--fm);color:var(--wm);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-decoration:line-through;text-decoration-color:color-mix(in srgb,var(--wm) 70%,transparent)}
  .lk .pg-sm .g-url{font-size:10px}
  .lk .slip{position:absolute;font:500 11px/1.5 var(--fm);border-radius:9px;white-space:nowrap}
  .lk .slip-code{left:12px;bottom:calc(100% + 8px);padding:7px 11px 8px;background:var(--code);color:var(--code-ink);box-shadow:0 0 0 1px rgba(255,255,255,.07),0 10px 24px rgba(0,0,0,.45)}
  .lk .slip-code::after{content:'';position:absolute;left:22px;top:100%;width:2px;height:9px;background:rgba(255,255,255,.14)}
  .lk .slip-k{display:block;font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:#6C6860}
