  .bb .ui-cl .ai-a b{font-weight:600}
  .bb .ui-cl .ai-cite{font-family:ui-sans-serif,system-ui,sans-serif;background:#141413;color:#C2C0B6;border-radius:6px}
  .bb .ui-cl .ai-mark{width:22px;height:22px;margin-top:10px;transition:opacity .4s ease}
  .bb .ui-cl .ai-think img{width:22px;height:22px;animation:clSpin 1.6s ease-in-out infinite}
  @keyframes clSpin{50%{rotate:45deg;scale:.85}}
  .bb .ui-cl .ai-comp{background:#30302E;border-radius:18px;height:58px;box-shadow:0 0 0 1px rgba(255,255,255,.06);color:#9C9A92}
  .bb .ui-cl .ai-send{background:#C6613F;color:#fff;border-radius:10px;width:32px;height:32px}
  html.light .bb .ui-cl{background:#FAF9F5;color:#3D3D3A}
  html.light .bb .ui-cl .ai-head b{color:#141413}
  html.light .bb .ui-cl .ai-q{background:#F0EEE6;color:#141413}
