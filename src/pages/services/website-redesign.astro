  .inc-d{font-size:clamp(14.5px,1.05vw,15.5px);line-height:1.7;color:var(--wd);text-wrap:pretty}
  .inc-d strong{font-weight:600;color:var(--w)}

  /* glyph tiles are tiny pages: an old page on paper (kept) or a new brand page (rebuilt) */
  .inc-g{position:relative;display:grid;place-items:center;width:92px;height:70px;padding-top:9px;border-radius:10px;transition:transform .45s cubic-bezier(.16,1,.3,1)}
  .inc-g svg{width:44px;height:44px;overflow:visible;fill:none;stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round}
  .inc-g text{font:600 8px var(--fm);stroke:none;letter-spacing:.02em}
  .inc-g--ink{overflow:hidden;transform:rotate(var(--tilt,-1.5deg));background:linear-gradient(180deg,var(--paper),var(--paper-2));
    box-shadow:inset 0 0 0 1px var(--paper-edge),0 2px 4px rgba(var(--shadow),.3),0 12px 24px rgba(var(--shadow),.3)}
  .inc-it:nth-child(even) .inc-g--ink{--tilt:1.6deg}
  html.light .inc-g--ink{box-shadow:inset 0 0 0 1px var(--paper-edge),0 1px 2px rgba(var(--shadow),.1),0 8px 18px rgba(var(--shadow),.1)}
  .inc-g--ink::before{content:'';position:absolute;left:0;right:0;top:0;height:9px;background:var(--paper-bar)}
  .inc-g--ink::after{content:'';position:absolute;inset:0;border-radius:inherit;opacity:.35;mix-blend-mode:multiply;pointer-events:none;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .55 0 0 0 0 .5 0 0 0 0 .42 0 0 0 .55 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}
  .inc-g--ink svg{stroke:var(--ink)}
  .inc-g--ink .m{stroke:color-mix(in srgb,var(--paper-ink) 45%,transparent)}
  .inc-g--ink .fill{fill:var(--ink);stroke:none}
  .inc-g--ink text{fill:var(--ink)}
  .inc-g--lit{background:linear-gradient(165deg,var(--card-hi) 0%,var(--card) 62%);
    box-shadow:inset 0 0 0 1px var(--card-edge),inset 0 1px 0 rgba(255,255,255,.07),0 2px 4px rgba(var(--shadow),.35),0 14px 30px -8px color-mix(in srgb,var(--ac) 26%,transparent)}
  html.light .inc-g--lit{box-shadow:inset 0 0 0 1px var(--card-edge),0 1px 2px rgba(var(--shadow),.08),0 10px 22px -8px color-mix(in srgb,var(--ac) 30%,transparent)}
  .inc-g--lit::before{content:'';position:absolute;left:8px;top:7px;width:6px;height:6px;border-radius:50%;background:var(--ac);box-shadow:0 0 8px var(--ac)}
  .inc-g--lit svg{stroke:var(--ac);filter:drop-shadow(0 0 5px color-mix(in srgb,var(--ac) 50%,transparent))}
  html.light .inc-g--lit svg{filter:none}
  .inc-g--lit .m{stroke:color-mix(in srgb,var(--wd) 55%,transparent)}
  .inc-g--lit .fill{fill:var(--ac);stroke:none}
  @media (hover:hover) and (pointer:fine){
    .inc-it:hover .inc-g{transform:translateY(-3px)}
    .inc-it:hover .inc-g--ink{transform:translateY(-3px) rotate(0deg)}
  }

  /* ── smaller screens ────────────────────────────────────── */
  @media (max-width:1100px){
    .inc-grp{grid-template-columns:minmax(0,1fr)}
    .inc-lab{flex-direction:row;align-items:center;gap:24px}
    .inc-obj{flex:0 0 auto;transform:scale(.8);transform-origin:left center;margin-right:-44px}
  }
  @media (max-width:900px){
    .lk-hdr{flex-direction:column;align-items:flex-start;gap:20px}
    .lk-story{grid-template-columns:minmax(0,1fr)}
    .lk-stage-col{display:none}
    .lk-item{min-height:0;padding:30px 0 34px;grid-template-columns:34px minmax(0,1fr);cursor:auto}
    html.js .lk-item:not(.is-on){opacity:1}
    .lk-item .lk-n{color:var(--bad)}
    /* the scene breaks out of the text column so it renders near full size */
    .lk.is-ready .lk-inline{display:block;position:relative;margin:22px 0 0 -44px;width:calc(100% + 44px);aspect-ratio:340/420;max-width:460px}
    .lk-inline .lk-box{border-radius:20px}
    .lk-foot{grid-template-columns:minmax(0,1fr)}
    .lk-check{grid-row:auto;height:70px;width:130px}
  }
  @media (max-width:760px){
    .inc-hdr{flex-direction:column;align-items:flex-start;gap:20px}
    .inc-items{grid-template-columns:minmax(0,1fr)}
    .inc-it:nth-child(2){padding-top:26px}
    .inc-it:nth-child(2)::before{content:'';position:absolute;left:0;right:0;top:0;height:1px;background:var(--rule)}
    .inc-it{grid-template-columns:76px minmax(0,1fr)}
    .inc-g{width:76px;height:60px;padding-top:8px}
