  .lk .slip-paper{padding:9px 12px 10px;background:linear-gradient(180deg,#EDE8DD,#E1DBCE);color:#3C3A36;box-shadow:0 1px 2px rgba(60,50,30,.25),0 12px 26px rgba(0,0,0,.35)}
  html.light .lk .slip-paper{box-shadow:0 1px 2px rgba(60,50,30,.14),0 10px 22px rgba(70,48,24,.14)}
  .lk .slip-paper .slip-k{color:#8A8478}
