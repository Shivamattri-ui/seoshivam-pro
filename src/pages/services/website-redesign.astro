  /* group objects: the hero's materials. They settle in once, when the group arrives. */
  .inc-obj{position:relative;width:220px;height:150px}
  .inc .pp{position:absolute;width:150px;height:98px;border-radius:10px;overflow:hidden;background:linear-gradient(180deg,var(--paper),var(--paper-2));border:1px solid var(--paper-edge);
    box-shadow:0 2px 4px rgba(var(--shadow),.35),0 14px 28px rgba(var(--shadow),.38);transition:translate .6s cubic-bezier(.16,1,.3,1),opacity .4s ease}
  html.light .inc .pp{box-shadow:0 1px 2px rgba(var(--shadow),.12),0 10px 22px rgba(var(--shadow),.14)}
  .inc .pp::after{content:'';position:absolute;inset:0;opacity:.35;mix-blend-mode:multiply;pointer-events:none;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .55 0 0 0 0 .5 0 0 0 0 .42 0 0 0 .55 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}
  .inc .pp .bar{height:12px;background:var(--paper-bar)}
  .inc .pp .tt{margin:9px auto 0;width:60%;height:6px;border-radius:2px;background:color-mix(in srgb,var(--paper-ink) 55%,transparent)}
  .inc .pp .ln{margin:6px auto 0;width:74%;height:3px;border-radius:2px;background:color-mix(in srgb,var(--paper-ink) 25%,transparent)}
  .inc .pp .u{position:absolute;left:8px;right:8px;bottom:8px;padding:4px 6px;border-radius:5px;font:500 10px/1 var(--fm);color:#4A4740;background:rgba(255,255,255,.55);white-space:nowrap}
  .inc .pp1{left:4px;top:30px;rotate:-8deg}
  .inc .pp2{left:28px;top:18px;rotate:4deg;transition-delay:.08s}
  .inc .pp3{left:52px;top:36px;rotate:-2deg;transition-delay:.16s}
  .inc .stp{position:absolute;left:96px;top:58px;rotate:-12deg;display:flex;flex-direction:column;align-items:center;gap:2px;padding:5px 11px 4px;border-radius:10px;
    font-family:var(--fm);line-height:1;white-space:nowrap;color:var(--ink);border:2px solid currentColor;outline:1.5px solid currentColor;outline-offset:2.5px;
    mix-blend-mode:multiply;opacity:.92;transition:opacity .2s ease .5s,scale .3s cubic-bezier(.34,1.56,.64,1) .5s,rotate .3s cubic-bezier(.34,1.56,.64,1) .5s}
  .inc .stp b{font-size:18px;font-weight:600;letter-spacing:.05em}
  .inc .stp small{font-size:8.5px;letter-spacing:.06em;text-transform:uppercase}
  .inc .np{position:absolute;left:18px;top:18px;width:184px;height:118px;border-radius:12px;padding:10px 12px;display:flex;flex-direction:column;
    background:linear-gradient(165deg,var(--card-hi) 0%,var(--card) 62%);border:1px solid var(--card-edge);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.07),0 2px 4px rgba(var(--shadow),.4),0 16px 34px rgba(var(--shadow),.45);transition:translate .7s cubic-bezier(.16,1,.3,1) .1s,opacity .5s ease .1s}
  html.light .inc .np{box-shadow:inset 0 1px 0 #fff,0 1px 2px rgba(var(--shadow),.12),0 12px 26px rgba(var(--shadow),.14)}
  .inc .np i{width:7px;height:7px;border-radius:50%;background:var(--ac);box-shadow:0 0 10px var(--ac)}
  .inc .np .nt{margin-top:auto;font-family:var(--fd);font-style:italic;font-size:24px;line-height:1;color:var(--w)}
  .inc .np .nu{margin-top:8px;padding:5px 6px;border-radius:5px;font:500 10px/1 var(--fm);color:var(--w);background:color-mix(in srgb,var(--ac) 11%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--ac) 24%,transparent)}
  .inc .bloom{position:absolute;left:50%;top:50%;width:300px;height:220px;margin:-110px 0 0 -150px;border-radius:50%;pointer-events:none;
    background:radial-gradient(closest-side,color-mix(in srgb,var(--ac) 30%,transparent),color-mix(in srgb,var(--ac2) 10%,transparent) 55%,transparent);transition:opacity .9s ease,scale .9s cubic-bezier(.16,1,.3,1)}
  html.light .inc .bloom{opacity:.6}
  html.js .inc-grp:not(.is-in) .pp{opacity:0;translate:0 -22px}
  html.js .inc-grp:not(.is-in) .stp{opacity:0;scale:2.2;rotate:-30deg}
  html.js .inc-grp:not(.is-in) .np{opacity:0;translate:0 18px}
  html.js .inc-grp:not(.is-in) .bloom{opacity:0;scale:.7}

  .inc-items{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:clamp(28px,3.6vw,64px);align-content:start}
  .inc-it{position:relative;display:grid;grid-template-columns:92px minmax(0,1fr);gap:clamp(16px,1.6vw,22px);padding:26px 0;align-items:start}
  .inc-it:nth-child(n+3)::before{content:'';position:absolute;left:0;right:0;top:0;height:1px;background:var(--rule)}
  .inc-it:nth-child(-n+2){padding-top:4px}
