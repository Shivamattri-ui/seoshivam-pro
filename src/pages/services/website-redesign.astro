  @keyframes ggShim{to{background-position:-200% 0}}
  .bb .ui-gg .ai-src{display:flex;gap:10px;margin-top:14px;transition:opacity .4s ease,translate .5s cubic-bezier(.16,1,.3,1)}
  .bb .ui-gg .ai-card{flex:1;max-width:260px;padding:12px 14px;border-radius:16px;background:#282A2C;font-size:13px;line-height:1.45}
  .bb .ui-gg .ai-card small{display:flex;align-items:center;gap:7px;color:#C4C7C5;font-size:12px;margin-bottom:5px}
  .bb .ui-gg .ai-card small i{width:16px;height:16px;border-radius:50%;background:#4C8DF6}
