  /* the numbers */
  .bb-stats{display:grid;gap:clamp(26px,3vw,40px)}
  .bb-stat{display:grid;grid-template-columns:auto minmax(0,1fr);gap:clamp(16px,2vw,28px);align-items:center;padding-top:clamp(22px,2.6vw,34px);position:relative}
  .bb-stat::before{content:'';position:absolute;left:0;right:0;top:0;height:1px;background:var(--bb-rule)}
  .bb-n{font-family:var(--fd);font-weight:400;font-size:clamp(84px,8.6vw,138px);line-height:.82;letter-spacing:-.04em;color:var(--w);font-variant-numeric:tabular-nums;min-width:2.05ch}
  .bb-n sup{font-size:.42em;vertical-align:.95em;margin-left:.04em;font-style:italic;color:var(--ac)}
  .bb-stat p{font-size:clamp(16px,1.35vw,19px);line-height:1.5;color:var(--w);max-width:20rem;text-wrap:pretty}
  .bb-src{font-size:14px;line-height:1.7;color:var(--wd)}
  .bb-both{margin:clamp(64px,8vw,120px) auto clamp(40px,5vw,64px);max-width:22em;text-align:center;font-family:var(--fd);font-weight:400;font-size:clamp(30px,3.4vw,50px);line-height:1.12;letter-spacing:-.018em;color:var(--w);text-wrap:balance}
  .bb-both em{font-style:italic;color:var(--ac)}

  /* four points, each with the recommended vendor's own page fragment */
  .bb-pts{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(16px,1.8vw,28px)}
  .bb-pt{display:flex;flex-direction:column;gap:18px}
  .bb-fr{position:relative;height:172px;border-radius:16px;padding:16px;overflow:hidden;display:flex;flex-direction:column;gap:9px;container-type:inline-size;
    background:linear-gradient(165deg,var(--bb-card-hi),var(--bb-card) 70%);box-shadow:inset 0 0 0 1px var(--bb-edge),inset 0 1px 0 rgba(255,255,255,.06),0 2px 6px rgba(var(--bb-sh),.3),0 22px 44px -26px rgba(var(--bb-sh),.8);
    transition:translate .5s cubic-bezier(.16,1,.3,1),box-shadow .5s ease}
  html.light .bb-fr{box-shadow:inset 0 0 0 1px var(--bb-edge),0 1px 3px rgba(var(--bb-sh),.08),0 16px 34px -22px rgba(var(--bb-sh),.3)}
  @media (hover:hover) and (pointer:fine){.bb-pt:hover .bb-fr{translate:0 -4px;box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--ac) 55%,transparent),0 26px 50px -24px color-mix(in srgb,var(--ac) 45%,transparent)}}
  .bb-fr::before{content:'';position:absolute;left:14px;top:12px;width:6px;height:6px;border-radius:50%;background:var(--ac);box-shadow:0 0 8px var(--ac)}
  .bb-fr-k{margin-left:14px;margin-top:-4px;font:500 10.5px var(--fm);letter-spacing:.02em;color:var(--wm);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  /* one line per row, always: a label column and a value column, like a real spec block */
  .bb-fr-h{margin:0;font:700 13.5px/1.3 var(--fu);letter-spacing:-.01em;color:var(--w);white-space:nowrap}
  .bb-fr-l{margin:0;display:grid;grid-template-columns:76px minmax(0,1fr);align-items:baseline;font:500 12.5px/1.45 var(--fu);color:var(--wd);white-space:nowrap}
  .bb-fr-l b{font-weight:700;color:var(--w)}
  .bb-sk{display:block;height:8px;border-radius:4px;background:var(--bb-sk2)}
  /* highlighter: a soft marker sweeps behind the line that answers the question */
  .bb-hl{padding:0 2px;margin:0 -2px;border-radius:2px;color:var(--w);
    background:linear-gradient(color-mix(in srgb,var(--ac) 24%,transparent),color-mix(in srgb,var(--ac) 24%,transparent)) no-repeat 0 0/var(--hl,100%) 100%;
    transition:background-size .7s cubic-bezier(.65,0,.35,1) var(--dl,0s)}
  html.js .bb-pt:not(.is-in) .bb-hl{--hl:0%}
  .bb-fr-row{display:flex;align-items:flex-end;flex:1}
  /* the proof sits under the claim as one row: the number, then what it counts */
  .bb-fr-case{flex:1;min-width:0;border-radius:11px;padding:9px 12px;display:flex;align-items:center;gap:12px;background:color-mix(in srgb,var(--ac) 12%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--ac) 30%,transparent);
    transition:opacity .45s ease .2s,translate .55s cubic-bezier(.16,1,.3,1) .2s}
  html.js .bb-pt:not(.is-in) .bb-fr-case{opacity:0;translate:10px 0}
  .bb-fr-case b{font-family:var(--fd);font-weight:400;font-size:min(36px,12.5cqi);line-height:.9;color:var(--w)}
  .bb-fr-case span{display:flex;flex-direction:column;gap:3px;min-width:0}
  .bb-fr-case small{font:500 min(9.5px,3.9cqi) var(--fm);letter-spacing:.03em;color:var(--wd);white-space:nowrap}
  .bb-fr-case small + small{color:var(--wm)}
  .bb-fr-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}
  .bb-fr-in{display:flex;flex-direction:column;gap:3px;padding:7px 10px;border-radius:9px;background:var(--bb-sk);box-shadow:inset 0 0 0 1px var(--bb-sk)}
  .bb-fr-in span{font:500 9px var(--fm);letter-spacing:.1em;text-transform:uppercase;color:var(--wm)}
  .bb-fr-in b{font:600 12px var(--fu);color:var(--w);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .bb-fr-send{display:flex;align-items:center;gap:8px;margin-top:auto;font:500 11px var(--fm);color:var(--wd)}
  .bb-fr-send i{flex:1;height:2px;border-radius:2px;background:linear-gradient(90deg,var(--ac),transparent);transform-origin:left;transition:transform .6s cubic-bezier(.65,0,.35,1) .35s}
  .bb-fr-send em{font-style:normal;padding:4px 8px;border-radius:7px;color:var(--w);background:color-mix(in srgb,var(--ac) 18%,transparent);transition:opacity .4s ease .9s}
  html.js .bb-pt:not(.is-in) .bb-fr-send i{transform:scaleX(0)}
  html.js .bb-pt:not(.is-in) .bb-fr-send em{opacity:0}
  /* type that must stay on one line scales down with the card instead of being cut */
  .bb-fr-code{font:500 min(11.5px,4.7cqi)/1.55 var(--fm);color:var(--wd);white-space:pre}
  .bb-s{color:var(--acl)}
  html.light .bb-s{color:var(--ac2)}
  .bb-n2{font:500 11.5px var(--fm);letter-spacing:.16em;color:var(--wm)}
  .bb-t{margin:-8px 0 0;font-family:var(--fu);font-weight:700;font-size:clamp(18px,1.45vw,21px);line-height:1.25;letter-spacing:-.018em;color:var(--w)}
  .bb-d{margin:-8px 0 0;font-size:clamp(14.5px,1.05vw,15.5px);line-height:1.68;color:var(--wd);text-wrap:pretty}

  /* industries: a slow two-row marquee in opposite directions, edges fading into the page */
  .bb-ind{margin-top:clamp(56px,6vw,96px);padding-top:30px;position:relative}
  .bb-ind::before{content:'';position:absolute;left:0;right:0;top:0;height:1px;background:var(--bb-rule)}
  .bb-ind-top{display:flex;justify-content:space-between;align-items:baseline;gap:20px;margin-bottom:clamp(18px,2vw,28px)}
  .bb-ind-k{font:500 11px var(--fm);letter-spacing:.18em;text-transform:uppercase;color:var(--wm)}
  .bb-ind-top .ilink{font-size:15px}
  .bb-mq{width:100vw;margin-left:calc(50% - 50vw);display:grid;gap:clamp(4px,.8vw,12px);
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
  .bb-mq-row{display:flex;width:max-content;animation:bbMq 58s linear infinite}
  .bb-mq-row.is-rev{animation-duration:66s;animation-direction:reverse}
  .bb-mq:hover .bb-mq-row{animation-play-state:paused}
  .bb-mq-track{list-style:none;margin:0;padding:0;display:flex;align-items:center;flex:0 0 auto}
  .bb-mq-i{font-family:var(--fd);font-weight:400;font-size:clamp(38px,4.6vw,72px);line-height:1.12;letter-spacing:-.022em;color:var(--w);white-space:nowrap;padding:0 .08em;transition:opacity .4s ease}
  .bb-mq-i.is-em{font-style:italic;background:linear-gradient(110deg,var(--ac) 0%,var(--acl) 50%,var(--ac2) 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;padding-right:.16em}
  .bb-mq-s{width:clamp(14px,1.4vw,20px);height:clamp(14px,1.4vw,20px);margin:0 clamp(18px,2.2vw,36px);fill:var(--ac);opacity:.7;flex:0 0 auto}
  @media (hover:hover) and (pointer:fine){.bb-mq-row:hover .bb-mq-i{opacity:.35}.bb-mq-row .bb-mq-i:hover{opacity:1}}
  @keyframes bbMq{to{translate:-50% 0}}

  /* ── 5 · platforms: one screen ───────────────────────────── */
  .pf{--pf-panel:#111114;--pf-panel-hi:#17171C;--pf-edge:rgba(255,255,255,.07);--pf-sh:0,0,0;--pf-row:rgba(255,255,255,.05);
    position:relative;min-height:100vh;display:flex;flex-direction:column;justify-content:center;padding:96px clamp(16px,3vw,40px) 48px}
  html.light .pf{--pf-panel:#FFFFFF;--pf-panel-hi:#FFFFFF;--pf-edge:rgba(26,23,20,.08);--pf-sh:70,48,24;--pf-row:rgba(26,23,20,.045)}
  .pf-wrap{width:100%;max-width:1440px;margin:0 auto;padding:0 clamp(4px,2vw,40px)}
  .pf-hdr{display:flex;justify-content:space-between;align-items:flex-end;gap:clamp(24px,5vw,80px)}
  .pf-lead{max-width:28rem;margin-bottom:6px;font-size:clamp(15.5px,1.2vw,18px);line-height:1.7;color:var(--wd);text-wrap:pretty}
  .pf-grid{list-style:none;margin:clamp(28px,3.6vw,48px) 0 0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(12px,1.2vw,18px)}
  .pf-card{--px:50%;--py:0%;position:relative;display:flex;flex-direction:column;gap:16px;height:clamp(330px,44vh,400px);padding:22px 22px 18px;border-radius:22px;overflow:hidden;isolation:isolate;
    background:radial-gradient(120% 70% at 0% 0%,rgba(var(--b),.14),transparent 55%),linear-gradient(180deg,var(--pf-panel-hi),var(--pf-panel));
    box-shadow:inset 0 0 0 1px var(--pf-edge),inset 0 1px 0 rgba(255,255,255,.04),0 2px 6px rgba(var(--pf-sh),.3),0 30px 60px -40px rgba(var(--pf-sh),.8);
    transition:translate .6s cubic-bezier(.16,1,.3,1),box-shadow .6s cubic-bezier(.16,1,.3,1)}
  html.light .pf-card{background:radial-gradient(120% 70% at 0% 0%,rgba(var(--b),.1),transparent 55%),#fff;box-shadow:inset 0 0 0 1px var(--pf-edge),0 1px 2px rgba(var(--pf-sh),.06),0 22px 44px -30px rgba(var(--pf-sh),.3)}
  /* the platform's own mark, huge and quiet, in its own colour */
  .pf-mark{position:absolute;right:-18%;bottom:-16%;width:78%;aspect-ratio:1;z-index:-1;background:linear-gradient(135deg,rgb(var(--b)),rgb(var(--b2,var(--b))));
    -webkit-mask:var(--m) center/contain no-repeat;mask:var(--m) center/contain no-repeat;opacity:.09;rotate:-10deg;
    transition:opacity .7s ease,rotate 1s cubic-bezier(.16,1,.3,1),translate 1s cubic-bezier(.16,1,.3,1)}
  /* spotlight: a ring of the platform's colour on the edge and a soft pool inside, both following the pointer */
  .pf-card::before{content:'';position:absolute;inset:0;border-radius:inherit;padding:1.2px;pointer-events:none;opacity:0;transition:opacity .5s ease;
    background:radial-gradient(240px circle at var(--px) var(--py),rgba(var(--b),.95),transparent 65%);
    -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude}
  .pf-card::after{content:'';position:absolute;inset:0;border-radius:inherit;pointer-events:none;z-index:-1;opacity:0;transition:opacity .5s ease;
    background:radial-gradient(360px circle at var(--px) var(--py),rgba(var(--b),.16),transparent 60%)}
  @media (hover:hover) and (pointer:fine){
    .pf-card:hover{translate:0 -5px;box-shadow:inset 0 0 0 1px var(--pf-edge),0 34px 70px -34px rgba(var(--b),.6),0 8px 22px rgba(var(--pf-sh),.3)}
    .pf-card:hover::before,.pf-card:hover::after{opacity:1}
    .pf-card:hover .pf-mark{opacity:.2;rotate:-4deg;translate:-10px -10px}
  }
  .pf-top{display:flex;align-items:center;gap:14px}
  .pf-logo{display:grid;place-items:center;width:48px;height:48px;border-radius:14px;flex:0 0 auto;background:#F3F0EA;box-shadow:0 1px 0 rgba(255,255,255,.6) inset,0 8px 18px rgba(0,0,0,.4)}
  html.light .pf-logo{background:#fff;box-shadow:0 0 0 1px rgba(26,23,20,.06),0 6px 14px rgba(var(--pf-sh),.12)}
  .pf-logo img{width:27px;height:27px}
  .pf-name{margin:0;font-family:var(--fd);font-weight:400;font-size:clamp(28px,2.4vw,36px);line-height:1;letter-spacing:-.015em;color:var(--w)}
  .pf-d{margin:0;font-size:clamp(14px,1vw,15px);line-height:1.66;color:var(--wd);text-wrap:pretty}
  /* the redirect that comes with you */
  .pf-map{margin-top:auto;display:grid;grid-template-columns:auto auto auto 1fr;align-items:center;gap:7px;padding:10px 12px;border-radius:12px;
    background:var(--pf-row);box-shadow:inset 0 0 0 1px var(--pf-edge);font:500 11.5px var(--fm);white-space:nowrap}
  .pf-old{position:relative;color:var(--wd);overflow:hidden;text-overflow:ellipsis}
  .pf-old::after{content:'';position:absolute;left:0;right:0;top:52%;height:1.5px;background:var(--wd);transform:scaleX(var(--s,1));transform-origin:left;transition:transform .45s cubic-bezier(.65,0,.35,1)}
  .pf-arr{color:var(--wm);translate:var(--ax,0) 0;opacity:var(--ao,1);transition:translate .4s cubic-bezier(.16,1,.3,1) .25s,opacity .3s ease .25s}
  .pf-new{color:var(--w);overflow:hidden;text-overflow:ellipsis;clip-path:inset(0 var(--nc,0%) 0 0);transition:clip-path .5s cubic-bezier(.65,0,.35,1) .4s}
  .pf-301{justify-self:end;font-size:10.5px;font-weight:600;letter-spacing:.06em;color:rgb(var(--b));padding:2px 6px;border:1.5px solid currentColor;border-radius:6px;rotate:-8deg;
    opacity:var(--so,1);scale:var(--ss,1);transition:opacity .2s ease .85s,scale .35s cubic-bezier(.34,1.56,.64,1) .85s}
  html.light .pf-301{color:color-mix(in srgb,rgb(var(--b)) 85%,#000)}
  .pf-map.is-reset{--s:0;--ax:-6px;--ao:0;--nc:100%;--so:0;--ss:1.8}
  .pf-map.is-reset *{transition:none}
  .pf-foot{display:flex;justify-content:space-between;gap:12px 40px;flex-wrap:wrap;margin-top:clamp(22px,2.6vw,34px);font-size:15px;line-height:1.7;color:var(--wd)}
  .pf-foot p{margin:0}

  /* ── smaller screens ────────────────────────────────────── */
  @media (max-width:1279px){.bb-pts{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:1023px),(hover:none){
    .sp-hdr{flex-direction:column;align-items:flex-start;gap:18px}
    .sp-side{align-items:flex-start;text-align:left}
    .sp-row{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:14px;margin:0 calc(-1 * clamp(20px,4vw,40px));padding:6px clamp(20px,4vw,40px) 34px;scrollbar-width:none}
    .sp-row::-webkit-scrollbar{display:none}
    .sp-slot{flex:0 0 min(80vw,340px);scroll-snap-align:start}
    .sp-card{height:470px}
    .sp-num{font-size:120px}
  }
  @media (max-width:1023px){
    .pf{min-height:0;display:block;padding:clamp(72px,9vw,120px) clamp(16px,3vw,40px)}
    .pf-hdr{flex-direction:column;align-items:flex-start;gap:20px}
    .pf-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .pf-card{height:auto;min-height:330px}
  }
  @media (max-width:900px){
    .bb-hdr{flex-direction:column;align-items:flex-start;gap:20px}
    .bb-proof{grid-template-columns:minmax(0,1fr)}
  }
  @media (max-width:600px){
    .bb .ai-win{height:640px}
    .bb .ui-gg .ai-card+.ai-card{display:none}
    .bb-pts{grid-template-columns:minmax(0,1fr)}
    .bb-both{text-align:left}
    .bb .ai-feed{padding:6px 16px 0}
    .bb .ai-tab span{display:none}
    .bb .ai-tab{padding:9px 12px 11px}
    .pf-grid{grid-template-columns:minmax(0,1fr)}
    .pf-card{min-height:0}
    .pf-foot{flex-direction:column}
  }
  @media (prefers-reduced-motion:reduce){
    .sp-card,.sp-ph-main,.sp-ph-g,.sp-num,.sp-d,.sp-glow{transition:none}
    .sp-slot.is-snap .sp-ph-g{animation:none}
    .bb .ui-gpt .ai-think i,.bb .ui-cl .ai-think img,.bb .ui-gg .ai-think i{animation:none}
    .bb .ai-ui,.bb .ai-q,.bb .ai-w,.bb .ai-cite,.bb-hl,.bb-fr-case,.bb-fr-send i,.bb-fr-send em,.bb-fr{transition:none}
    .bb-mq-row{animation:none;width:auto;flex-wrap:wrap}
    .bb-mq-track[aria-hidden]{display:none}
    .bb-mq-track{flex-wrap:wrap}
    .pf-card,.pf-mark,.pf-card::before,.pf-card::after,.pf-old::after,.pf-arr,.pf-new,.pf-301{transition:none}
  }
</style>

<script>
  // Sections 3 to 5. Everything reads without JS; motion is layered on top.
  const reduceMo = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const near = (el: Element | null, fn: () => void) => {
    if (!el) return;
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); fn(); } }, { rootMargin: '600px 0px' });
    io.observe(el);
  };
  near(document.getElementById('sprint'), () => setupSprint(document.getElementById('sprint')!));
  near(document.getElementById('b2b'), () => setupB2B(document.getElementById('b2b')!));
  near(document.getElementById('platforms'), () => setupPlatforms(document.getElementById('platforms')!));

  /* ── 3 · sprint ─────────────────────────────────────────── */
  async function setupSprint(sec: HTMLElement) {
    const slots = [...sec.querySelectorAll<HTMLElement>('.sp-slot')];
    const day = sec.querySelector('.sp-day-n')!;
    const wide = matchMedia('(min-width: 1024px) and (hover: hover)');

    // phones and touch: the card that snaps into view plays its motion clones once
    if (!reduceMo) {
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (wide.matches || !e.isIntersecting) return;
        const s = e.target as HTMLElement; s.classList.remove('is-snap'); void s.offsetWidth; s.classList.add('is-snap');
      }), { root: sec.querySelector('.sp-row'), threshold: .8 });
      slots.forEach((s) => io.observe(s));
    }
    if (reduceMo) return;

    // desktop: the section pins, the day count runs, cards 3 and 4 rise into the row trailing their clones,
    // and the clones close in as each card lands (same CSS-sticky + scrub pattern as the hero)
    let gsap: any, ST: any;
    try {
      gsap = (await import('gsap')).default;
      ST = (await import('gsap/ScrollTrigger')).ScrollTrigger;
      gsap.registerPlugin(ST);
    } catch { return; }
    let run: any = null;
    const build = () => {
      if (run) { run.st.kill(); run.tl.kill(); gsap.set(slots, { clearProps: 'transform,--land,--lx' }); run = null; }
      const pin = wide.matches;
      sec.classList.toggle('is-pinned', pin);
      if (!pin) { ST.refresh(); return; }
      const tl = gsap.timeline({ paused: true, defaults: { ease: 'power2.out' } });
      [[2, .32, .04, .42], [3, .72, .3, .5]].forEach(([i, from, at, dur]) => {
        const s = slots[i];
        gsap.set(s, { y: () => innerHeight * from, '--land': .5, '--lx': 40 });
        tl.to(s, { y: 0, duration: dur }, at)
          .to(s, { '--land': 0, '--lx': 0, duration: dur * .9, ease: 'power3.out' }, at + dur * .2);
      });
      tl.to({}, { duration: .2 });
      const st = ST.create({ trigger: sec, start: 'top top', end: 'bottom bottom', scrub: .6, animation: tl, invalidateOnRefresh: true,
        onUpdate: (self: any) => { day.textContent = String(Math.max(1, Math.min(10, Math.round(1 + self.progress * 11)))).padStart(2, '0'); } });
      run = { tl, st };
      ST.refresh();
    };
    build();
    wide.addEventListener('change', build);
  }

  /* ── 4 · B2B ────────────────────────────────────────────── */
  function setupB2B(sec: HTMLElement) {
    const ai = sec.querySelector<HTMLElement>('.ai')!;
    const tabs = [...ai.querySelectorAll<HTMLButtonElement>('.ai-tab')];
    const uis = [...ai.querySelectorAll<HTMLElement>('.ai-ui')];
    const win = ai.querySelector('.ai-win')!;

    // the answer streams in word by word, the way the real products write
    uis.forEach((ui) => {
      const walk = (n: Node) => [...n.childNodes].forEach((c) => {
        if (c.nodeType === 3) {
          const f = document.createDocumentFragment();
          (c.textContent || '').split(/(\s+)/).forEach((t) => {
            if (!t) return;
            if (/^\s+$/.test(t)) f.append(t);
            else { const s = document.createElement('span'); s.className = 'ai-w'; s.textContent = t; f.append(s); }
          });
          c.replaceWith(f);
        } else if (c.nodeType === 1 && !(c as Element).classList.contains('ai-cite')) walk(c);
      });
      walk(ui.querySelector('.ai-a')!);
    });

    let cur = 0, timers: number[] = [], auto = true, visible = false;
    const later = (ms: number, fn: () => void) => { timers.push(window.setTimeout(fn, ms)); };
    const clear = () => { timers.forEach(clearTimeout); timers = []; };
    const show = (ui: HTMLElement) => ui.querySelectorAll('.ai-q,.ai-w,.ai-cite,.ai-acts,.ai-mark,.ai-src').forEach((n) => n.classList.add('is-in'));
    function play(i: number) {
      clear();
      cur = i;
      tabs.forEach((t, k) => t.setAttribute('aria-pressed', k === i ? 'true' : 'false'));
      uis.forEach((u, k) => u.classList.toggle('is-on', k === i));
      const ui = uis[i], feed = ui.querySelector<HTMLElement>('.ai-feed')!, think = ui.querySelector('.ai-think')!;
      const words = [...ui.querySelectorAll('.ai-w')];
      ui.querySelectorAll('.is-in').forEach((n) => n.classList.remove('is-in'));
      if (reduceMo) { show(ui); feed.scrollTop = feed.scrollHeight; return; }
      feed.scrollTop = 0;
      later(250, () => ui.querySelector('.ai-q')!.classList.add('is-in'));
      later(800, () => think.classList.add('is-on'));
      later(2000, () => {
        think.classList.remove('is-on');
        words.forEach((w, k) => later(k * 34, () => {
          w.classList.add('is-in');
          if (feed.scrollHeight > feed.clientHeight) feed.scrollTo({ top: feed.scrollHeight, behavior: 'smooth' });
        }));
        const end = words.length * 34;
        later(end + 120, () => ui.querySelectorAll('.ai-cite').forEach((c) => c.classList.add('is-in')));
        later(end + 420, () => { ui.querySelectorAll('.ai-acts,.ai-mark,.ai-src').forEach((c) => c.classList.add('is-in')); feed.scrollTo({ top: feed.scrollHeight, behavior: 'smooth' }); });
        // the same question, asked in the next engine
        later(end + 6200, () => { if (auto && visible) play((i + 1) % uis.length); });
      });
    }
    ai.classList.add('is-live');
    uis.forEach((u, k) => { if (k !== 0) u.classList.remove('is-on'); });
    show(uis[0]);
    tabs.forEach((t, i) => t.addEventListener('click', () => { auto = false; play(i); }));
    new IntersectionObserver((es) => es.forEach((e) => {
      const was = visible; visible = e.isIntersecting;
      if (visible && !was) play(cur); else if (!visible) clear();
    }), { threshold: .45 }).observe(win);

    // the two numbers count up the first time they are seen
    if (!reduceMo) sec.querySelectorAll<HTMLElement>('[data-to]').forEach((n) => {
      const to = Number(n.dataset.to);
      const io = new IntersectionObserver((es) => {
        if (!es.some((e) => e.isIntersecting)) return; io.disconnect();
        const t0 = performance.now(), dur = 1300;
        const tick = (t: number) => { const p = Math.min(1, (t - t0) / dur); n.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 3)))); if (p < 1) requestAnimationFrame(tick); };
        n.textContent = '0';
        requestAnimationFrame(tick);
      }, { threshold: .6 });
      io.observe(n);
    });

    // each fragment marks its answer lines when it scrolls in
    const pts = [...sec.querySelectorAll<HTMLElement>('.bb-pt')];
    if (reduceMo) pts.forEach((p) => p.classList.add('is-in'));
    else {
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        setTimeout(() => el.classList.add('is-in'), pts.indexOf(el) * 140);
        io.unobserve(el);
      }), { threshold: .45 });
      pts.forEach((p) => io.observe(p));
    }
  }

  /* ── 5 · platforms ──────────────────────────────────────── */
  function setupPlatforms(sec: HTMLElement) {
    if (reduceMo) return;
    const cards = [...sec.querySelectorAll<HTMLElement>('.pf-card')];
    const maps = cards.map((c) => c.querySelector<HTMLElement>('.pf-map')!);
    const replay = (m: HTMLElement, delay: number) => { m.classList.add('is-reset'); void m.offsetWidth; setTimeout(() => m.classList.remove('is-reset'), delay); };

    // on arrival the redirect plays panel by panel, left to right: the same URL map landing on each platform
    maps.forEach((m) => m.classList.add('is-reset'));
    const io = new IntersectionObserver((es) => {
      if (!es.some((e) => e.isIntersecting)) return; io.disconnect();
      maps.forEach((m, i) => setTimeout(() => m.classList.remove('is-reset'), 250 + i * 380));
    }, { threshold: .5 });
    io.observe(sec.querySelector('.pf-grid')!);

    // hover: a ring of the platform's colour follows the pointer, and that panel's redirect plays again
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) cards.forEach((c, i) => {
      c.addEventListener('pointermove', (e) => {
        const r = c.getBoundingClientRect();
        c.style.setProperty('--px', (e.clientX - r.left) + 'px'); c.style.setProperty('--py', (e.clientY - r.top) + 'px');
      });
      c.addEventListener('pointerenter', () => replay(maps[i], 30));
    });
  }
</script>

<!-- Section 6 (FAQ): the script toggles open/hover state, so these styles are global. Every rule is held under .fq. -->
<style is:global>
  .fq{--fq-line:rgba(255,255,255,.1);position:relative;padding:clamp(88px,9vw,150px) clamp(16px,3vw,40px) clamp(56px,6vw,96px)}
  html.light .fq{--fq-line:rgba(26,23,20,.12)}
  .fq-wrap{max-width:1440px;margin:0 auto;padding:0 clamp(4px,2vw,40px);display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(40px,6vw,120px);align-items:start}
  .fq-side{position:sticky;top:112px}
  .fq .sec-h{margin:0}
  .fq-count{display:flex;align-items:flex-end;gap:0;margin-top:clamp(40px,4.6vw,72px)}
  .fq-count-box{display:block;overflow:hidden;padding:.06em 0 .1em;margin-bottom:-.1em}
  /* the roll animates .fq-count-roll: a filter on the gradient-clipped numeral itself makes Chrome drop the text */
  .fq-count-roll{display:block}
  /* gradient text only paints inside its own box and italic digits lean past it: the padding gives the lean room */
  .fq-count-n{display:block;padding:0 .26em 0 .06em;margin-left:-.06em;font-family:var(--fd);font-style:italic;font-weight:400;font-size:clamp(84px,8.4vw,140px);line-height:.86;letter-spacing:-.04em;
    background:linear-gradient(110deg,var(--ac) 0%,var(--acl) 45%,var(--ac2) 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
    font-variant-numeric:tabular-nums}
  .fq-count-of{font:500 12px var(--fm);letter-spacing:.14em;color:var(--wm);padding-bottom:.9em}
  .fq-ask{margin:clamp(28px,3vw,40px) 0 0;max-width:23rem;font-family:var(--fu);font-size:clamp(15px,1.1vw,16.5px);line-height:1.7;color:var(--wd);text-wrap:pretty}

  .fq-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--fq-line)}
  .fq-item{position:relative;border-bottom:1px solid var(--fq-line)}
  /* the rule under a question draws in brand colour when you point at it or open it */
  .fq-item::after{content:'';position:absolute;left:0;right:0;bottom:-1px;height:1px;pointer-events:none;
    background:linear-gradient(90deg,var(--ac),var(--acl) 55%,transparent);transform:scaleX(0);transform-origin:left;transition:transform .9s cubic-bezier(.16,1,.3,1)}
  .fq-item.is-open::after{transform:scaleX(1)}
  .fq-h3{margin:0;font:inherit;letter-spacing:normal}
  .fq-q{all:unset;box-sizing:border-box;cursor:pointer;width:100%;display:grid;grid-template-columns:clamp(44px,4.4vw,64px) minmax(0,1fr) 22px;column-gap:16px;align-items:baseline;
    padding:clamp(22px,2.1vw,30px) 0;-webkit-tap-highlight-color:transparent}
  .fq-q:focus-visible{outline:2px solid var(--ac);outline-offset:4px;border-radius:6px}
  .fq-n{font:500 11.5px var(--fm);letter-spacing:.12em;color:var(--wm);transition:color .45s ease}
  .fq-t{font-family:var(--fd);font-weight:400;font-size:clamp(23px,2.1vw,31px);line-height:1.14;letter-spacing:-.016em;color:var(--w);text-wrap:balance;
    transition:opacity .45s ease,translate .7s cubic-bezier(.16,1,.3,1)}
  .fq-x{position:relative;width:16px;height:16px;align-self:center;justify-self:end}
  .fq-x::before,.fq-x::after{content:'';position:absolute;left:0;top:50%;width:100%;height:1.5px;margin-top:-.75px;border-radius:2px;background:var(--wd);
    transition:rotate .7s cubic-bezier(.16,1,.3,1),background .35s ease}
  .fq-x::after{rotate:90deg}
  .fq-item.is-open .fq-n{color:var(--ac)}
  .fq-item.is-open .fq-x::before,.fq-item.is-open .fq-x::after{background:var(--ac)}
  .fq-item.is-open .fq-x::after{rotate:0deg}
  .fq-item.is-open .fq-x::before{rotate:180deg}
  /* answers: the row opens on a grid track, the text resolves out of a blur */
  .fq-a{display:grid;grid-template-rows:0fr;visibility:hidden;transition:grid-template-rows .75s cubic-bezier(.16,1,.3,1),visibility 0s linear .75s}
  .fq-item.is-open .fq-a{grid-template-rows:1fr;visibility:visible;transition:grid-template-rows .75s cubic-bezier(.16,1,.3,1)}
  .fq-a-in{min-height:0;overflow:hidden}
  .fq-a p{margin:0;padding:0 clamp(16px,3vw,44px) clamp(26px,2.4vw,34px) calc(clamp(44px,4.4vw,64px) + 16px);max-width:calc(62ch + 120px);
    font-family:var(--fu);font-size:clamp(15.5px,1.12vw,17.5px);line-height:1.75;color:var(--wd);text-wrap:pretty;
    opacity:0;filter:blur(7px);translate:0 12px;transition:opacity .45s ease,filter .5s ease,translate .7s cubic-bezier(.16,1,.3,1)}
  .fq-item.is-open .fq-a p{opacity:1;filter:blur(0);translate:0 0;transition-delay:.14s,.14s,.1s}
  @media (hover:hover) and (pointer:fine){
    .fq-item:hover::after{transform:scaleX(1)}
    .fq-list:hover .fq-item:not(:hover) .fq-t{opacity:.34}
    .fq-item:hover .fq-t{translate:6px 0}
    .fq-item:hover .fq-n{color:var(--ac)}
    .fq-item:hover .fq-x::before,.fq-item:hover .fq-x::after{background:var(--w)}
  }
  /* entrance: the rows settle in one after another */
  html.js .fq-item{opacity:0;translate:0 16px;transition:opacity .8s ease calc(var(--i) * 70ms),translate 1s cubic-bezier(.16,1,.3,1) calc(var(--i) * 70ms)}
  html.js .fq.is-in .fq-item{opacity:1;translate:0 0}
  /* without JS every answer is simply open */
  html:not(.js) .fq-a{grid-template-rows:1fr;visibility:visible}
  html:not(.js) .fq-a p{opacity:1;filter:none;translate:none}

  @media (max-width:1100px){
    .fq-wrap{grid-template-columns:minmax(0,1fr);gap:clamp(28px,5vw,48px)}
    .fq-side{position:static}
    .fq-count{display:none}
    .fq-ask{margin-top:18px}
  }
  @media (max-width:600px){
    .fq-q{grid-template-columns:34px minmax(0,1fr) 16px;column-gap:10px}
    .fq-a p{padding:0 0 24px 44px}
  }
  @media (prefers-reduced-motion:reduce){
    .fq-item,.fq-t,.fq-a,.fq-a p,.fq-x::before,.fq-x::after{transition:none!important}
    html.js .fq-item{opacity:1;translate:none}
  }
</style>

<script>
  /* ── 6 · FAQ ───────────────────────────────────────────── */
  {
    const fq = document.getElementById('rd-faq');
    if (fq) {
      const items = [...fq.querySelectorAll<HTMLElement>('.fq-item')];
      const btns = items.map((it) => it.querySelector<HTMLButtonElement>('.fq-q')!);
      const num = fq.querySelector<HTMLElement>('.fq-count-n')!;
      const roller = fq.querySelector<HTMLElement>('.fq-count-roll')!;
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let shown = 1, pinned = 1, hoverT = 0;
      let anims: Animation[] = [];

      // the numeral rolls: out through a blur, the new one rises in
      const roll = (n: number) => {
        if (n === shown) return;
        const dir = n > shown ? 1 : -1;
        shown = n;
        anims.forEach((a) => a.cancel());
        const txt = String(n).padStart(2, '0');
        if (still) { num.textContent = txt; return; }
        const out = roller.animate(
          [{ transform: 'translateY(0)', opacity: 1, filter: 'blur(0)' }, { transform: `translateY(${-45 * dir}%)`, opacity: 0, filter: 'blur(10px)' }],
          { duration: 220, easing: 'cubic-bezier(.5,0,.75,0)', fill: 'forwards' });
        anims = [out];
        out.onfinish = () => {
          num.textContent = txt;
          out.cancel();
          anims = [roller.animate(
            [{ transform: `translateY(${55 * dir}%)`, opacity: 0, filter: 'blur(10px)' }, { transform: 'translateY(0)', opacity: 1, filter: 'blur(0)' }],
            { duration: 560, easing: 'cubic-bezier(.16,1,.3,1)' })];
        };
      };

      // several answers can stay open, so the page never jumps under the reader
      const toggle = (i: number) => {
        const open = !items[i].classList.contains('is-open');
        items[i].classList.toggle('is-open', open);
        btns[i].setAttribute('aria-expanded', String(open));
        if (open) { pinned = i + 1; roll(pinned); }
      };
      btns.forEach((b, i) => {
        b.addEventListener('click', () => toggle(i));
        b.addEventListener('keydown', (e) => {
          const k = ({ ArrowDown: i + 1, ArrowUp: i - 1, Home: 0, End: btns.length - 1 } as Record<string, number>)[e.key];
          if (k === undefined) return;
          e.preventDefault();
          btns[(k + btns.length) % btns.length].focus();
        });
      });

      // pointing at a question previews its number; leaving the list returns to the last one opened
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        items.forEach((it, i) => it.addEventListener('pointerenter', () => { clearTimeout(hoverT); hoverT = window.setTimeout(() => roll(i + 1), 70); }));
        fq.querySelector('.fq-list')!.addEventListener('pointerleave', () => { clearTimeout(hoverT); hoverT = window.setTimeout(() => roll(pinned), 140); });
      }

      const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { fq.classList.add('is-in'); io.disconnect(); } }, { threshold: 0.15 });
      io.observe(fq.querySelector('.fq-list')!);
    }
  }
</script>
