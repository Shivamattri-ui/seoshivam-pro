    --bb-rule:linear-gradient(90deg,transparent,rgba(26,23,20,.13) 10%,rgba(26,23,20,.13) 90%,transparent)}
  .bb-wrap{max-width:1440px;margin:0 auto;padding:0 clamp(4px,2vw,40px)}
