  .sp-glow{position:absolute;left:12%;right:12%;bottom:-30px;height:80px;border-radius:50%;background:rgb(var(--sp-glow));filter:blur(40px);opacity:0;z-index:-1;pointer-events:none;transition:opacity .8s ease}
  @media (hover:hover) and (pointer:fine){
