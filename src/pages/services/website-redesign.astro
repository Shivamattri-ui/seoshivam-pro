    text-shadow:0 4px 18px rgba(0,0,0,.25),0 14px 44px rgba(0,0,0,.3);transition:translate .9s cubic-bezier(.16,1,.3,1);font-variant-numeric:lining-nums}
  .sp-body{position:absolute;left:22px;right:22px;bottom:22px}
  .sp-t{font-family:var(--fu);font-weight:700;font-size:clamp(21px,1.7vw,25px);line-height:1.15;letter-spacing:-.02em;color:#fff}
