    // one stage: the desktop sticky stage holds all six scenes, each phone stage holds one
    function makeStage(box: HTMLElement, dims: any, indexes: number[]) {
      const fit = el('lk-fit', '', box) as HTMLElement;
      fit.style.width = dims.W + 'px'; fit.style.height = dims.H + 'px';
      fit.style.margin = (-dims.H / 2) + 'px 0 0 ' + (-dims.W / 2) + 'px';
      const players: Record<number, any> = {};
      indexes.forEach((i) => {
        const root = el('lk-scene', '', fit);
        const tl = SCENES[i](root, dims === MOB, dims);
        tl.to(root.children, { opacity: 0, duration: .4, ease: 'power1.in' }, 'end+=2.4');   // hold the stamped frame, clear the desk, go again
        let dc: any = null;
        const p: any = {
          root,
          play() { p.stop(); root.classList.add('is-on'); if (reduceMotion) { tl.seek('end', false); return; } tl.restart(false, false); },
          stop() { tl.pause(); if (dc) { dc.kill(); dc = null; } },
          hide() { p.stop(); root.classList.remove('is-on'); },
        };
        tl.eventCallback('onComplete', () => { dc = gsap.delayedCall(.35, p.play); });
        tl.seek('end', false).pause();
        players[i] = p;
      });
      const resize = () => {
        const desk = dims === DESK, w = box.clientWidth, h = box.clientHeight - (desk ? 56 : 0);
        if (!w || !h) return;
        const s = Math.min(1.36, w / dims.W, h / dims.H);
        fit.style.transform = 'translateY(' + (desk ? 18 : 0) + 'px) scale(' + s.toFixed(3) + ')';
      };
      return { players, resize };
    }

    const items = [...sec.querySelectorAll<HTMLElement>('.lk-item')];
    const stageEl = sec.querySelector<HTMLElement>('.lk-stage')!;
    const desk = makeStage(sec.querySelector<HTMLElement>('.lk-stage .lk-box')!, DESK, SCENES.map((_, i) => i));
    const inline = items.map((it, i) => {
      const holder = it.querySelector<HTMLElement>('.lk-inline')!;
      const st = makeStage(el('lk-box', '', holder) as HTMLElement, MOB, [i]);
      st.players[i].root.classList.add('is-on');   // the stamped frame shows until the scene plays
      return { i, holder, ...st };
    });
    const ticks = [...sec.querySelectorAll('.lk-ticks i')];
    const num = sec.querySelector('.lk-num')!;

    // desktop: the leak crossing the middle of the screen drives the stage
    let active = 0, stageVisible = false;
    function activate(i: number) {
      if (narrow.matches) return;
      if (i !== active) {
        items[active].classList.remove('is-on'); ticks[active].classList.remove('is-on'); desk.players[active].hide();
        active = i;
        items[i].classList.add('is-on'); ticks[i].classList.add('is-on');
        num.textContent = String(i + 1).padStart(2, '0');
      }
      if (stageVisible) desk.players[i].play(); else desk.players[i].root.classList.add('is-on');
    }
    const centerIO = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) activate(Number((e.target as HTMLElement).dataset.i)); }), { rootMargin: '-50% 0px -49% 0px' });
    items.forEach((it) => centerIO.observe(it));
    new IntersectionObserver((es) => es.forEach((e) => {
      stageVisible = e.isIntersecting;
      if (narrow.matches) return;
      if (stageVisible) desk.players[active].play(); else desk.players[active].stop();
    }), { threshold: .25 }).observe(stageEl);
    desk.players[0].root.classList.add('is-on');
    items.forEach((it) => it.addEventListener('click', (e) => {
      if (narrow.matches || (e.target as Element).closest('a')) return;
      const r = it.getBoundingClientRect(), y = scrollY + r.top + r.height / 2 - innerHeight / 2;
      const lenis = (window as any).__lenis;
      if (lenis && !reduceMotion) lenis.scrollTo(y); else scrollTo({ top: y, behavior: reduceMotion ? 'auto' : 'smooth' });
    }));

    // phones: each leak plays its own scene while it is on screen
    const inlineIO = new IntersectionObserver((es) => es.forEach((e) => {
      if (!narrow.matches) return;
      const s = inline.find((x) => x.holder === e.target)!, p = s.players[s.i];
      if (e.isIntersecting) p.play(); else p.stop();
    }), { threshold: .4 });
    inline.forEach((s) => inlineIO.observe(s.holder));

    function layout() {
      desk.resize(); inline.forEach((s) => s.resize());
      if (narrow.matches) Object.values(desk.players).forEach((p: any) => p.stop());
      else { inline.forEach((s) => s.players[s.i].stop()); if (stageVisible) desk.players[active].play(); }
    }
    layout();
    addEventListener('resize', () => { desk.resize(); inline.forEach((s) => s.resize()); }, { passive: true });
    narrow.addEventListener('change', layout);

    // section close: the Day 10 stamp lands when the line comes into view
    const foot = sec.querySelector('.lk-foot')!;
    const footIO = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { foot.classList.add('is-in'); footIO.disconnect(); } }, { threshold: .6 });
    footIO.observe(foot);
  }

  /* ── 2 · includes ───────────────────────────────────────── */
  function setupIncludes(sec: HTMLElement) {
    const groups = [...sec.querySelectorAll<HTMLElement>('.inc-grp')];
    // group objects settle in with CSS once their group arrives
    const inIO = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); inIO.unobserve(e.target); } }), { threshold: .2 });
    groups.forEach((g) => inIO.observe(g));
    if (reduceMotion) return;   // glyphs stay in their finished drawing

    loadGsapOnce().then((gsap) => {
      const q = (n: Element, s: string) => n.querySelector(s);
      const qa = (n: Element, s: string) => [...n.querySelectorAll(s)];
      const DRAW = { strokeDasharray: 1, strokeDashoffset: 1 };
      const draw = (tl: any, n: any, pos: number, d = .5) => tl.to(n, { strokeDashoffset: 0, duration: d, ease: 'power2.inOut' }, pos);
      const pop = (tl: any, n: any, pos: number) => tl.fromTo(n, { opacity: 0, scale: .4, transformOrigin: '50% 50%' }, { opacity: 1, scale: 1, duration: .35, ease: 'back.out(2.4)' }, pos);

      // each glyph draws its item's line in under two seconds, holds, then goes again
      const GLYPHS: Record<string, (s: Element, tl: any) => number> = {
        redirect(s, tl) {
          gsap.set(qa(s, '.strike,.arc,.head,.nw'), DRAW);
          draw(tl, q(s, '.strike'), .2, .35); draw(tl, q(s, '.arc'), .55, .55);
          pop(tl, q(s, '.t'), .75);
          draw(tl, q(s, '.head'), 1.05, .2); draw(tl, q(s, '.nw'), 1.2, .55);
          return 1.9;
        },
        meta(s, tl) {
          qa(s, '.l').forEach((l, i) => tl.fromTo(l, { x: 0 }, { x: 24, duration: .6, ease: 'power3.inOut' }, .2 + i * .28));
          return 1.6;
        },
        sitemap(s, tl) {
          gsap.set(qa(s, '.e,.e2'), DRAW);
          pop(tl, q(s, '.n0'), .1); draw(tl, q(s, '.e'), .35, .55);
          qa(s, '.n1,.n2,.n3').forEach((n, i) => pop(tl, n, .7 + i * .12));
          draw(tl, q(s, '.e2'), 1.45, .25); pop(tl, q(s, '.n4'), 1.65);   // a page is published: the sitemap grows on its own
          return 2.1;
        },
        index(s, tl) {
          gsap.set(qa(s, '.p,.k'), DRAW);
          draw(tl, q(s, '.p1'), .25, .5); draw(tl, q(s, '.p2'), .4, .5);
          qa(s, '.eg').forEach((e, i) => pop(tl, e, .7 + i * .15));
          draw(tl, q(s, '.k1'), .85, .25); draw(tl, q(s, '.k2'), 1.0, .25);
          return 1.5;
        },
        answer(s, tl) {
          gsap.set(qa(s, '.a'), DRAW);
          tl.fromTo(q(s, '.q'), { opacity: 0, y: 4 }, { opacity: 1, y: 0, duration: .35, ease: 'power2.out' }, .1);
          qa(s, '.a').forEach((a, i) => draw(tl, a, .45 + i * .2, .45));
          tl.fromTo(q(s, '.sp'), { opacity: 0, scale: .3, rotation: -40, transformOrigin: '50% 50%' }, { opacity: 1, scale: 1, rotation: 0, duration: .5, ease: 'back.out(2)' }, 1.25);
          return 1.9;
        },
        nav(s, tl) {
          gsap.set(q(s, '.pg'), DRAW);
          const c = q(s, '.cur');
          tl.fromTo(c, { x: 38, y: 34, opacity: 0 }, { x: 24, y: 12, opacity: 1, duration: .6, ease: 'power3.out' }, .1)
            .to(c, { scale: .8, transformOrigin: '0 0', duration: .08, yoyo: true, repeat: 1 }, .75)
            .fromTo(q(s, '.i2'), { strokeWidth: 2.1 }, { strokeWidth: 3.6, duration: .15 }, .8);
          draw(tl, q(s, '.pg'), .9, .5);
          return 1.6;
        },
        semantic(s, tl) {
          gsap.set(qa(s, '.b'), DRAW);
          qa(s, '.b').forEach((b, i) => draw(tl, b, .15 + i * .22, .45));
          tl.fromTo(q(s, '.tl'), { opacity: 0 }, { opacity: 1, duration: .3 }, 1.2);
          return 1.7;
        },
        fast(s, tl) {
          gsap.set(q(s, '.bolt'), DRAW);
          draw(tl, q(s, '.bolt'), .2, .28);
          tl.fromTo(q(s, '.pl'), { opacity: 0 }, { opacity: 1, duration: .05 }, .5);
          return 1.3;
        },
        lead(s, tl) {
          const tok = q(s, '.tok'), cn = q(s, '.cn');
          tl.fromTo(tok, { opacity: 0, x: 0, y: 0 }, { opacity: 1, duration: .15 }, .3)
            .to(tok, { x: 28, y: -13, duration: .55, ease: 'power2.inOut' }, .45)
            .to(tok, { opacity: 0, duration: .1 }, .95)
            .fromTo(cn, { opacity: 0, y: -8 }, { opacity: 1, y: 0, duration: .35, ease: 'back.out(2)' }, .95)
            .fromTo(q(s, '.c2'), { y: 0 }, { y: 12, duration: .35, ease: 'power2.out' }, .95)
            .fromTo(q(s, '.c1'), { opacity: 1 }, { opacity: .35, duration: .35 }, .95);
          return 1.6;
        },
        analytics(s, tl) {
          gsap.set(q(s, '.up'), DRAW);
          draw(tl, q(s, '.up'), .15, .8); pop(tl, q(s, '.dot'), .9);
          tl.fromTo(q(s, '.ring'), { opacity: .9, scale: 1, transformOrigin: '50% 50%' }, { opacity: 0, scale: 2.6, duration: .7, ease: 'power2.out' }, 1.05);
          return 1.9;
        },
      };

      groups.forEach((g) => {
        const tls = qa(g, 'svg[data-g]').map((svg) => {
          const tl = gsap.timeline({ paused: true, repeat: -1, repeatDelay: 1.6 });
          const len = GLYPHS[(svg as SVGElement).dataset.g!](svg, tl);
          tl.to({}, { duration: Math.max(.1, 3.1 - len) });   // hold the finished drawing
          tl.seek(len);                                       // show the finished drawing until the group plays
          return tl;
        });
        // glyphs only run while their group is on screen, staggered the first time so they do not fire in unison
        let seen = false, live = false;
        new IntersectionObserver((es) => es.forEach((e) => {
          live = e.isIntersecting;
          if (!live) { tls.forEach((tl) => tl.pause()); return; }
          if (seen) { tls.forEach((tl) => tl.play()); return; }
          seen = true;
          tls.forEach((tl, i) => gsap.delayedCall(.3 + i * .18, () => { if (live) tl.restart(); }));
        }), { threshold: .2 }).observe(g);
      });
    }).catch(() => {});
  }
</script>

<!-- Sections 3 to 5: global for the same reason as above (JS adds classes and builds nodes). Every rule is held inside .sp, .bb or .pf. -->
<style is:global>
  /* ── 3 · the sprint ─────────────────────────────────────── */
  .sp{--sp-ph:url(/images/shivam-attri-website-redesign-sprint-blue.webp);--sp-phm:url(/images/shivam-attri-website-redesign-sprint-blue-motion.webp);--sp-deep:#01040E;--sp-glow:58,120,238;position:relative}
  html.light .sp{--sp-ph:url(/images/shivam-attri-website-redesign-sprint-terra.webp);--sp-phm:url(/images/shivam-attri-website-redesign-sprint-terra-motion.webp);--sp-deep:#130401;--sp-glow:216,95,45}
  .sp.is-pinned{height:250vh}
  .sp-pin{padding:clamp(72px,9vw,120px) clamp(16px,3vw,40px)}
  .sp.is-pinned .sp-pin{position:sticky;top:0;height:100vh;min-height:720px;display:flex;flex-direction:column;justify-content:center;padding-top:96px;padding-bottom:40px;overflow:hidden}
  .sp-wrap{width:100%;max-width:1440px;margin:0 auto;padding:0 clamp(4px,2vw,40px)}
  .sp-hdr{display:flex;justify-content:space-between;align-items:flex-end;gap:clamp(24px,5vw,80px);margin-bottom:clamp(28px,3.4vw,48px)}
  .sp-side{display:flex;flex-direction:column;align-items:flex-end;gap:16px;max-width:27rem;margin-bottom:6px;text-align:right}
  .sp-note{font-size:clamp(14.5px,1.1vw,16px);line-height:1.7;color:var(--wd);text-wrap:pretty}
  .sp-day{font:500 11px var(--fm);letter-spacing:.18em;text-transform:uppercase;color:var(--wm);font-variant-numeric:tabular-nums}
  .sp-day b{font-weight:500;color:var(--ac)}
  .sp:not(.is-pinned) .sp-day{display:none}
  .sp-row{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(14px,1.4vw,22px)}
  .sp-slot{position:relative;will-change:transform}
  .sp-card{position:relative;height:clamp(440px,58vh,560px);border-radius:22px;overflow:hidden;isolation:isolate;color:#fff;background:var(--sp-deep);
    translate:0 0;transition:translate .7s cubic-bezier(.16,1,.3,1),box-shadow .7s cubic-bezier(.16,1,.3,1);
