---
import Layout from '../../layouts/Layout.astro';
import { SITE_ROUTE_META } from '../../lib/site-route-meta';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ContactBrief from '../../components/ContactBrief.astro';

const meta = SITE_ROUTE_META['/services/website-redesign'];
const url = 'https://seoshivam.pro/services/website-redesign';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Website Redesign Services',
      serviceType: 'Website redesign',
      description: meta.description,
      provider: { '@type': 'Person', '@id': 'https://seoshivam.pro/#shivam' },
      url,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://seoshivam.pro' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://seoshivam.pro/services' },
        { '@type': 'ListItem', position: 3, name: 'Website Redesign', item: url },
      ],
    },
  ],
};

// Hero scene: each old page lifts off the pile, is rebuilt, and lands in the new sitemap.
// to / mto = final x, y, z on desktop / phones. pile / mpile = x, y, rotation in the starting pile.
// m = also shown on phones (three-card cascade). rot = stamp angle. sr / st = stamp offsets.
const scenePages = [
  { tier: 'home', m: true, rot: -11, to: [0, -206, 34], mto: [0, -152, 30], pile: [-6, 40, -7], mpile: [-4, 44, -6],
    oldT: 'Welcome to Our Website', oldP: 'We are a leading provider of <u>quality services</u> since 1998.', oldU: '/index.php',
    newT: 'Home', newP: 'Freight quotes in under a minute.', newU: '/' },
  { tier: 'mid', m: true, rot: -15, st: 16, to: [-232, -14, 0], mto: [-44, 10, 0], pile: [26, 18, 6], mpile: [18, 26, 5],
    oldT: 'Our Services', oldP: 'We offer a <u>wide range</u> of services for all your needs.', oldU: '/services.html',
    newT: 'Services', newP: 'Ocean, air and road.', newU: '/services' },
  { tier: 'mid', rot: -7, sr: 16, to: [0, -14, 0], pile: [-30, 6, -3],
    oldT: 'Portfolio', oldP: 'Click on a project to <u>view more</u>.', oldU: '/portfolio/item-7',
    newT: 'Logistics platform', newP: 'Case file, 2026.', newU: '/work/logistics-platform' },
  { tier: 'mid', rot: -17, st: 24, to: [232, -14, 0], pile: [18, -12, 8],
    oldT: 'Latest News', oldP: 'Posted on 03/14/2019 by <u>admin</u>', oldU: '/blog/?p=214',
    newT: 'Redesign checklist', newP: '12 min read.', newU: '/blog/redesign-checklist' },
  { tier: 'leaf', rot: -9, to: [-108, 152, -34], pile: [-8, -28, -10],
    oldT: 'About Us', oldP: 'Founded in 1998, we are <u>dedicated</u> to excellence.', oldU: '/about-us.php',
    newT: 'About', newP: 'The team and the method.', newU: '/about' },
  { tier: 'leaf', m: true, rot: -13, sr: 14, to: [108, 152, -34], mto: [44, 166, -20], pile: [30, -42, 3], mpile: [-16, 8, -4],
    oldT: 'Contact Us', oldP: 'Call us today or fill in the <u>form below</u>.', oldU: '/contact-us.php',
    newT: 'Contact', newP: 'Book a call in two clicks.', newU: '/contact' },
];

const cardVars = (p: (typeof scenePages)[number]) => {
  const [tx, ty, tz] = p.to;
  const [mx, my, mz] = p.mto ?? p.to;
  return `--tx:${tx}px;--ty:${ty}px;--tz:${tz}px;--mtx:${mx}px;--mty:${my}px;--mtz:${mz}px;--rot:${p.rot}deg;--sr:${p.sr ?? 10}px;--st:${p.st ?? 20}px`;
};

const SITE_MOVE = 'https://developers.google.com/search/docs/crawling-indexing/site-move-with-url-changes';
const G2_REPORT = 'https://learn.g2.com/g2-2026-ai-search-insight-report';

const leaks = [
  { t: 'The staging block goes live.', d: `The noindex tag or robots.txt rule that kept the dev site hidden ships with the launch. Google lists it first in its own <a class="ilink" href="${SITE_MOVE}" target="_blank" rel="noopener">site-move troubleshooting</a>.` },
  { t: "Redirects point to pages that don't exist.", d: 'Google says it frequently sees sites redirect old URLs to wrong, non-existent URLs on the new site.' },
  { t: 'Everything redirects to the homepage.', d: "It's the fast option. Google may treat it as a soft 404, a page that's gone." },
  { t: 'Old URLs live on inside the new site.', d: 'Internal links, canonical tags and the sitemap still point at the old addresses, so every click becomes a redirect hop. Google wants self-referencing canonicals and short chains, ideally no more than 3 hops.' },
  { t: 'Schema stays behind.', d: "Schema that came from an old plugin or theme doesn't follow you to the new one. The new pages go live without it." },
  { t: 'AI crawlers get shut out.', d: 'A fresh robots.txt blocks GPTBot or ClaudeBot by accident. I keep finding this one in audits.' },
];

// Section 2. g = which glyph draws the item's story (markup in GLYPH, motion in the page script).
const carried = [
  { g: 'redirect', t: 'Every old URL mapped and 301-redirected.', d: 'Google recommends server-side permanent redirects, kept for at least a year.' },
  { g: 'meta', t: 'Titles, meta descriptions, headings and schema moved across.', d: 'Page by page.' },
  { g: 'sitemap', t: 'An automated sitemap.xml.', d: 'It rebuilds on every publish, with a real last-modified date on each URL.' },
  { g: 'index', t: 'Indexing submitted on launch day.', d: 'The sitemap goes to Google Search Console and Bing Webmaster Tools, plus an IndexNow ping. Fastest so far: a page indexed and ranking in <strong>under 22 hours</strong>.' },
];

const rebuilt = [
  { g: 'answer', t: 'Designed for AI engines.', d: 'One clear answer per section, and headings written the way buyers ask.' },
  { g: 'nav', t: 'Better UX and easy navigation.', d: 'Every service page one click from the menu.' },
  { g: 'semantic', t: 'Semantic HTML structure.', d: 'Header, main, article, section and nav where they belong, so machines read the page the way people do.' },
  { g: 'fast', t: 'Static render, fast loading.', d: 'Pages ship as pre-rendered HTML.' },
  { g: 'lead', t: 'Automated lead capture.', d: 'Every form sends the lead to HubSpot or your CRM and adds them to your email list and newsletter.' },
  { g: 'analytics', t: 'Better analytics.', d: 'GA4 and Search Console connected, with every form tracked as a conversion.' },
];

// 48x48 glyphs. Their finished drawing is the static state, so they read even without JS.
const GLYPH: Record<string, string> = {
  redirect: '<rect class="m" x="4" y="8" width="23" height="8" rx="2.5"/><path class="strike" d="M7 12h17" pathLength="1"/><path class="arc" d="M11 17c0 10 4 16.5 11 16.5" pathLength="1"/><path class="head" d="M19 30l3.4 3.5-3.4 3.5" pathLength="1"/><rect class="nw" x="23" y="29.5" width="21" height="8" rx="2.5" pathLength="1"/><text class="t" x="25" y="23.5">301</text>',
  meta: '<rect class="m" x="3.5" y="9" width="17" height="30" rx="3"/><rect class="m" x="27.5" y="9" width="17" height="30" rx="3"/><path class="l" d="M7.5 16.5h9"/><path class="l" d="M7.5 23h6.5"/><path class="l" d="M7.5 29.5h9"/>',
  sitemap: '<path class="e" d="M24 13v6.5M24 19.5H12.5v6M24 19.5h11.5v6M24 19.5v6" pathLength="1"/><circle class="n0" cx="24" cy="9.5" r="3.4"/><circle class="n1" cx="12.5" cy="29" r="3.4"/><circle class="n2" cx="24" cy="29" r="3.4"/><circle class="n3" cx="35.5" cy="29" r="3.4"/><path class="e2" d="M35.5 32.5v4.5" pathLength="1"/><circle class="n4 fill" cx="35.5" cy="40.5" r="3.4"/>',
  index: '<rect class="m" x="4" y="13" width="15" height="21" rx="2.5"/><path class="m" d="M7.5 19h8M7.5 23.5h6M7.5 28h8"/><path class="p p1" d="M19.5 20c8 0 9-8 14.5-8" pathLength="1"/><path class="p p2" d="M19.5 27c8 0 9 8 14.5 8" pathLength="1"/><circle class="eg" cx="39" cy="12" r="4.4"/><circle class="eg" cx="39" cy="35" r="4.4"/><path class="k k1" d="M37 12.2l1.4 1.4 2.6-2.8" pathLength="1"/><path class="k k2" d="M37 35.2l1.4 1.4 2.6-2.8" pathLength="1"/>',
  answer: '<rect class="m q" x="5" y="6" width="27" height="10" rx="5"/><path class="a" d="M8 24.5h30" pathLength="1"/><path class="m a" d="M8 31h23" pathLength="1"/><path class="m a" d="M8 37.5h27" pathLength="1"/><path class="sp fill" d="M40.5 5l1.3 3.3 3.3 1.3-3.3 1.3-1.3 3.3-1.3-3.3-3.3-1.3 3.3-1.3z"/>',
  nav: '<rect class="m" x="4" y="7" width="40" height="9" rx="3"/><path class="m" d="M9 11.5h6"/><path class="i2" d="M20.5 11.5h7"/><path class="m" d="M33 11.5h6"/><rect class="pg" x="8" y="21" width="32" height="20" rx="3" pathLength="1"/><path class="cur fill" d="M0 0l9 4.6-3.8 1-1.8 3.8z" transform="translate(24 12)"/>',
  semantic: '<rect class="b" x="5" y="5" width="38" height="7" rx="2" pathLength="1"/><rect class="b" x="5" y="15.5" width="24" height="19" rx="2" pathLength="1"/><rect class="b" x="32" y="15.5" width="11" height="19" rx="2" pathLength="1"/><rect class="b" x="5" y="38" width="38" height="5" rx="2" pathLength="1"/><path class="m tl" d="M9.5 21.5h15M9.5 26h11M9.5 30.5h13"/>',
  fast: '<rect class="m" x="5" y="7" width="26" height="34" rx="3"/><path class="pl" d="M10 15h16M10 21h11M10 27h16M10 33h8"/><path class="bolt" d="M41 6l-7 14h6.5l-5 15" pathLength="1"/>',
  lead: '<rect class="m" x="3.5" y="9" width="19" height="6.5" rx="2"/><rect class="m" x="3.5" y="18.5" width="19" height="6.5" rx="2"/><rect x="3.5" y="28" width="11" height="6.5" rx="2"/><circle class="tok fill" cx="9" cy="31.2" r="2.2" opacity="0"/><rect class="m c1" x="30" y="25" width="14.5" height="10" rx="2.5"/><rect class="m c2" x="30" y="13" width="14.5" height="10" rx="2.5"/><rect class="cn" x="30" y="13" width="14.5" height="10" rx="2.5"/>',
  analytics: '<path class="m" d="M6 7v34h36"/><path class="up" d="M9 35l8-8 6 3.5 8-10.5 9-9" pathLength="1"/><circle class="ring" cx="40" cy="11" r="3" opacity="0"/><circle class="dot fill" cx="40" cy="11" r="3"/>',
};

// Section 3. bs/bp crop one frame of the shoot per card: three motion clones, then the figure in focus on launch day.
const sprint = [
  { days: 'Days 1 to 2', bs: '340%', bp: '0% 51%', t: 'Crawl and map.', d: 'I crawl every URL on your current site and pull its Search Console history. Every page with clicks, impressions or links pointing at it gets a new home before design starts.' },
  { days: 'Days 3 to 5', bs: '311%', bp: '18.4% 46%', t: 'Design.', d: 'You see the homepage, a service page, a blog post and the contact page by day 5. You approve, or we fix it the same week.' },
  { days: 'Days 6 to 9', bs: '310%', bp: '100% 48.5%', t: 'Build.', d: 'Pages, schema, forms wired to your CRM, analytics and the sitemap.' },
  { days: 'Day 10', bs: '280%', bp: '50.6% 21.9%', t: 'Test, then launch.', d: 'Every old URL is tested against its redirect, and robots.txt, canonicals and schema are checked on staging first. Then the site goes live, and the sitemap, IndexNow ping and Search Console requests go out the same day.' },
];

const b2b = [
  { t: 'One page per service.', d: "Who it's for, how it works, how long it takes. Answered in the first lines, where a buyer and an AI can both find it." },
  { t: 'Proof next to the claim.', d: 'Case files labelled by industry and region, with the numbers, on the pages where the decision happens.' },
  { t: 'Forms that qualify.', d: 'Ask what your sales team asks on the first call, then send it straight to your CRM.' },
  { t: 'Schema that names you.', d: 'Organization, Service and FAQ markup, so AI engines can tell who you are, what you sell and who you sell it to.' },
];

// Section 5. rgb = the platform's own brand colour (Astro gets its two-tone gradient).
const platforms = [
  { name: 'WordPress', icon: '/icons/wordpress-icon-alt.svg', rgb: '56,88,233',
    d: 'Stay if your team publishes every week and lives in the editor. A WordPress website redesign rebuilds the theme and keeps your slugs. Anything that has to move gets a 301 through the Redirection plugin.' },
  { name: 'Webflow', icon: '/icons/webflow-icon.svg', rgb: '20,110,245',
    d: 'For marketing teams who want to change a page without waiting on a developer. The URL map and the 301 plan work the same way.' },
  { name: 'Framer', icon: '/icons/framer.svg', rgb: '0,153,255',
    d: 'Pick it when motion is part of the brand. Framer writes the sitemap and handles permanent redirects in its site settings. Schema goes in through its custom code, page by page.' },
  { name: 'Astro', icon: '/icons/astro-icon.svg', rgb: '255,93,1', rgb2: '188,82,238',
    d: 'The one I reach for when speed matters most. Pages ship as static HTML, and the sitemap rebuilds on every deploy. This site runs on it.' },
];

// Section 4. The buyer's question, asked in three AI engines. Vendors A to C stand in for real shipping companies.
const CHAT_Q = 'Which companies export cars from the US to Dubai?';
const GPT_PATH = 'M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08-4.778 2.758a.795.795 0 0 0-.393.681zm1.097-2.365 2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z';
const LINK_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>';
const SCHEMA_SNIPPET = '{ "@type": <span class="bb-s">"Organization"</span>,\n  <span class="bb-hl" style="--dl:.2s">"name": <span class="bb-s">"Vendor A"</span>,</span>\n  "makesOffer": {\n    "@type": <span class="bb-s">"Service"</span>,\n    <span class="bb-hl" style="--dl:.5s">"name": <span class="bb-s">"Car shipping to Dubai"</span></span>\n  } }';
const industryRows = [
  ['Logistics', '3PL', 'Import/Export', 'Ecommerce', 'SaaS', 'Software Development & Agencies', 'Manufacturing'],
  ['Consultancies', 'Hospitality', 'Dental & Med Spa', 'Scaffolding', 'Trades and Home Services', 'HVAC', 'Real Estate and Property'],
];

const faqs = [
  { q: 'How long does a website redesign take?', a: "Two weeks. Ten working days from the first crawl to launch. That assumes your copy and brand files are ready on day one. If they aren't, the sprint starts when they are." },
  { q: 'Will a website redesign hurt my SEO?', a: 'It can. The damage comes from the move, not the design: broken redirects, a staging block left live, schema left behind. Every one of those gets checked on staging before launch. Expect a short wobble while Google processes the move. Google itself says rankings settle down over time.' },
  { q: 'What should a website redesign checklist include?', a: 'Start with what you already have: a full crawl, your Search Console data and a URL map. Then the 301 plan. Metadata and schema carried across. Internal links pointed at the new URLs. robots.txt and noindex checks. A fresh sitemap, and indexing requests on launch day.' },
  { q: 'What is the website redesign process?', a: 'Map, design, build, test, launch. In that order. The URL map comes first because it sets what the new design has to keep. Design comes before build so you approve the look before a single page is coded.' },
  { q: 'Do I need a full redesign, or just fixes?', a: "Fix it if the site is fast, your team can edit it, and leads come in. Redesign it if pages take seconds to load, every change needs a developer, or buyers and AI engines can't tell what you sell from the homepage. A free audit tells you which, before you spend anything." },
  { q: 'How do I write a website redesign RFP?', a: 'Give vendors what they need to quote: your goals, current platform, page count, the pages that bring traffic and leads, integrations like your CRM, and your deadline. Then ask each one how they handle redirects and SEO during the move. A vague answer to that question tells you enough.' },
  { q: 'What happens to my existing content?', a: 'Pages that earn traffic or links keep their content, or merge into a stronger page with a 301. Pages nobody visits get merged or retired. Nothing disappears without a redirect or a reason.' },
];
// The FAQ section renders these answers and emits this FAQPage schema next to them.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout title={meta.title} description={meta.description} canonical={url} schema={schema}>
  <Nav />
  <div class="scroll-prog" id="scrollProg"></div>

  <main class="rd-page">

    <!-- Hero: the old site's pages move into the new sitemap, each one stamped with its 301 -->
    <section class="rd-hero" id="rdHero">
      <div class="rd-pin">
        <div class="rd-copy">
          <nav class="rd-bc rv" aria-label="Breadcrumb">
            <a href="/">Home</a><span aria-hidden="true">/</span><a href="/services">Services</a><span aria-hidden="true">/</span><span aria-current="page">Website redesign</span>
          </nav>
          <h1 class="rd-h1 rv d1">Website redesign services <em class="grad-anim">that protect your rankings.</em></h1>
          <p class="rd-deck rv d2">Two weeks, old site to new. Every URL, redirect and piece of schema your old site earned moves across first. Then the design, speed and lead capture get rebuilt in a structure AI engines can read.</p>
          <div class="rd-actions rv d3">
            <a class="btn-p" href="#rd-cta" data-cursor="Book a free audit">Book a free audit</a>
            <a class="rd-link" href="#sprint">See the 2-week sprint</a>
          </div>
        </div>

        <div class="rd-scene" aria-hidden="true">
          <div class="rd-fit">
            <div class="rd-stage">
              <div class="rd-bloom"></div>
              {scenePages.map((p, i) => (
                <div class={`rd-ground is-${p.tier}`} data-m={p.m ? '' : undefined} style={cardVars(p)}></div>
              ))}
              {scenePages.map((p, i) => (
                <div
                  class={`rd-card is-${p.tier}`}
                  data-i={i}
                  data-m={p.m ? '' : undefined}
                  data-to={p.to.join(',')}
                  data-mto={(p.mto ?? p.to).join(',')}
                  data-pile={p.pile.join(',')}
                  data-mpile={(p.mpile ?? p.pile).join(',')}
                  data-rot={p.rot}
                  style={cardVars(p)}
                >
                  <span class="rd-slab"></span><span class="rd-sh rd-sh-rest"></span><span class="rd-sh rd-sh-lift"></span>
                  <div class="rd-face rd-old">
                    <div class="o-bar"><b>LOGO</b><span>Home</span><span>Services</span><span>About</span><span>Contact</span></div>
                    <div class="o-body"><div class="o-title">{p.oldT}</div><div class="o-p" set:html={p.oldP} /><span class="o-btn">Click Here</span></div>
                    <span class="rd-url">{p.oldU}</span>
                  </div>
                  <div class="rd-face rd-new">
                    <div class="n-bar"><i></i></div>
                    <div class="n-title">{p.newT}</div><div class="n-p">{p.newP}</div>
                    <span class="rd-url">{p.newU}</span>
                  </div>
                  <span class="rd-stamp"><b>301</b><small>from {p.oldU}</small></span>
                </div>
              ))}
            </div>
            <p class="rd-caption">Every old URL has a <strong>new home</strong>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 1 · Where redesigns lose traffic: each leak replays the move with the hero's materials and ends in a red ink stamp.
         Desktop: the leak crossing mid-screen drives one sticky stage. Phones: every leak plays its own scene. -->
    <section class="lk" id="leaks" aria-labelledby="lkH">
      <div class="lk-wrap">
        <header class="lk-hdr">
          <h2 class="sec-h rv" id="lkH">Where redesigns<br><em class="grad-anim">lose traffic.</em></h2>
          <p class="lk-lead rv d1">Rankings don't drop because the new site looks different. They drop because of what breaks in the move.</p>
        </header>
        <div class="lk-story">
          <ol class="lk-list">
            {leaks.map((l, i) => (
              <li class={`lk-item${i === 0 ? ' is-on' : ''}`} data-i={i}>
                <span class="lk-n">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="lk-t">{l.t}</h3>
                  <p class="lk-d" set:html={l.d} />
                  <div class="lk-inline" aria-hidden="true"></div>
                </div>
              </li>
            ))}
          </ol>
          <div class="lk-stage-col" aria-hidden="true">
            <div class="lk-stage">
              <div class="lk-box">
                <div class="lk-hud"><span>Leak <b class="lk-num">01</b> / 06</span><span class="lk-ticks">{leaks.map((_, i) => <i class={i === 0 ? 'is-on' : undefined}></i>)}</span></div>
              </div>
            </div>
          </div>
        </div>
        <div class="lk-foot">
          <div class="lk-check" aria-hidden="true"><span class="stp ok"><b>DAY 10</b></span></div>
          <p class="lk-callout">Day 10 of the sprint checks every one of these on staging before anything goes live.</p>
          <p class="lk-note">Even a clean move wobbles. <a class="ilink" href={SITE_MOVE} target="_blank" rel="noopener">Google says</a> to expect temporary fluctuation in rankings, and that they settle down over time.</p>
        </div>
      </div>
    </section>

    <!-- 2 · What the redesign includes: a plain two-group list. Each glyph tile is a tiny page from the hero:
