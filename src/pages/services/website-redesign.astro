  .inc-grp{position:relative;display:grid;grid-template-columns:minmax(0,300px) minmax(0,1fr);gap:clamp(28px,4.5vw,80px);padding:clamp(36px,4vw,56px) 0}
  .inc-grp::before{content:'';position:absolute;left:0;right:0;top:0;height:1px;background:var(--rule)}
