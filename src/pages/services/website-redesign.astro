    .inc-lab{flex-direction:column;align-items:flex-start;gap:8px}
    .inc-obj{transform:scale(.72);margin:-20px 0 -26px 4px}
  }
  @media (prefers-reduced-motion:reduce){
    .lk-item,.lk-n,.lk-ticks i,.lk-check .stp,.inc .pp,.inc .stp,.inc .np,.inc .bloom,.inc-g{transition:none}
  }
</style>

<script>
  // Sections 1 + 2. GSAP is downloaded only when either section is close to the screen.
  // Without JS or GSAP, both sections still read: section 1 as a plain list, section 2 with its glyphs in their finished state.
  const leaksEl = document.getElementById('leaks');
  const incEl = document.getElementById('includes');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let gsapLib: any = null;
  const loadGsapOnce = async () => (gsapLib ||= (await import('gsap')).default);
  const whenNear = (el: Element | null, fn: () => void) => {
    if (!el) return;
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); fn(); } }, { rootMargin: '600px 0px' });
    io.observe(el);
  };
  whenNear(leaksEl, () => loadGsapOnce().then((g) => setupLeaks(leaksEl!, g)).catch(() => {}));
  whenNear(incEl, () => setupIncludes(incEl!));

  /* ── 1 · leaks ─────────────────────────────────────────── */
  function setupLeaks(sec: HTMLElement, gsap: any) {
    const ICON = { gpt: '/icons/chatgpt-icon.svg', claude: '/icons/claude-icon.svg' };
    const narrow = matchMedia('(max-width: 900px)');
    const DESK = { W: 560, H: 385 }, MOB = { W: 340, H: 420 };
    let uid = 0;
    sec.classList.add('is-ready');   // phones reserve room for their scenes only once GSAP is here

    const el = (cls: string, html?: string, parent?: Element) => { const n = document.createElement('div'); n.className = cls; if (html) n.innerHTML = html; if (parent) parent.appendChild(n); return n; };
    const at = (n: any, p: number[], more?: object) => gsap.set(n, Object.assign({ x: p[0], y: p[1], xPercent: -50, yPercent: -50 }, more || {}));
    const q = (n: Element, s: string) => n.querySelector(s) as HTMLElement;
    const bez = (a: number[], c: number[], b: number[], t: number) => { const u = 1 - t; return [u * u * a[0] + 2 * u * t * c[0] + t * t * b[0], u * u * a[1] + 2 * u * t * c[1] + t * t * b[1]]; };
    const shadows = '<span class="sh sh-r"></span><span class="sh sh-l"></span>';
    const oldFace = (p: any) => '<div class="face f-old"><div class="o-bar"><b>LOGO</b><span>Home</span><span>Services</span><span>About</span><span>Contact</span></div>' +
      '<div class="o-body"><div class="o-title">' + p.t + '</div>' + (p.p ? '<div class="o-p">' + p.p + '</div>' : '') + '</div><span class="url">' + p.u + '</span></div>';
    const newFace = (p: any, cls = '') => '<div class="face f-new' + cls + '"><div class="n-bar"><i></i></div><div class="n-title">' + p.t + '</div>' + (p.p ? '<div class="n-p">' + p.p + '</div>' : '') + (p.extra || '') + '<span class="url">' + p.u + '</span></div>';
    const oldPage = (p: any, size?: string) => el('o pg ' + (size || 'pg-old'), shadows + oldFace(p));
