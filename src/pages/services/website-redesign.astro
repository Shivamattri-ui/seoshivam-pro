  /* ── 2 · What the redesign includes ─────────────────────── */
  .inc{position:relative;padding:clamp(72px,9vw,140px) clamp(16px,3vw,40px)}
  .inc-wrap{max-width:1440px;margin:0 auto;padding:0 clamp(4px,2vw,40px)}
  .inc-hdr{display:flex;justify-content:space-between;align-items:flex-end;gap:clamp(24px,5vw,80px);margin-bottom:clamp(36px,5vw,72px)}
