<script>
  // Hero scene. Desktop (mouse + wide): pinned, scroll-scrubbed with GSAP ScrollTrigger, which Nav.astro
  // already wires to Lenis. Touch or narrow: plays once when the scene comes into view. Reduced motion,
  // no JS or a failed GSAP load: the CSS already renders the finished frame, so nothing is lost.
  const hero = document.getElementById('rdHero');
  if (hero) setupRedesignHero(hero);

  function setupRedesignHero(hero: HTMLElement) {
    const scene = hero.querySelector<HTMLElement>('.rd-scene')!;
    const fit = hero.querySelector<HTMLElement>('.rd-fit')!;
    const stage = hero.querySelector<HTMLElement>('.rd-stage')!;
    const bloom = hero.querySelector<HTMLElement>('.rd-bloom')!;
    const caption = hero.querySelector<HTMLElement>('.rd-caption')!;
    const allCards = [...hero.querySelectorAll<HTMLElement>('.rd-card')];
    const allGrounds = [...hero.querySelectorAll<HTMLElement>('.rd-ground')];
    const narrow = matchMedia('(max-width: 900px)');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const touch = matchMedia('(hover: none)').matches;
    const nums = (s?: string) => (s || '').split(',').map(Number);
    const q = (el: Element, s: string) => el.querySelector(s);

    const fitScene = () => {
      const s = narrow.matches
        ? Math.min(1, scene.clientWidth / 410, scene.clientHeight / 520)
        : Math.min(1, scene.clientWidth / 720, scene.clientHeight / 620);
      fit.style.setProperty('--fit', s.toFixed(3));
    };
    fitScene();
    addEventListener('resize', fitScene, { passive: true });

    if (reduce) { hero.classList.add('is-ready'); return; }

    let gsap: any = null, ST: any = null;
    let run: any = null;

    async function loadGsap() {
      if (!gsap) {
        gsap = (await import('gsap')).default;
        ST = (await import('gsap/ScrollTrigger')).ScrollTrigger;
        gsap.registerPlugin(ST);
      }
    }

    function teardown() {
      if (!run) return;
      run.st?.kill(); run.io?.disconnect(); run.tween?.kill(); run.tl.kill();
      gsap.set([...allCards, ...allGrounds, stage, bloom, caption], { clearProps: 'transform,opacity' });
      gsap.set(hero.querySelectorAll('.rd-old,.rd-new,.rd-sh-rest,.rd-sh-lift,.rd-stamp'), { clearProps: 'transform,opacity' });
      run = null;
    }

    async function build() {
      try { await loadGsap(); } catch { hero.classList.add('is-ready'); return; }
      teardown();
      const mobile = narrow.matches;
      const scrub = !mobile && !touch;
      hero.classList.toggle('is-scrub', scrub);
      const cards = mobile ? allCards.filter((c) => c.hasAttribute('data-m')) : allCards;
      const grounds = cards.map((c) => allGrounds[Number(c.dataset.i)]);

      // starting pile: the old site
      cards.forEach((c, i) => {
        const [x, y, r] = nums(mobile ? c.dataset.mpile : c.dataset.pile);
        gsap.set(c, { x, y, z: (cards.length - i) * 4, rotationX: 0, rotationY: 0, rotationZ: r, scale: 1.22 });
        gsap.set(grounds[i], { x, y, z: -2, rotationZ: r, scale: 1.22, opacity: .85 });
        gsap.set(q(c, '.rd-old'), { opacity: 1 });
        gsap.set(q(c, '.rd-new'), { opacity: 0 });
        gsap.set(q(c, '.rd-sh-rest'), { opacity: 1 });
        gsap.set(q(c, '.rd-sh-lift'), { opacity: 0 });
        gsap.set(q(c, '.rd-stamp'), { opacity: 0, z: 1, scale: 2.1, rotation: -26 });
      });
      gsap.set(bloom, { opacity: 0, scale: .82 });
      gsap.set(caption, { opacity: 0, y: 10 });
      gsap.set(stage, { rotationX: 24, rotationY: -26, rotationZ: 3 });
      hero.classList.add('is-ready');

      const tl = gsap.timeline({ paused: true, defaults: { ease: 'none' } });
      const step = mobile ? .16 : .1;
      cards.forEach((c, i) => {
        const g = grounds[i];
        const [tx, ty, tz] = nums(mobile ? c.dataset.mto : c.dataset.to);
        const t0 = .04 + i * step;
        tl.to(c, { z: 170, rotationX: -18, rotationY: 14, rotationZ: 0, duration: .07, ease: 'power2.out' }, t0)          // lift
          .to(q(c, '.rd-sh-rest'), { opacity: 0, duration: .05 }, t0)
          .to(q(c, '.rd-sh-lift'), { opacity: 1, duration: .05 }, t0)
          .to(g, { scale: 1.4, opacity: .3, rotationZ: 0, duration: .07, ease: 'power2.out' }, t0)
          .to(c, { x: tx, y: ty, scale: 1, duration: .13, ease: 'power1.inOut' }, t0 + .04)                              // travel
          .to(g, { x: tx, y: ty, duration: .13, ease: 'power1.inOut' }, t0 + .04)
          .to(q(c, '.rd-old'), { opacity: 0, duration: .05 }, t0 + .1)                                                   // rebuilt mid-flight
          .to(q(c, '.rd-new'), { opacity: 1, duration: .05 }, t0 + .1)
          .to(c, { z: tz, rotationX: 0, rotationY: 0, duration: .07, ease: 'back.out(1.7)' }, t0 + .16)                 // land
          .to(g, { scale: 1, opacity: .85, duration: .07, ease: 'power2.in' }, t0 + .16)
          .to(q(c, '.rd-sh-lift'), { opacity: 0, duration: .05 }, t0 + .17)
          .to(q(c, '.rd-sh-rest'), { opacity: 1, duration: .05 }, t0 + .17)
          .to(q(c, '.rd-stamp'), { opacity: .92, scale: 1, rotation: Number(c.dataset.rot), duration: .035, ease: 'back.out(3)' }, t0 + .21); // stamped
      });
      const landed = .04 + (cards.length - 1) * step + .25;
      tl.to(stage, { rotationX: 9, rotationY: -9, rotationZ: 0, duration: landed + .1, ease: 'power1.inOut' }, 0)
        .to(bloom, { opacity: 1, scale: 1, duration: .2, ease: 'power2.out' }, landed - .06)
        .to(caption, { opacity: 1, y: 0, duration: .1, ease: 'power2.out' }, landed + .08)
        .to({}, { duration: .06 }, landed + .18);

      run = { tl, st: null, io: null, tween: null };
      if (scrub) {
        run.st = ST.create({ trigger: hero, start: 'top top', end: 'bottom bottom', scrub: .7, animation: tl });
      } else {
        run.io = new IntersectionObserver((entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          run.io.disconnect();
          run.tween = gsap.to(tl, { progress: 1, duration: 4, ease: 'power1.inOut' });
        }, { threshold: .35 });
        run.io.observe(scene);
      }
      fitScene();
      ST.refresh();
    }

    // Phones and touch screens only download GSAP when the scene is about to be seen.
    if (touch || narrow.matches) {
      const lazy = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        lazy.disconnect();
        build();
      }, { rootMargin: '300px 0px' });
      lazy.observe(scene);
    } else {
      build();
    }
    narrow.addEventListener('change', () => { if (run) build(); });
  }
</script>

