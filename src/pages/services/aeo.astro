    mask-image:radial-gradient(ellipse 92% 92% at 50% 50%,#000 60%,transparent 100%)}
  :global(html.light) .vbuy{background:
    radial-gradient(circle at 50% 50%,color-mix(in srgb,var(--ac) 12%,transparent),transparent 48%),
    radial-gradient(color-mix(in srgb,#000 6%,transparent) 1px,transparent 1px) 0 0/15px 15px,
    var(--s1)}
  .vbuy-links{position:absolute;inset:0;width:100%;height:100%;color:var(--ac);pointer-events:none}
  .vbuy-link{stroke:currentColor;stroke-width:1;fill:none;opacity:.38;vector-effect:non-scaling-stroke}
  .vbuy-pulse{fill:currentColor;filter:drop-shadow(0 0 4px var(--ac))}
  .vbuy-node{position:absolute;transform:translate(-50%,-50%);z-index:2}
  .vbuy-core{display:grid;place-items:center;width:46px;height:46px;border-radius:50%;color:#fff;background:var(--ag);
    box-shadow:0 10px 24px -6px var(--ac),0 0 0 6px color-mix(in srgb,var(--ac) 12%,transparent);
    animation:pcFloat 6s ease-in-out infinite;will-change:transform}
  .vbuy-sat{display:inline-block;font-family:var(--fm);font-size:9px;letter-spacing:.02em;color:var(--wd);white-space:nowrap;
    background:color-mix(in srgb,var(--s2) 86%,transparent);border:1px solid var(--bd);border-radius:var(--r-pill);padding:5px 11px;
    backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px);box-shadow:0 8px 18px -10px var(--pc-sh);
    animation:pcFloat 5s ease-in-out infinite;will-change:transform}
  .vbuy-node:nth-child(4) .vbuy-sat{animation-delay:-1.3s}
  .vbuy-node:nth-child(5) .vbuy-sat{animation-delay:-2.6s}
  .vbuy-node:nth-child(6) .vbuy-sat{animation-delay:-3.9s}
  .vbuy-sat--hot{color:var(--ac);background:var(--agl);border-color:color-mix(in srgb,var(--ac) 42%,var(--bd));box-shadow:0 8px 20px -8px var(--ac)}
  @keyframes pcFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}

  /* viz 03 · filter analysis -> shortlisted winner */
  .vfilter{display:flex;flex-direction:column;gap:13px}
  .vfilter-log{display:flex;flex-direction:column;gap:9px}
  .vfilter-hd{display:flex;align-items:center;gap:8px;font-family:var(--fm);font-size:10px;letter-spacing:.04em;color:var(--wd)}
  .vfilter-step{display:flex;align-items:center;gap:9px;font-family:var(--fu);font-size:12px;color:var(--wd)}
  .vfilter-ck{display:grid;place-items:center;width:16px;height:16px;border-radius:50%;flex-shrink:0;color:#fff;
    background:var(--ag);box-shadow:0 3px 8px -2px var(--ac)}
  .vfilter-win{position:relative;padding:13px 15px;border-radius:14px;
    background:linear-gradient(118deg,color-mix(in srgb,var(--ac) 16%,var(--s1)),color-mix(in srgb,var(--ac) 5%,var(--s1)));
    border:1px solid color-mix(in srgb,var(--ac) 46%,var(--bd));
    box-shadow:0 16px 34px -18px color-mix(in srgb,var(--ac) 66%,transparent),inset 0 1px 0 color-mix(in srgb,var(--w) 12%,transparent)}
  .vfilter-win-top{display:flex;align-items:center;gap:10px;margin-bottom:10px}
  .vfilter-badge{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;flex-shrink:0;color:#fff;
    background:var(--ag);box-shadow:0 5px 14px -4px var(--ac)}
  .vfilter-kw{font-family:var(--fu);font-size:14px;font-weight:800;color:var(--w)}
  .vfilter-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .vfilter-tag{font-family:var(--fm);font-size:8px;letter-spacing:.05em;text-transform:uppercase;color:var(--wm);
    background:var(--s2);border:1px solid var(--bd);border-radius:var(--r-pill);padding:4px 9px}
  .vfilter-tag--com{color:var(--ac);background:var(--agl);border-color:color-mix(in srgb,var(--ac) 34%,var(--bd))}
  .vfilter-tag--low{color:var(--green);background:color-mix(in srgb,var(--green) 10%,transparent);border-color:color-mix(in srgb,var(--green) 34%,var(--bd))}
  .vfilter-vol{font-family:var(--fm);font-size:9px;color:var(--wd)}

  /* viz 04 · terminal audit (intentionally dark in both themes, matching the site's
     always-dark code/terminal convention) */
  .vterm{border:1px solid #1E222C;border-radius:12px;overflow:hidden;background:#0B0D12;
    box-shadow:0 20px 44px -26px var(--pc-sh),inset 0 1px 0 rgba(255,255,255,.05)}
  .vterm-bar{display:flex;align-items:center;gap:6px;padding:9px 12px;background:#12151C;border-bottom:1px solid rgba(255,255,255,.06)}
  .vterm-bar i{width:8px;height:8px;border-radius:50%;background:#333A47;display:block}
  .vterm-ttl{margin-left:6px;font-family:var(--fm);font-size:9px;letter-spacing:.06em;color:#7A8291}
  .vterm-body{padding:13px 14px;display:flex;flex-direction:column;gap:8px}
  .vterm-line{display:flex;align-items:center;gap:9px;font-family:var(--fm);font-size:11px;color:#AEB6C4;line-height:1.4}
  .vterm-p{color:var(--ac)}
  .vterm-ok{color:#C7D0DD}
  .vterm-ck{display:grid;place-items:center;width:15px;height:15px;border-radius:4px;flex-shrink:0;color:#0B0D12;background:#3BD488}
  .vterm-cur{width:7px;height:13px;background:var(--ac)}
  .vterm-run{opacity:.9}

  /* viz 05 · content pillars */
  .vpil-cols{display:flex;align-items:flex-end;gap:11px;height:clamp(80px,10.5vh,108px)}
  .vpil-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:8px;height:100%}
  .vpil-track{flex:1;min-height:0;width:100%;display:flex;align-items:flex-end;justify-content:center}
  .vpil-bar{width:100%;max-width:26px;height:var(--h);border-radius:6px 6px 3px 3px;
    background:linear-gradient(180deg,var(--ac),color-mix(in srgb,var(--ac) 22%,transparent))}
  .vpil-col b{font-family:var(--fm);font-size:8px;letter-spacing:.04em;text-transform:uppercase;color:var(--wd)}

  /* viz 06 · answer-first document */
  .vdoc-lines{display:flex;flex-direction:column;gap:8px;margin-bottom:13px}
  .vdoc-line{height:7px;border-radius:4px;background:var(--s3);width:88%}
  .vdoc-line--lead{height:9px;width:100%;background:linear-gradient(90deg,color-mix(in srgb,var(--ac) 50%,transparent),color-mix(in srgb,var(--ac) 12%,transparent))}
  .vdoc-line--sm{width:60%}
  .vdoc-tags{display:flex;flex-wrap:wrap;gap:7px}
  .vdoc-cite{display:inline-flex;align-items:center;gap:6px;font-family:var(--fm);font-size:8.5px;letter-spacing:.03em;
    color:var(--ac);background:var(--agl);border:1px solid color-mix(in srgb,var(--ac) 32%,var(--bd));border-radius:var(--r-pill);padding:4px 9px}
  .vdoc-cite .vfilter-ck{width:13px;height:13px}
  .vdoc-schema{font-family:var(--fm);font-size:8.5px;color:var(--wd);background:var(--s2);border:1px solid var(--bd);border-radius:var(--r-pill);padding:4px 9px}

  /* viz 07 · distribution */
  .vdist-logos{display:flex;gap:8px;margin-bottom:12px}
  .vdist-logo{display:grid;place-items:center;width:32px;height:32px;border-radius:9px;background:#fff;flex-shrink:0;
    box-shadow:0 5px 14px -6px var(--pc-sh),0 0 0 1px rgba(0,0,0,.05);animation:pcFloat 5s ease-in-out infinite;will-change:transform}
  .vdist-logo:nth-child(2){animation-delay:-1.2s}
  .vdist-logo:nth-child(3){animation-delay:-2.4s}
  .vdist-logo:nth-child(4){animation-delay:-3.6s}
  .vdist-stat{font-family:var(--fu);font-size:11px;color:var(--wd)}
  .vdist-n{font-family:var(--fd);font-size:19px;color:var(--w);font-weight:400;margin-right:2px}

  /* viz 08 · pipeline impact */
  .vtrack-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:11px}
  .vtrack-metric{display:flex;flex-direction:column;gap:2px}
  .vtrack-metric b{font-family:var(--fd);font-size:26px;font-weight:400;color:var(--w);line-height:1}
  .vtrack-metric span{font-family:var(--fm);font-size:8px;letter-spacing:.1em;text-transform:uppercase;color:var(--wm)}
  .vtrack-spark{width:50%;height:40px;color:var(--ac);flex-shrink:0}
  .vtrack-sub{font-family:var(--fu);font-size:10.5px;color:var(--wd);padding-top:10px;border-top:1px solid var(--bd)}
  .vtrack-sub b{font-family:var(--fm);color:var(--w);font-size:11px;margin-left:4px}

  /* viz 09 · content freshness */
  .vfresh-meter{height:8px;border-radius:5px;background:var(--s3);overflow:hidden;margin-bottom:8px}
  .vfresh-fill{display:block;height:100%;width:var(--w);border-radius:5px;background:var(--ag);box-shadow:0 0 14px -3px var(--ac)}
  .vfresh-scale{display:flex;justify-content:space-between;margin-bottom:14px;font-family:var(--fm);font-size:8px;letter-spacing:.06em;text-transform:uppercase;color:var(--wm)}
  .vfresh-pct{color:var(--green)}
  .vfresh-log{display:flex;flex-direction:column;gap:9px}
  .vfresh-item{display:flex;align-items:center;gap:9px;font-family:var(--fu);font-size:12px;color:var(--wd)}
  .vfresh-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;background:var(--ac);box-shadow:0 0 8px var(--ac)}

  /* finale · knowledge graph */
  .pc-fin{margin-top:clamp(24px,4vh,44px)}
  .pc-fin-card{position:relative;overflow:hidden;display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);
    gap:clamp(20px,3vw,48px);align-items:center;padding:clamp(24px,3vw,40px);
    border:1px solid var(--bd);border-radius:24px;background:linear-gradient(150deg,var(--s2) 0%,var(--s1) 60%);
    box-shadow:0 24px 56px -30px var(--pc-sh)}
  .pc-fin-card::before{content:'';position:absolute;inset:0;pointer-events:none;border-radius:inherit;
    background:radial-gradient(52% 60% at 78% 50%,color-mix(in srgb,var(--ac) 12%,transparent),transparent 72%)}
  .pc-fin-txt,.pc-fin-viz{position:relative;z-index:1}
  .pc-tab--fin{margin-bottom:14px}
  .pc-fin-h{font-family:var(--fd);font-size:clamp(24px,3vw,34px);font-weight:400;color:var(--w);letter-spacing:-.02em;line-height:1.08;margin:0 0 12px}
  .pc-fin-d{font-family:var(--fu);font-size:14px;color:var(--wd);line-height:1.7;margin:0;max-width:44ch}
  .vent{position:relative;width:100%;aspect-ratio:520/300;
    background:
      radial-gradient(circle at 50% 50%,color-mix(in srgb,var(--ac) 12%,transparent),transparent 44%),
      radial-gradient(color-mix(in srgb,var(--w) 6%,transparent) 1px,transparent 1px) 0 0/17px 17px,transparent;
    -webkit-mask-image:radial-gradient(ellipse 88% 88% at 50% 50%,#000 62%,transparent 100%);
    mask-image:radial-gradient(ellipse 88% 88% at 50% 50%,#000 62%,transparent 100%)}
  :global(html.light) .vent{background:
    radial-gradient(circle at 50% 50%,color-mix(in srgb,var(--ac) 10%,transparent),transparent 44%),
    radial-gradient(color-mix(in srgb,#000 6%,transparent) 1px,transparent 1px) 0 0/17px 17px,transparent}
  .vent-links{position:absolute;inset:0;width:100%;height:100%;color:var(--ac);pointer-events:none}
  .vent-link{stroke:currentColor;stroke-width:1;fill:none;opacity:.32;vector-effect:non-scaling-stroke}
  .vent-pulse{fill:currentColor;filter:drop-shadow(0 0 4px var(--ac))}
  .vent-node{position:absolute;transform:translate(-50%,-50%);z-index:2;display:grid;place-items:center}
  .vent-eng,.vent-id{width:clamp(30px,3.4vw,40px);aspect-ratio:1;border-radius:50%;background:#fff;
    box-shadow:0 8px 20px -6px var(--pc-sh),0 0 0 1px rgba(0,0,0,.06)}
  .vent-eng img,.vent-id img{width:52%;height:52%;object-fit:contain}
  .vent-core{padding:9px 16px;border-radius:var(--r-pill);background:var(--ag);white-space:nowrap;
    box-shadow:0 14px 30px -8px var(--ac),0 0 0 7px color-mix(in srgb,var(--ac) 12%,transparent)}
  .vent-core .iccl-1,.vent-core .iccl-2{color:#fff;-webkit-text-fill-color:#fff;background:none;
    font-family:var(--fu);font-weight:800;font-size:clamp(13px,1.5vw,16px);font-style:normal}
  .vent-core .iccl-2{font-family:var(--fd);font-style:italic;font-weight:400}

  .vterm-cur{animation:pcCaret 1.1s steps(1) infinite}
  @keyframes pcCaret{0%,49%{opacity:1}50%,100%{opacity:0}}

  @media(max-width:820px){
    .pc-bento{grid-template-columns:1fr}
    .pcard--01,.pcard--02,.pcard--half,.pcard--hero{grid-column:auto}
    .pcard--hero{flex-direction:column;align-items:stretch}
    .pcard--hero .pcard-txt{flex:none;max-width:none}
    .pc-fin-card{grid-template-columns:1fr;gap:24px}
  }
  @media(prefers-reduced-motion:reduce){
    .vbuy-sat,.vbuy-core,.vdist-logo,.vspin,.vterm-cur{animation:none}
    .vbuy-pulse,.vent-pulse{display:none}
  }


  /* ══ SERVICES: rounded inset panel, click-to-reveal + gradient art ══ */
  .svc{--pc-sh:rgba(0,0,0,.5);
    position:relative;margin:14px 14px 0;border-radius:32px;overflow:hidden;isolation:isolate;scroll-margin-top:90px;
    padding:clamp(58px,8vh,92px) 0;background:var(--s1)}
  :global(html.light) .svc{--pc-sh:rgba(60,52,40,.16)}
  .svc>.container{position:relative;z-index:1}
  .svc-hd{max-width:640px;margin:0 auto clamp(20px,3.5vh,38px);text-align:center}
  .svc-hd .hair{justify-content:center}
  .svc .sec-h{font-size:clamp(27px,3.6vw,46px);line-height:1.02}
  .svc-deck{font-family:var(--fu);font-size:clamp(13px,1.4vw,15px);color:var(--wd);line-height:1.65;margin:14px auto 0;max-width:500px}
  .svc-grid{display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);gap:clamp(24px,4vw,52px);align-items:center}

  /* left · service list */
  .svc-nav{display:flex;flex-direction:column;gap:2px}
  .svc-item{display:flex;align-items:center;gap:13px;width:100%;text-align:left;cursor:pointer;
    padding:clamp(9px,1.4vh,14px) 16px;border:1px solid transparent;border-radius:14px;background:transparent;
    transition:background .3s,border-color .3s}
  .svc-item-n{font-family:var(--fm);font-size:11px;color:var(--wm);transition:color .3s;flex-shrink:0}
  .svc-item-t{font-family:var(--fu);font-size:clamp(15px,1.6vw,18px);font-weight:600;color:var(--wd);letter-spacing:-.01em;line-height:1.25;transition:color .3s}
  .svc-item-ar{margin-left:auto;display:grid;place-items:center;color:var(--ac);opacity:0;transform:translateX(-8px);transition:opacity .3s,transform .3s;flex-shrink:0}
  .svc-item:hover .svc-item-t{color:var(--w)}
  .svc-item.is-active{background:color-mix(in srgb,var(--ac) 9%,var(--s2));border-color:color-mix(in srgb,var(--ac) 22%,var(--bd))}
  .svc-item.is-active .svc-item-n{color:var(--ac)}
  .svc-item.is-active .svc-item-t{color:var(--w)}
  .svc-item.is-active .svc-item-ar{opacity:1;transform:none}

  /* right · stage */
  .svc-stage{min-width:0;max-width:500px;justify-self:center}
  .svc-art-wrap{position:relative;width:100%;height:clamp(210px,30vh,290px);border-radius:18px;overflow:hidden;
    border:1px solid var(--bd);box-shadow:0 22px 50px -30px var(--pc-sh);margin-bottom:clamp(14px,2vh,20px)}
  .svc-art{position:absolute;inset:0;opacity:0;visibility:hidden;transition:opacity .6s ease,visibility .6s;
    background:radial-gradient(120% 120% at 30% 20%,color-mix(in srgb,var(--ac) 20%,var(--s2)),var(--s1) 70%)}
  .svc-art.is-active{opacity:1;visibility:visible}
  .svc-blob{position:absolute;border-radius:50%;filter:blur(30px);mix-blend-mode:screen;opacity:1;will-change:transform}
  :global(html.light) .svc-blob{mix-blend-mode:normal;opacity:.6;filter:blur(34px)}
  .svc-b1{width:82%;aspect-ratio:1;left:calc(-4% + var(--seed,0)*6%);top:calc(-2% + var(--seed,0)*5%);
    background:radial-gradient(circle,var(--ac),transparent 66%);animation:svcDrift 17s ease-in-out infinite}
  .svc-b2{width:72%;aspect-ratio:1;right:calc(-6% + var(--seed,0)*5%);bottom:calc(-4% + var(--seed,0)*5%);
    background:radial-gradient(circle,var(--ac2),transparent 66%);animation:svcDrift 21s ease-in-out infinite reverse}
  .svc-b3{width:50%;aspect-ratio:1;left:calc(38% - var(--seed,0)*3%);top:calc(40% + var(--seed,0)*3%);
    background:radial-gradient(circle,color-mix(in srgb,var(--ac) 45%,#fff),transparent 64%);opacity:.85;animation:svcDrift 25s ease-in-out infinite}
  @keyframes svcDrift{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(7%,-6%) scale(1.09)}66%{transform:translate(-6%,5%) scale(.95)}}
  .svc-grain{position:absolute;inset:0;pointer-events:none;opacity:.4;mix-blend-mode:soft-light;
    background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")}
  .svc-art-tag{position:absolute;left:14px;bottom:12px;z-index:2;font-family:var(--fm);font-size:8.5px;letter-spacing:.14em;text-transform:uppercase;
    color:#fff;background:rgba(0,0,0,.32);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.16);border-radius:var(--r-pill);padding:4px 11px}
  .svc-art-icon{position:absolute;left:50%;top:43%;transform:translate(-50%,-50%);z-index:2;display:grid;place-items:center;
    width:clamp(54px,6vw,68px);aspect-ratio:1;border-radius:19px;color:#fff;
    background:rgba(255,255,255,.13);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
    border:1px solid rgba(255,255,255,.24);box-shadow:0 16px 36px -12px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.25)}
  .svc-art-icon svg{width:50%;height:50%}

  .svc-copy-wrap{display:grid}
  .svc-copy{grid-area:1/1;opacity:0;visibility:hidden;transform:translateY(8px);transition:opacity .5s ease,transform .5s ease,visibility .5s}
  .svc-copy.is-active{opacity:1;visibility:visible;transform:none}
  .svc-copy-t{font-family:var(--fd);font-size:clamp(20px,2.2vw,27px);font-weight:400;color:var(--w);letter-spacing:-.01em;line-height:1.1;margin:0 0 10px}
  .svc-copy-d{font-family:var(--fu);font-size:13.5px;color:var(--wd);line-height:1.7;margin:0 0 18px;max-width:46ch}
  .svc-copy-cta{display:inline-flex;align-items:center;gap:8px;font-family:var(--fu);font-size:13px;font-weight:700;color:var(--ac);
    transition:gap .25s}
  .svc-copy-cta:hover{gap:12px}

  /* ══ AEO OUTCOMES: featured case + hero stat + citation tiles ══ */
  .aeo-results-sec{--pc-sh:rgba(0,0,0,.5);position:relative;margin:14px 14px 0;border-radius:32px;overflow:hidden;
    background:var(--s1);padding:clamp(48px,7vh,84px) 0}
  :global(html.light) .aeo-results-sec{--pc-sh:rgba(60,52,40,.16)}
  .ro-hd{max-width:640px;margin:0 auto clamp(30px,4.5vh,48px);text-align:center}
  .ro-hd .hair{justify-content:center}
  .aeo-results-sec .sec-h{font-size:clamp(27px,3.6vw,46px);line-height:1.02}
  .ro-deck{font-family:var(--fu);font-size:clamp(13.5px,1.5vw,16px);color:var(--wd);line-height:1.65;margin:16px auto 0;max-width:520px}
  .ro-grid{display:grid;grid-template-columns:1.04fr 1fr;gap:14px;align-items:stretch}

  /* featured card with animated gradient background */
  .ro-feat{position:relative;overflow:hidden;border-radius:20px;border:1px solid var(--bd);display:flex;isolation:isolate;
    min-height:clamp(300px,42vh,420px)}
  .ro-feat-bg{position:absolute;inset:0;z-index:0;background:linear-gradient(150deg,color-mix(in srgb,var(--ac) 32%,var(--s1)),var(--s1) 72%)}
  .ro-blob{position:absolute;border-radius:50%;filter:blur(46px);mix-blend-mode:screen;will-change:transform}
  :global(html.light) .ro-blob{mix-blend-mode:normal;opacity:.6;filter:blur(50px)}
  .ro-b1{width:72%;aspect-ratio:1;left:-8%;top:-12%;background:radial-gradient(circle,var(--ac),transparent 66%);animation:svcDrift 18s ease-in-out infinite}
  .ro-b2{width:66%;aspect-ratio:1;right:-10%;bottom:-14%;background:radial-gradient(circle,var(--ac2),transparent 66%);animation:svcDrift 23s ease-in-out infinite reverse}
  .ro-b3{width:46%;aspect-ratio:1;left:34%;top:36%;background:radial-gradient(circle,color-mix(in srgb,var(--ac) 46%,#fff),transparent 64%);opacity:.82;animation:svcDrift 27s ease-in-out infinite}
  .ro-grain{position:absolute;inset:0;opacity:.4;mix-blend-mode:soft-light;
