  .s3-title{margin:10px 0 0;font-size:clamp(29px,3.2vw,44px);line-height:1.04;letter-spacing:-.028em}
  .s3-l1{font-family:var(--fu);font-weight:800;color:var(--w);letter-spacing:-.03em}
  .s3-l2{font-family:var(--fd);font-style:italic;font-weight:400;background:linear-gradient(110deg,var(--ac) 0%,#7BAEFF 25%,var(--ac2) 50%,#7BAEFF 75%,var(--ac) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  html.light .s3-l2{background:linear-gradient(110deg,var(--am) 0%,var(--am-lite) 25%,var(--am2) 50%,var(--am-lite) 75%,var(--am) 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .s3-sub{flex:0 0 auto;max-width:330px;margin:0 0 6px;font-family:var(--fu);font-size:clamp(13px,1vw,15px);line-height:1.6;color:var(--wd);text-align:right}

  /* layout: portrait | story player, equal height */
  .ab{position:relative;z-index:1;display:grid;grid-template-columns:calc(var(--ab-h) * .8) minmax(0,1fr);gap:clamp(12px,1.1vw,16px);align-items:stretch}

  /* portrait (4:5, name plate + social) */
  .ab-photo{position:relative;margin:0;height:var(--ab-h);border-radius:18px;overflow:hidden;background:var(--s3-photo-bg)}
  .s3-glow{position:absolute;z-index:0;top:40%;left:36%;transform:translate(-50%,-50%);width:min(112%,440px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--acc) 26%,transparent) 0%,transparent 66%);filter:blur(24px);opacity:.6;pointer-events:none}
  .s3-img{position:absolute;z-index:1;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top;display:block;filter:contrast(1.02) saturate(1.04);transition:transform .9s cubic-bezier(.16,1,.3,1)}
  .ab-photo:hover .s3-img{transform:scale(1.035)}
  .s3-veil{position:absolute;z-index:2;left:0;right:0;bottom:0;height:38%;background:linear-gradient(180deg,transparent 0%,var(--s3-photo-bg2) 82%);pointer-events:none}
  .s3-plate{position:absolute;z-index:3;left:0;right:0;bottom:0;margin:0;padding:0 18px 18px;display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center}
  .s3-plate-name{font-family:var(--fd);font-style:italic;font-weight:400;font-size:clamp(24px,2.2vw,30px);line-height:1;background:linear-gradient(110deg,var(--ac) 0%,#7BAEFF 32%,var(--ac2) 64%,#7BAEFF 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  html.light .s3-plate-name{background:linear-gradient(110deg,var(--am) 0%,var(--am-lite) 32%,var(--am2) 64%,var(--am-lite) 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .s3-plate-tag{font-family:var(--fm);font-size:9px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--wd)}
  .s3-social{display:flex;gap:8px;margin-top:4px}
  .s3-soc{width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;color:var(--wd);background:color-mix(in srgb,var(--w) 8%,transparent);transition:color .45s,background .45s,transform .45s}
  html.light .s3-soc{background:color-mix(in srgb,#000 6%,transparent)}
  .s3-soc svg{width:15px;height:15px}
  .s3-soc:hover{color:var(--acc);background:color-mix(in srgb,var(--acc) 16%,transparent);transform:translateY(-2px)}

  /* story player (base = list layout, used on mobile and without JS) */
  .ab-player{position:relative;display:flex;flex-direction:column;min-width:0;min-height:var(--ab-h);padding:clamp(24px,2.6vw,42px);border-radius:18px;background:var(--s3-tile)}
  .ab-rail,.ab-ctl{display:none}
  .ab-stage{position:relative;display:grid}
  .ab-panel{position:relative;display:grid;grid-template-columns:44px minmax(0,1fr);column-gap:16px;padding-bottom:30px}
  .ab-panel:last-child{padding-bottom:0}
  .ab-panel:not(:last-child)::before{content:'';position:absolute;left:21px;top:54px;bottom:8px;width:2px;border-radius:2px;background:var(--ab-line);transition:background .8s ease}
  .ab-panel.is-past::before{background:color-mix(in srgb,var(--acc) 60%,transparent)}
  .ab-pg{grid-column:1;grid-row:1 / span 2}
  .ab-num{grid-column:2;display:block;margin:2px 0 8px;padding-bottom:.06em;font-family:var(--fd);font-style:italic;font-weight:400;font-size:32px;line-height:1;letter-spacing:-.01em;background:linear-gradient(110deg,var(--ac) 0%,#7BAEFF 40%,var(--ac2) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  html.light .ab-num{background:linear-gradient(110deg,var(--am) 0%,var(--am-lite) 40%,var(--am2) 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .ab-tx{grid-column:2;margin:0;font-family:var(--fu);font-size:15.5px;font-weight:500;line-height:1.7;color:var(--wd)}
  .ab-lead{font-weight:700;color:var(--w)}

  /* glyph tile (rail node + mobile timeline) */
  .ab-g{display:grid;place-items:center;width:44px;height:44px;border-radius:13px;background:var(--ab-node);color:var(--wm);transition:background .6s ease,color .6s ease,transform .6s cubic-bezier(.16,1,.3,1)}
  .ab-g svg{width:28px;height:28px;overflow:visible}
  .ab .is-past .ab-g{color:var(--wd)}
  .ab .is-on .ab-g{color:var(--acc);background:color-mix(in srgb,var(--acc) 13%,var(--ab-node))}

  /* motion glyphs: drawn and still by default, animate only on the active chapter */
  .ab-g :global(.ag-m){stroke:var(--wm)}
  .ab-g :global(.ag-mf){fill:var(--wm);stroke:none}
  :global(.ag2-o){stroke:var(--wm)}
  :global(.ag3-cur),:global(.ag4-o),:global(.ag4-pin),:global(.ag5-d){fill:currentColor;stroke:none}
  :global(.ag3-rp),:global(.ag4-ring),:global(.ag6-ring){opacity:0}
  :global(.ag1-a){stroke-dasharray:7}:global(.ag1-b){stroke-dasharray:13}
  :global(.ag2-t){stroke-dasharray:13}:global(.ag2-o){stroke-dasharray:19}
  :global(.ag3-q){stroke-dasharray:17}
  :global(.ag4-arc){stroke-dasharray:46}
  :global(.ag1-h),:global(.ag3-rp),:global(.ag4-pin),:global(.ag4-ring),:global(.ag5-d),:global(.ag6-ring){transform-box:fill-box;transform-origin:center}
  :global(.ag3-cur){transform-box:fill-box;transform-origin:0 0}
  :global(.ag6-pin){transform-box:fill-box;transform-origin:50% 100%}
  .ab .is-on :global(.ag1-h){animation:ag1H 3.6s ease-in-out infinite}
  .ab .is-on :global(.ag1-a){animation:ag1A 3.6s ease-in-out infinite}
  .ab .is-on :global(.ag1-b){animation:ag1B 3.6s ease-in-out infinite}
  .ab .is-on :global(.ag2-t){animation:ag2T 4s infinite}
  .ab .is-on :global(.ag2-c){animation:ag2C 4s infinite,agBlink 1s steps(1,end) infinite}
  .ab .is-on :global(.ag2-o){animation:ag2O 4s ease-in-out infinite}
  .ab .is-on :global(.ag3-q){animation:ag3Q 4.2s infinite}
  .ab .is-on :global(.ag3-r){animation:ag3R 4.2s ease-in-out infinite}
  .ab .is-on :global(.ag3-cur){animation:ag3Cur 4.2s cubic-bezier(.45,0,.2,1) infinite}
  .ab .is-on :global(.ag3-rp){animation:ag3Rp 4.2s ease-out infinite}
  .ab .is-on :global(.ag4-arc){animation:ag4Arc 4.2s ease-in-out infinite}
  .ab .is-on :global(.ag4-pin){animation:ag4Pin 4.2s ease-in-out infinite}
  .ab .is-on :global(.ag4-ring){animation:ag4Ring 4.2s ease-out infinite}
  .ab .is-on :global(.ag5-a){animation:ag5A 4s cubic-bezier(.65,0,.35,1) infinite}
  .ab .is-on :global(.ag5-b){animation:ag5B 4s cubic-bezier(.65,0,.35,1) infinite}
  .ab .is-on :global(.ag5-c){animation:ag5C 4s cubic-bezier(.65,0,.35,1) infinite}
  .ab .is-on :global(.ag5-d){animation:ag5D 4s ease-in-out infinite}
  .ab .is-on :global(.ag6-pin){animation:ag6Pin 3.8s infinite}
  .ab .is-on :global(.ag6-ring){animation:ag6Ring 3.8s ease-out infinite}
  .ab:not(.is-live) .ab-g :global(*){animation-play-state:paused}
  @keyframes ag1H{0%,32%,100%{transform:rotate(0)}4%{transform:rotate(-10deg)}8%{transform:rotate(9deg)}12%{transform:rotate(-8deg)}16%{transform:rotate(6deg)}20%{transform:rotate(-4deg)}25%{transform:rotate(2deg)}}
  @keyframes ag1A{0%,6%{stroke-dashoffset:7;opacity:0}8%{opacity:1}20%,80%{stroke-dashoffset:0;opacity:1}92%,100%{stroke-dashoffset:0;opacity:0}}
  @keyframes ag1B{0%,14%{stroke-dashoffset:13;opacity:0}16%{opacity:1}30%,80%{stroke-dashoffset:0;opacity:1}92%,100%{stroke-dashoffset:0;opacity:0}}
  @keyframes ag2T{0%,8%{stroke-dashoffset:13;animation-timing-function:steps(6,end)}36%,84%{stroke-dashoffset:0}94%,100%{stroke-dashoffset:13}}
  @keyframes ag2C{0%,8%{transform:translateX(-13px);animation-timing-function:steps(6,end)}36%,84%{transform:translateX(0)}94%,100%{transform:translateX(-13px)}}
  @keyframes agBlink{0%{opacity:1}50%{opacity:0}}
  @keyframes ag2O{0%,40%{stroke-dashoffset:19;opacity:0}42%{opacity:1}58%,84%{stroke-dashoffset:0;opacity:1}94%,100%{stroke-dashoffset:19;opacity:0}}
  @keyframes ag3Q{0%,4%{stroke-dashoffset:17;animation-timing-function:steps(6,end)}26%,86%{stroke-dashoffset:0}96%,100%{stroke-dashoffset:17}}
