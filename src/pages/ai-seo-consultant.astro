  @keyframes ag3Cur{0%,24%{opacity:0;transform:translate(9px,9px) scale(1)}30%{opacity:1;transform:translate(9px,9px) scale(1)}46%{transform:translate(0,0) scale(1)}50%{transform:translate(0,0) scale(.86)}55%{transform:translate(0,0) scale(1)}84%{opacity:1;transform:translate(0,0) scale(1)}94%,100%{opacity:0;transform:translate(0,0) scale(1)}}
  @keyframes ag3Rp{0%,49%{opacity:0;transform:scale(.3)}51%{opacity:.9;transform:scale(.45)}70%,100%{opacity:0;transform:scale(1.6)}}
  @keyframes ag4Arc{0%,6%{stroke-dashoffset:46;opacity:1}44%,84%{stroke-dashoffset:0;opacity:1}94%{stroke-dashoffset:0;opacity:0}100%{stroke-dashoffset:46;opacity:0}}
  @keyframes ag4Pin{0%,42%{transform:scale(0)}50%{transform:scale(1.35)}56%,84%{transform:scale(1)}94%,100%{transform:scale(0)}}
  @keyframes ag4Ring{0%,50%{opacity:0;transform:scale(1)}53%{opacity:.85;transform:scale(1.1)}76%,100%{opacity:0;transform:scale(2.7)}}
  @keyframes ag5A{0%,6%{transform:translate(-4.5px,-3px);opacity:.45}38%,82%{transform:translate(0,0);opacity:1}96%,100%{transform:translate(-4.5px,-3px);opacity:.45}}
  @keyframes ag5B{0%,6%{transform:translate(4.5px,-3px);opacity:.45}38%,82%{transform:translate(0,0);opacity:1}96%,100%{transform:translate(4.5px,-3px);opacity:.45}}
  @keyframes ag5C{0%,6%{transform:translate(0,5px);opacity:.45}38%,82%{transform:translate(0,0);opacity:1}96%,100%{transform:translate(0,5px);opacity:.45}}
  @keyframes ag5D{0%,38%{transform:scale(0)}46%{transform:scale(1.4)}52%,82%{transform:scale(1)}92%,100%{transform:scale(0)}}
