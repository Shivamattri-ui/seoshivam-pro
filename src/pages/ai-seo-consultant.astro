  @keyframes ag6Ring{0%,26%{opacity:0;transform:scale(.6)}29%{opacity:.85}58%,100%{opacity:0;transform:scale(2.1)}}

  /* desktop player: glyph rail with progress line, one chapter at a time, timer + controls */
  @media(min-width:981px){
    html.js .ab-rail{position:relative;display:flex;justify-content:space-between;align-items:flex-start}
    .ab-track{position:absolute;left:32px;right:32px;top:31px;height:2px;border-radius:2px;background:var(--ab-line);overflow:hidden}
    .ab-fill{position:absolute;inset:0;background:linear-gradient(90deg,color-mix(in srgb,var(--acc) 30%,transparent),var(--acc));transform-origin:left center;transform:scaleX(var(--p,0));transition:transform 1.1s cubic-bezier(.16,1,.3,1)}
    .ab-node{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:10px;margin:0;padding:0;border:0;background:none;font:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}
    .ab-node .ab-g{width:64px;height:64px;border-radius:18px}
    .ab-node .ab-g svg{width:40px;height:40px}
    .ab-node:hover .ab-g{transform:translateY(-3px)}
    .ab-node:not(.is-on):hover .ab-g{color:var(--wd)}
    .ab-node:focus-visible{outline:none}
    .ab-node:focus-visible .ab-g{outline:2px solid var(--acc);outline-offset:3px}
    .ab-nn{font-family:var(--fm);font-size:10.5px;font-weight:500;letter-spacing:.16em;color:var(--wm);transition:color .6s ease}
    .ab-node.is-past .ab-nn{color:var(--wd)}
    .ab-node.is-on .ab-nn{color:var(--acc)}
    html.js .ab-stage{flex:1;margin-top:clamp(28px,3.6vh,44px);touch-action:pan-y}
    html.js .ab-panel{grid-area:1/1;display:block;padding:0;opacity:0;transform:translateY(12px);pointer-events:none;transition:opacity .55s ease,transform .8s cubic-bezier(.16,1,.3,1)}
    html.js .ab-panel.is-on{opacity:1;transform:none;pointer-events:auto;transition-delay:.12s}
    html.js .ab-panel::before{content:none}
    html.js .ab-pg{display:none}
    html.js .ab-num{font-size:clamp(48px,4.4vw,68px);margin:0 0 16px}
    html.js .ab-tx{font-size:clamp(18px,1.5vw,22.5px);line-height:1.62;letter-spacing:-.01em;max-width:38em}
    html.js .ab-ctl{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:22px}
    .ab-count{display:flex;align-items:center;gap:16px;font-family:var(--fm);font-size:11.5px;font-weight:500;letter-spacing:.16em;color:var(--wm)}
    .ab-count b{font-weight:500;color:var(--w)}
    .ab-time{position:relative;width:72px;height:2px;border-radius:2px;background:var(--ab-line);overflow:hidden;transition:opacity .6s ease}
    .ab-time i{position:absolute;inset:0;background:var(--acc);transform-origin:left center;transform:scaleX(0)}
    .ab.is-manual .ab-time{opacity:0}
    .ab-btns{display:flex;gap:10px}
    .ab-btn{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;margin:0;padding:0;border:0;cursor:pointer;color:var(--wd);background:var(--ab-node);transition:color .5s ease,background .5s ease}
    .ab-btn svg{width:18px;height:18px}
    .ab-btn:hover{color:var(--acc);background:color-mix(in srgb,var(--acc) 13%,var(--ab-node))}
    .ab-btn:focus-visible{outline:2px solid var(--acc);outline-offset:3px}
  }

  @media(prefers-reduced-motion:reduce){.ab .ab-g :global(*){animation:none!important}.s3-img,.s3-soc,.ab-g,.ab-fill,.ab-panel{transition:none!important}}
  @media(min-width:981px) and (max-width:1200px){.ab{grid-template-columns:calc(var(--ab-h) * .66) minmax(0,1fr)}}
  @media(max-width:980px){
    .ab{grid-template-columns:1fr}
    .ab-photo{width:100%;max-width:440px;height:auto;margin:0 auto;aspect-ratio:1/1}
    .ab-player{min-height:0}
  }
  @media(max-width:640px){
    .s3-head{flex-direction:column;align-items:flex-start;gap:12px}
    .s3-sub{text-align:left;max-width:none}
    .s3-frame{padding:20px 16px}
    .ab-player{padding:8px 0 0;background:none}
    .ab-panel{grid-template-columns:40px minmax(0,1fr);column-gap:14px}
    .ab-pg .ab-g{width:40px;height:40px;border-radius:12px}
    .ab-pg .ab-g svg{width:26px;height:26px}
    .ab-panel:not(:last-child)::before{left:19px;top:50px}
  }

  /* ============ 4-10 · shared system: same tile, accent and frame language as About ============ */
  :root{--x-panel:#121219;--x-panel-h:#17171f;--x-sk:rgba(255,255,255,.07);--x-sk2:rgba(255,255,255,.13);--x-tile:#F3F0EA;--x-tile2:#F3F0EA;--x-ink:#17191E;--x-rule:linear-gradient(90deg,transparent,rgba(255,255,255,.1) 14%,rgba(255,255,255,.1) 86%,transparent);--x-lift:none}
  html.light{--x-panel:#ffffff;--x-panel-h:#fcfaf6;--x-sk:rgba(26,23,20,.06);--x-sk2:rgba(26,23,20,.11);--x-tile:#ffffff;--x-tile2:#F1ECE3;--x-rule:linear-gradient(90deg,transparent,rgba(26,23,20,.13) 14%,rgba(26,23,20,.13) 86%,transparent);--x-lift:0 1px 2px rgba(26,23,20,.05),0 10px 26px rgba(26,23,20,.06)}
  .xs{position:relative;padding:clamp(48px,6vw,96px) clamp(16px,3vw,40px)}
  .xw{max-width:1440px;margin:0 auto;padding:0 clamp(20px,2.4vw,40px)}
  .xf{position:relative;max-width:1440px;margin:0 auto;padding:clamp(26px,3.2vw,56px) clamp(20px,2.8vw,48px);border-radius:28px;border:1px solid var(--bd);background:var(--s3-frame-bg);overflow:hidden}
  .xf::before{content:'';position:absolute;inset:0;z-index:0;background-image:linear-gradient(to right,var(--s3-grid-line) 1px,transparent 1px),linear-gradient(to bottom,var(--s3-grid-line) 1px,transparent 1px);background-size:46px 46px;-webkit-mask:radial-gradient(135% 100% at 50% 0%,#000 30%,transparent 80%);mask:radial-gradient(135% 100% at 50% 0%,#000 30%,transparent 80%);pointer-events:none}
  .xf>*{position:relative;z-index:1}

  .xh{display:flex;justify-content:space-between;align-items:flex-end;gap:clamp(20px,4vw,72px);margin-bottom:clamp(32px,4vw,56px)}
  .xh-l{min-width:0}
  .xh-eye{color:var(--acc)}
  .xh-eye::before{background:linear-gradient(90deg,transparent 0%,var(--acc) 100%)}
  .xh-eye:hover::before{background:linear-gradient(90deg,transparent 0%,var(--acc) 60%,var(--acc-lite) 100%)}
  html.light .xh-eye{color:var(--acc)}
  html.light .xh-eye::before{background:linear-gradient(90deg,transparent 0%,var(--acc) 100%)}
  .xh-t{margin:16px 0 0;font-size:clamp(33px,4vw,56px);line-height:1.02;letter-spacing:-.028em}
  .xh-l1{display:block;font-family:var(--fu);font-weight:800;color:var(--w);letter-spacing:-.032em}
  .xh-l2{display:block;margin-top:.05em;padding-bottom:.08em;font-family:var(--fd);font-style:italic;font-weight:400;letter-spacing:-.01em;background:linear-gradient(110deg,var(--ac) 0%,#7BAEFF 25%,var(--ac2) 50%,#7BAEFF 75%,var(--ac) 100%);background-size:300% 100%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  html.light .xh-l2{background:linear-gradient(110deg,var(--am) 0%,var(--am-lite) 25%,var(--am2) 50%,var(--am-lite) 75%,var(--am) 100%);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .xh-sub{flex:0 1 auto;max-width:420px;margin:0 0 8px;font-family:var(--fu);font-size:clamp(14.5px,1.1vw,16.5px);line-height:1.68;color:var(--wd)}
  .xh-sub.wide{max-width:560px}
  .xl{display:flex;align-items:center;gap:14px;margin:0 0 18px;font-family:var(--fm);font-size:11px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:var(--wm)}
  .xl::after{content:'';flex:1;height:1px;background:var(--x-rule)}
  .xi{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;flex-shrink:0;background:color-mix(in srgb,var(--acc) 12%,transparent);color:var(--acc);transition:background .5s ease,transform .5s cubic-bezier(.16,1,.3,1)}
  .xi svg{width:21px;height:21px}
  .xt{display:grid;place-items:center;flex-shrink:0;background:var(--x-tile);box-shadow:var(--x-lift)}
  .xt img{object-fit:contain}

  /* 4 · Services */
  .sv-story{display:grid;grid-template-columns:minmax(0,1.04fr) minmax(0,1fr);gap:clamp(36px,5vw,96px);align-items:start}
  .sv-stage-col{align-self:stretch}
  .sv-stage{position:sticky;top:max(96px,calc((100vh - min(560px,100vh - 176px)) / 2));height:min(560px,calc(100vh - 176px));min-height:380px}
  .sv-scene{position:absolute;inset:0;opacity:0;transform:scale(.985);transition:opacity .6s ease,transform .7s cubic-bezier(.16,1,.3,1);pointer-events:none}
  .sv-scene.is-on{opacity:1;transform:none}
  .sv-dots{position:absolute;right:18px;top:18px;z-index:2;display:flex;gap:6px}
  .sv-dot{width:16px;height:3px;border-radius:2px;background:var(--x-sk2);transition:background .45s ease,width .45s ease}
  .sv-dot.is-on{width:30px;background:var(--acc)}
  .sv-list{list-style:none;margin:0;padding:0}
  .sv-item{position:relative;display:grid;grid-template-columns:44px minmax(0,1fr);gap:clamp(14px,1.6vw,24px);align-content:center;min-height:clamp(250px,42vh,380px);padding:clamp(26px,3vh,40px) 0;opacity:.34;transition:opacity .55s ease}
  .sv-item.is-on{opacity:1}
  .sv-item+.sv-item::before{content:'';position:absolute;left:0;right:0;top:0;height:1px;background:var(--x-rule)}
  .sv-num{padding-top:.55em;font-family:var(--fm);font-size:12px;font-weight:500;letter-spacing:.14em;color:var(--acc)}
  .sv-t{margin:0 0 12px;font-family:var(--fu);font-size:clamp(22px,2.1vw,30px);font-weight:800;line-height:1.14;letter-spacing:-.026em;color:var(--w)}
  .sv-d{margin:0;max-width:540px;font-family:var(--fu);font-size:clamp(15px,1.1vw,16.5px);line-height:1.72;color:var(--wd)}
  .sv-inline{display:none}
  .sv-reach{margin-top:clamp(56px,7vw,104px)}
  .sv-reach-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(24px,3.4vw,56px)}
  .sv-r{display:flex;flex-direction:column;gap:14px}
  .sv-r:hover .xi{transform:translateY(-3px);background:color-mix(in srgb,var(--acc) 20%,transparent)}
  .sv-rt{margin:4px 0 0;font-family:var(--fu);font-size:clamp(18px,1.4vw,20px);font-weight:700;line-height:1.25;letter-spacing:-.018em;color:var(--w)}
  .sv-rd{margin:0;font-family:var(--fu);font-size:15px;line-height:1.7;color:var(--wd)}
  .sv-plat{margin-top:clamp(52px,6vw,88px)}
  .sv-plat-row{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:clamp(18px,3vw,48px)}
  .sv-pl{display:flex;align-items:center;gap:14px}
  .sv-pl .xt{width:58px;height:58px;border-radius:16px;transition:transform .5s cubic-bezier(.16,1,.3,1)}
  .sv-pl .xt img{width:30px;height:30px}
  .sv-pl .xt svg{width:28px;height:28px;color:var(--x-ink)}
  .sv-pl:hover .xt{transform:translateY(-4px) rotate(-4deg)}
  .sv-pl-n{font-family:var(--fu);font-size:15.5px;font-weight:600;letter-spacing:-.01em;color:var(--w)}

  /* 5 · Proof */
  .pv{display:grid;grid-template-columns:minmax(250px,.38fr) minmax(0,1fr);gap:clamp(18px,2.4vw,36px);align-items:start}
  .pv-tabs{display:flex;flex-direction:column;gap:6px}
  .pv-grp{margin:16px 0 6px 4px;font-family:var(--fm);font-size:10.5px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:var(--wm)}
  .pv-grp:first-child{margin-top:0}
  .pv-tab{display:flex;flex-direction:column;align-items:flex-start;gap:6px;width:100%;padding:16px 18px;border:0;border-radius:16px;background:transparent;text-align:left;cursor:pointer;transition:background .45s ease}
  .pv-tab:hover{background:color-mix(in srgb,var(--s3-tile) 60%,transparent)}
  .pv-tab.is-on{background:var(--s3-tile)}
  .pv-tab:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
  .pv-tn{font-family:var(--fu);font-size:15.5px;font-weight:700;letter-spacing:-.012em;color:var(--w)}
  .pv-tk{display:flex;align-items:center;gap:8px;font-family:var(--fu);font-size:13.5px;color:var(--wd)}
  .pv-tk::before{content:'';width:6px;height:6px;border-radius:50%;flex-shrink:0;background:var(--wm);transition:background .4s ease}
  .pv-tab.is-on .pv-tk::before{background:var(--acc)}
  .pv-stage{display:grid}
  .pv-panel{grid-area:1/1;align-self:stretch;display:flex;flex-direction:column;visibility:hidden;opacity:0;transform:translateY(10px);padding:clamp(20px,2.4vw,34px);border-radius:22px;background:var(--s3-tile);transition:opacity .5s ease,transform .6s cubic-bezier(.16,1,.3,1),visibility 0s .5s}
  .pv-panel.is-on{visibility:visible;opacity:1;transform:none;transition:opacity .5s ease,transform .6s cubic-bezier(.16,1,.3,1),visibility 0s}
  .pv-ph{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:22px}
  .pv-k{font-family:var(--fm);font-size:10.5px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:var(--acc)}
  .pv-h{margin:8px 0 0;font-family:var(--fu);font-size:clamp(20px,1.9vw,27px);font-weight:800;line-height:1.15;letter-spacing:-.024em;color:var(--w)}
  .pv-sub{margin:6px 0 0;font-family:var(--fu);font-size:14.5px;color:var(--wd)}
  .pv-per{flex-shrink:0;padding-top:4px;font-family:var(--fm);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--wd)}
  .pv-shot{margin:0}
  .pv-shot img{display:block;width:100%;height:auto;border-radius:14px}
  @media(min-width:901px){.pv-shot img.pv-hero-img{height:clamp(300px,29vw,420px);object-fit:cover;object-position:center bottom}}
  .pv-shot figcaption{margin-top:10px;font-family:var(--fm);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--wd)}
  .pv-pair{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:auto;padding-top:18px}
  .pv-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}
  .pv-st{padding:16px 18px;border-radius:14px;background:var(--x-sk)}
  .pv-v{display:block;font-family:var(--fu);font-size:clamp(26px,2.6vw,38px);font-weight:800;line-height:1;letter-spacing:-.03em;color:var(--w);font-variant-numeric:tabular-nums}
  .pv-l{display:block;margin-top:8px;font-family:var(--fu);font-size:13.5px;line-height:1.45;color:var(--wd)}
  .pv-cols{flex:1;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
  .pv-cols-2{grid-template-columns:repeat(2,minmax(0,1fr))}
  .pv-col{display:flex;flex-direction:column;gap:8px;min-width:0}
  .pv-cl{font-family:var(--fu);font-size:13.5px;font-weight:600;color:var(--wd)}
  .pv-cv{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 8px;font-family:var(--fu);font-size:clamp(24px,2.4vw,34px);font-weight:800;line-height:1.05;letter-spacing:-.03em;color:var(--w);font-variant-numeric:tabular-nums}
  .pv-cv .from{font-size:.5em;font-weight:600;letter-spacing:0;color:var(--wm)}
  .pv-ch{display:flex;align-items:flex-end;gap:10px;flex:1;min-height:clamp(170px,18vw,240px);margin-top:8px;padding:14px;border-radius:14px;background:var(--x-sk)}
  .pv-cb{flex:1;height:100%;border-radius:8px;transform:scaleY(var(--bw));transform-origin:bottom;transition:transform 1.3s cubic-bezier(.65,0,.35,1)}
  .pv-cb.b0{background:var(--wm);opacity:.55}
  .pv-cb.b1{background:linear-gradient(180deg,var(--acc-lite),var(--acc));transition-delay:.25s}
  html.js .pv-panel:not(.go) .pv-cb{transform:scaleY(0)}
  .pv-legend{display:flex;gap:18px;margin-top:14px;font-family:var(--fm);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--wm)}
  .pv-legend span{display:flex;align-items:center;gap:7px}
  .pv-legend span::before{content:'';width:12px;height:4px;border-radius:2px;background:var(--wm)}
  .pv-legend span.a::before{background:var(--acc)}
  .pv-col-s{justify-content:center;padding:clamp(18px,2vw,28px);border-radius:14px;background:var(--x-sk)}
  .pv-big{font-family:var(--fu);font-size:clamp(48px,5.4vw,80px);font-weight:800;line-height:1;letter-spacing:-.04em;color:var(--w);font-variant-numeric:tabular-nums}
  .pv-cap{font-family:var(--fu);font-size:14.5px;line-height:1.5;color:var(--wd)}
  .pv-facts{list-style:none;margin:16px 0 0;padding:0;display:flex;flex-direction:column;gap:10px}
  .pv-facts li{display:flex;align-items:center;gap:10px;font-family:var(--fu);font-size:15px;font-weight:600;color:var(--w)}
  .pv-facts svg{width:16px;height:16px;flex-shrink:0;color:var(--acc)}

  /* 6 · How I work */
  .hw{display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);gap:clamp(36px,6vw,112px);align-items:start}
  .hw-l{position:sticky;top:clamp(96px,14vh,136px)}
  .hw-l.rv,.fq-l.rv{transform:none}
  .hw-l .xh-t{font-size:clamp(32px,3.5vw,50px)}
  .hw-intro{margin:26px 0 0;max-width:470px;font-family:var(--fu);font-size:clamp(15px,1.15vw,17px);line-height:1.75;color:var(--wd)}
  .hw-list{list-style:none;margin:0;padding:0}
  .hw-row{position:relative;display:grid;grid-template-columns:72px minmax(0,1fr);gap:clamp(18px,2vw,28px);padding:clamp(28px,3.4vw,40px) 0}
  .hw-row:first-child{padding-top:0}
  .hw-row+.hw-row::before{content:'';position:absolute;left:0;right:0;top:0;height:1px;background:var(--x-rule)}
  .hw-g{width:72px;height:72px;border-radius:20px;display:grid;place-items:center;background:var(--x-panel);box-shadow:var(--x-lift);color:var(--acc);transition:transform .5s cubic-bezier(.16,1,.3,1),background .5s ease}
  .hw-g svg{width:46px;height:46px;overflow:visible}
  .hw-row:hover .hw-g{transform:translateY(-3px);background:var(--x-panel-h)}
  .hw-n{font-family:var(--fm);font-size:11.5px;font-weight:500;letter-spacing:.18em;color:var(--acc)}
  .hw-t{margin:8px 0 12px;font-family:var(--fu);font-size:clamp(20px,1.75vw,25px);font-weight:800;line-height:1.2;letter-spacing:-.022em;color:var(--w)}
  .hw-d{margin:0;font-family:var(--fu);font-size:clamp(14.5px,1.05vw,16px);line-height:1.76;color:var(--wd)}
  .hw-g .hg-m{stroke:var(--wm)}
  .hg-l1{stroke-dasharray:14;animation:hgL1 4s ease-in-out infinite}
  .hg-l2{stroke-dasharray:21;animation:hgL2 4s ease-in-out infinite}
  .hg-l3{stroke-dasharray:9;animation:hgL3 4s ease-in-out infinite}
  .hg-ok{stroke-dasharray:14;animation:hgOk 4s ease-in-out infinite}
  .hg-e1,.hg-e2,.hg-e3,.hg-e4{stroke-dasharray:20}
  .hg-e1{animation:hgE1 4.4s ease-in-out infinite}
  .hg-e2{animation:hgE2 4.4s ease-in-out infinite}
  .hg-e3{animation:hgE3 4.4s ease-in-out infinite}
  .hg-e4{animation:hgE4 4.4s ease-in-out infinite}
  .hg-nb{fill:var(--x-panel);stroke:var(--wm)}
  .hg-n1,.hg-n2,.hg-n3,.hg-n4{fill:none}
  .hg-n1{animation:hgN1 4.4s ease-in-out infinite}
  .hg-n2{animation:hgN2 4.4s ease-in-out infinite}
  .hg-n3{animation:hgN3 4.4s ease-in-out infinite}
  .hg-n4{animation:hgN4 4.4s ease-in-out infinite}
  .hg-c{fill:currentColor;stroke:none}
  .hg-up{stroke-dasharray:44;animation:hgUp 4s ease-in-out infinite}
  .hg-dot{fill:currentColor;stroke:none;transform-box:fill-box;transform-origin:center;animation:hgDot 4s ease-in-out infinite}
  .hg-day{font-family:var(--fm);font-size:8px;font-weight:600;letter-spacing:.04em;fill:var(--wm);stroke:none}
  .hg-wed{fill:currentColor;animation:hgWed 3.8s ease-in-out infinite}
  .hg-run{fill:currentColor;stroke:none;transform:translateX(30px);animation:hgRun 3.8s cubic-bezier(.65,0,.35,1) infinite}
  .hg-done{stroke-dasharray:12;animation:hgDone 3.8s ease-in-out infinite}
  @keyframes hgL1{0%{stroke-dashoffset:14}15%,86%{stroke-dashoffset:0}96%,100%{stroke-dashoffset:14}}
  @keyframes hgL2{0%,12%{stroke-dashoffset:21}30%,86%{stroke-dashoffset:0}96%,100%{stroke-dashoffset:21}}
  @keyframes hgL3{0%,27%{stroke-dashoffset:9}40%,86%{stroke-dashoffset:0}96%,100%{stroke-dashoffset:9}}
  @keyframes hgOk{0%,44%{stroke-dashoffset:14;opacity:0}46%{opacity:1}58%,86%{stroke-dashoffset:0;opacity:1}96%,100%{stroke-dashoffset:14;opacity:0}}
  @keyframes hgE1{0%{stroke-dashoffset:20}18%,86%{stroke-dashoffset:0}96%,100%{stroke-dashoffset:20}}
  @keyframes hgE2{0%,14%{stroke-dashoffset:20}32%,86%{stroke-dashoffset:0}96%,100%{stroke-dashoffset:20}}
  @keyframes hgE3{0%,28%{stroke-dashoffset:20}46%,86%{stroke-dashoffset:0}96%,100%{stroke-dashoffset:20}}
  @keyframes hgE4{0%,42%{stroke-dashoffset:20}60%,86%{stroke-dashoffset:0}96%,100%{stroke-dashoffset:20}}
  @keyframes hgN1{0%,16%{opacity:0}20%,86%{opacity:1}96%,100%{opacity:0}}
  @keyframes hgN2{0%,30%{opacity:0}34%,86%{opacity:1}96%,100%{opacity:0}}
  @keyframes hgN3{0%,44%{opacity:0}48%,86%{opacity:1}96%,100%{opacity:0}}
  @keyframes hgN4{0%,58%{opacity:0}62%,86%{opacity:1}96%,100%{opacity:0}}
  @keyframes hgUp{0%{stroke-dashoffset:44}45%,86%{stroke-dashoffset:0}96%,100%{stroke-dashoffset:44}}
  @keyframes hgDot{0%,42%{opacity:0;transform:scale(.3)}50%{opacity:1;transform:scale(1.3)}56%,86%{opacity:1;transform:scale(1)}96%,100%{opacity:0;transform:scale(.3)}}
  @keyframes hgWed{0%,55%{fill:var(--wm)}62%,86%{fill:currentColor}96%,100%{fill:var(--wm)}}
  @keyframes hgRun{0%{transform:translateX(0);opacity:0}8%{transform:translateX(0);opacity:1}55%{transform:translateX(30px);opacity:1}88%{transform:translateX(30px);opacity:1}94%{transform:translateX(30px);opacity:0}100%{transform:translateX(0);opacity:0}}
  @keyframes hgDone{0%,56%{stroke-dashoffset:12;opacity:0}58%{opacity:1}70%,86%{stroke-dashoffset:0;opacity:1}96%,100%{stroke-dashoffset:12;opacity:0}}
  .hw:not(.is-live) .hw-g *{animation-play-state:paused}

  /* 7 · Engines */
  .eg{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:clamp(28px,4vw,72px);align-items:center}
  .eg-map{position:relative;width:100%;max-width:540px;aspect-ratio:1;margin:0 auto}
  .eg-svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
  .eg-orbit{fill:none;stroke:var(--x-sk2);stroke-width:.25;stroke-dasharray:.5 1.5}
  .eg-ln{stroke:var(--x-sk2);stroke-width:.35}
  .eg-fl{stroke:var(--acc);stroke-width:.45;stroke-linecap:round;stroke-dasharray:1.4 4.6;opacity:.32;animation:egFlow 1.6s linear infinite;transition:opacity .4s ease,stroke-width .4s ease}
  .eg-fl.is-hot{opacity:1;stroke-width:.75}
  @keyframes egFlow{to{stroke-dashoffset:-6}}
  .eg-core{position:absolute;left:50%;top:50%;width:25%;aspect-ratio:1;transform:translate(-50%,-50%);border-radius:50%;display:grid;place-items:center;text-align:center;background:var(--s3-tile);box-shadow:inset 0 0 0 1.5px color-mix(in srgb,var(--acc) 55%,transparent)}
  .eg-core::before,.eg-core::after{content:'';position:absolute;inset:0;border-radius:50%;border:1.5px solid var(--acc);opacity:0;animation:egPulse 2.8s cubic-bezier(.16,1,.3,1) infinite}
  .eg-core::after{animation-delay:1.4s}
  @keyframes egPulse{0%{transform:scale(1);opacity:.55}100%{transform:scale(1.85);opacity:0}}
  .eg-core span{position:relative;padding:0 8px;font-family:var(--fu);font-size:clamp(11px,1.15vw,15px);font-weight:800;line-height:1.15;letter-spacing:-.01em;color:var(--w)}
  .eg-node{position:absolute;left:var(--x);top:var(--y);width:15%;aspect-ratio:1;transform:translate(-50%,-50%);border-radius:28%;display:grid;place-items:center;background:var(--x-tile);box-shadow:var(--x-lift);transition:transform .5s cubic-bezier(.34,1.56,.64,1),box-shadow .5s ease}
  .eg-node img{width:54%;height:54%;object-fit:contain}
  .eg-node.is-hot{transform:translate(-50%,-50%) scale(1.14);box-shadow:0 0 0 3px color-mix(in srgb,var(--acc) 70%,transparent)}
  .eg:not(.is-live) .eg-fl,.eg:not(.is-live) .eg-core::before,.eg:not(.is-live) .eg-core::after{animation-play-state:paused}
  .eg-list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:6px}
  .eg-it{display:grid;grid-template-columns:38px minmax(0,1fr);gap:14px;align-items:start;padding:16px;border-radius:16px;transition:background .45s ease}
  .eg-it.is-hot{background:var(--s3-tile)}
  .eg-it .xt{width:38px;height:38px;border-radius:11px}
  .eg-it .xt img{width:20px;height:20px}
  .eg-n{display:block;font-family:var(--fu);font-size:15.5px;font-weight:700;letter-spacing:-.012em;color:var(--w)}
  .eg-d{display:block;margin-top:5px;font-family:var(--fu);font-size:13.5px;line-height:1.55;color:var(--wd)}

  /* 8 · Industries */
  .ix-row{position:relative;display:grid;grid-template-columns:minmax(200px,.3fr) minmax(0,1fr);gap:clamp(20px,3.4vw,56px);padding:clamp(28px,3.4vw,44px) 0}
  .ix-row::before{content:'';position:absolute;left:0;right:0;top:0;height:1px;background:var(--x-rule)}
  .ix-lb{display:flex;flex-direction:column;gap:10px}
  .ix-n{font-family:var(--fm);font-size:11.5px;letter-spacing:.18em;color:var(--acc)}
  .ix-t{margin:0;font-family:var(--fu);font-size:clamp(18px,1.5vw,21px);font-weight:700;line-height:1.25;letter-spacing:-.018em;color:var(--w)}
  .ix-items{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;row-gap:.14em;font-family:var(--fd);font-size:clamp(25px,2.7vw,40px);line-height:1.22;letter-spacing:-.012em;color:var(--w)}
  .ix-it{display:inline-flex;align-items:center;transition:color .35s ease}
  .ix-it:not(:last-child)::after{content:'';display:inline-block;width:.17em;height:.17em;margin:0 .42em;border-radius:50%;background:var(--acc);opacity:.75}
  .ix-it:hover{color:var(--acc)}
  html.js .ix-row .ix-it{opacity:0;transform:translateY(12px)}
  html.js .ix-row.in .ix-it{opacity:1;transform:none;transition:opacity .6s ease calc(var(--i) * 55ms),transform .7s cubic-bezier(.16,1,.3,1) calc(var(--i) * 55ms),color .35s ease}
  .ix-cap{margin:16px 0 0;font-family:var(--fu);font-size:15px;line-height:1.65;color:var(--wd)}

  /* 9 · Engagement */
  .ep{position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(16px,1.8vw,26px);padding-top:66px}
  .ep-track{position:absolute;top:21px;left:calc(100% / 6);right:calc(100% / 6);height:2px;border-radius:2px;background:var(--x-sk2);overflow:hidden}
  .ep-fill{position:absolute;inset:0;background:linear-gradient(90deg,var(--acc),var(--acc-lite));transform:scaleX(0);transform-origin:left;transition:transform 1.8s cubic-bezier(.65,0,.35,1) .2s}
  .ep.in .ep-fill{transform:scaleX(1)}
  .ep-step{position:relative;display:flex;flex-direction:column}
  .ep-node{position:absolute;top:-66px;left:50%;width:44px;height:44px;border-radius:50%;display:grid;place-items:center;transform:translateX(-50%);font-family:var(--fu);font-size:16px;font-weight:800;color:var(--wd);background:var(--s3-tile);transition:background .5s ease,color .5s ease,transform .5s cubic-bezier(.34,1.56,.64,1)}
  .ep.in .ep-node{background:var(--acc);color:#fff;transform:translateX(-50%) scale(1.06)}
  .ep.in .ep-s1 .ep-node{transition-delay:.25s}
  .ep.in .ep-s2 .ep-node{transition-delay:1.05s}
  .ep.in .ep-s3 .ep-node{transition-delay:1.85s}
  .ep-card{flex:1;display:flex;flex-direction:column;gap:14px;padding:clamp(22px,2.2vw,32px);border-radius:22px;background:var(--s3-tile);transition:transform .5s cubic-bezier(.16,1,.3,1),background .5s ease}
  .ep-card:hover{transform:translateY(-4px);background:var(--s3-tile-h)}
  .ep-s2 .ep-card,.ep-s2 .ep-card:hover{background:var(--s3-dark)}
  .ep-top{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:28px}
  .ep-k{font-family:var(--fm);font-size:11px;font-weight:500;letter-spacing:.22em;text-transform:uppercase;color:var(--acc)}
  .ep-t{margin:2px 0 0;font-family:var(--fd);font-size:clamp(26px,2.3vw,34px);font-weight:400;line-height:1.05;letter-spacing:-.012em;color:var(--w)}
  .ep-d{margin:0;font-family:var(--fu);font-size:14.5px;line-height:1.72;color:var(--wd)}
  .ep-get{position:relative;margin-top:auto;padding-top:16px}
  .ep-get::before{content:'';position:absolute;left:0;right:0;top:0;height:1px;background:var(--x-rule)}
  .ep-gl{display:block;margin-bottom:6px;font-family:var(--fm);font-size:10.5px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:var(--acc)}
  .ep-gt{margin:0;font-family:var(--fu);font-size:14.5px;line-height:1.65;color:var(--w)}
  .ep-s2 .ep-t,.ep-s2 .ep-gt{color:#F5F2EC}
  .ep-s2 .ep-d{color:var(--s3-dark-tx)}
  .ep-s2 .ep-k,.ep-s2 .ep-gl{color:#7BAEFF}
  html.light .ep-s2 .ep-k,html.light .ep-s2 .ep-gl{color:#F6B863}
  .ep-s2 .ep-get::before{background:linear-gradient(90deg,transparent,rgba(255,255,255,.14) 14%,rgba(255,255,255,.14) 86%,transparent)}
  .ep-badge{position:relative;display:inline-flex;align-items:center;gap:8px;padding:6px 11px;border-radius:8px;overflow:hidden;font-family:var(--fm);font-size:10px;font-weight:500;letter-spacing:.16em;text-transform:uppercase}
  .ep-badge.start{color:var(--acc);background:color-mix(in srgb,var(--acc) 12%,transparent)}
  .ep-badge.start i{display:block;width:7px;height:7px;border-radius:50%;background:var(--acc);animation:epPing 2s ease-out infinite}
  @keyframes epPing{0%{box-shadow:0 0 0 0 color-mix(in srgb,var(--acc) 55%,transparent)}100%{box-shadow:0 0 0 9px transparent}}
  .ep-badge.pop{color:#fff;background:linear-gradient(110deg,var(--ac),#7BAEFF)}
  html.light .ep-badge.pop{background:linear-gradient(110deg,var(--am2),var(--am))}
  .ep-badge.pop svg{width:12px;height:12px}
  .ep-badge.pop::after{content:'';position:absolute;top:0;bottom:0;left:-60%;width:40%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.45),transparent);animation:epSheen 3.4s ease-in-out infinite}
  @keyframes epSheen{0%,55%{left:-60%}85%,100%{left:120%}}
  .xf[data-live]:not(.is-live) .ep-badge.start i,.xf[data-live]:not(.is-live) .ep-badge.pop::after{animation-play-state:paused}

  /* 10 · FAQ (page override of the global accordion: borderless tiles) */
  .fq{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(32px,6vw,104px);align-items:start}
  .fq-l{position:sticky;top:clamp(96px,14vh,136px)}
  .fq .faq-list .faq-item{border-color:transparent;border-radius:16px;background:var(--x-panel);transition:background .45s ease}
  .fq .faq-list .faq-item:hover{border-color:transparent;background:var(--x-panel-h)}
  .fq .faq-list .faq-item:has(.faq-btn[aria-expanded="true"]){border-color:transparent;background:color-mix(in srgb,var(--acc) 7%,var(--x-panel))}
  html.light .fq .faq-list .faq-item{background:#fff;box-shadow:var(--x-lift)}
  html.light .fq .faq-list .faq-item:has(.faq-btn[aria-expanded="true"]){border-color:transparent;background:color-mix(in srgb,var(--acc) 6%,#fff)}
  .fq .faq-list .faq-btn{padding:20px 24px;font-size:16px}
  .fq .faq-list .faq-btn:hover,.fq .faq-list .faq-btn[aria-expanded="true"]{color:var(--acc)}
  .fq .faq-list .faq-icon{border-color:transparent;background:var(--x-sk);color:var(--acc)}
  .fq .faq-list .faq-btn[aria-expanded="true"] .faq-icon{border-color:var(--acc);background:var(--acc);color:#fff}
  .fq .faq-list .faq-ans{margin-top:0;padding:16px 24px 22px;border-top-color:var(--x-sk2);font-size:15px}
  .fq .faq-list .faq-ans:not([hidden]){animation:fqIn .45s cubic-bezier(.16,1,.3,1)}
  @keyframes fqIn{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}

  @media(prefers-reduced-motion:reduce){.hw-g *,.eg-fl,.eg-core::before,.eg-core::after,.ep-badge.start i,.ep-badge.pop::after{animation:none!important}}
  @media(max-width:1024px){
    .sv-story{grid-template-columns:1fr}
    .sv-stage-col{display:none}
    .sv-item{min-height:0;opacity:1;padding:30px 0}
    .sv-inline{display:block;margin-top:22px}
    .sv-inline .sv-scene{position:relative;inset:auto;aspect-ratio:4/3.4;opacity:1;transform:none}
    .sv-reach-row{grid-template-columns:1fr;gap:30px}
    .eg{grid-template-columns:1fr}
    .eg-map{max-width:420px}
  }
  @media(max-width:960px){
    .hw,.fq{grid-template-columns:1fr}
    .hw-l,.fq-l{position:static}
  }
  @media(max-width:900px){
    .pv{grid-template-columns:1fr}
    .pv-tabs{flex-direction:row;gap:8px;overflow-x:auto;padding-bottom:4px;scroll-snap-type:x mandatory;scrollbar-width:none}
    .pv-tabs::-webkit-scrollbar{display:none}
    .pv-grp{display:none}
    .pv-tab{flex:0 0 auto;width:auto;max-width:240px;scroll-snap-align:start;background:color-mix(in srgb,var(--s3-tile) 55%,transparent)}
    .pv-panel:not(.is-on){display:none}
    .pv-pair{grid-template-columns:1fr}
    .ep{grid-template-columns:1fr;gap:22px;padding-top:0;padding-left:60px}
    .ep-track{top:22px;bottom:22px;left:21px;right:auto;width:2px;height:auto}
    .ep-fill{transform:scaleY(0);transform-origin:top}
    .ep.in .ep-fill{transform:scaleY(1)}
    .ep-node{top:0;left:-60px;transform:none}
    .ep.in .ep-node{transform:scale(1.06)}
  }
  @media(max-width:860px){
    .xh{flex-direction:column;align-items:flex-start;gap:16px}
    .xh-sub,.xh-sub.wide{max-width:none}
    .ix-row{grid-template-columns:1fr;gap:14px}
  }
  @media(max-width:680px){
    .fq .faq-list .faq-btn{padding:16px 18px;font-size:15px}
    .fq .faq-list .faq-ans{padding:14px 18px 18px}
  }
  @media(max-width:640px){
    .eg-list{grid-template-columns:1fr}
    .eg-map{max-width:330px}
    .pv-cols{grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
    .pv-cols-2{grid-template-columns:1fr}
    .pv-cv{font-size:20px}
    .pv-ch{min-height:150px;padding:10px;gap:6px}
    .hw-row{grid-template-columns:1fr;gap:16px}
    .sv-plat-row{gap:16px 26px}
  }
  </style>

  <script>
  const prog=document.getElementById('scrollProg');
  window.addEventListener('scroll',()=>{if(prog){const s=document.documentElement;prog.style.width=(s.scrollTop/(s.scrollHeight-s.clientHeight)*100)+'%'}},{passive:true});
  // Cursor handled globally by the .bcur system in Nav.astro (legacy loop removed).
  const ro=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');ro.unobserve(e.target)}})},{threshold:0.1,rootMargin:'0px 0px -40px 0px'});
  document.querySelectorAll('.rv').forEach(el=>ro.observe(el));

  // Hero line-2 repeating typewriter. The sentence never leaves the DOM (crawlers and screen
  // readers always get the full H1); typing clips it from the right and moves the caret.
  // When the line cannot fit on one line (phones), it shows whole and wraps instead of typing.
  (function(){
    const t=document.querySelector('.nh-type'), box=document.querySelector('.nh-h1w');
    if(!t||!t.firstChild||!box) return;
    const live=t.parentElement, node=t.firstChild, n=node.length, rg=document.createRange();
    const RM=window.matchMedia && window.matchMedia('(prefers-reduced-motion:reduce)').matches;
    let W=[], i=0, dir=1, still=false;
    const measure=()=>{
      live.classList.remove('is-static');
      W=[0]; for(let k=1;k<=n;k++){ rg.setStart(node,0); rg.setEnd(node,k); W.push(rg.getBoundingClientRect().width); }
      still=W[n]+12>Math.min(box.clientWidth*0.94,1000);
      live.classList.toggle('is-static',still);
    };
    const show=()=>live.style.setProperty('--cut',still?'0px':(W[n]-W[i]).toFixed(1)+'px');
    if(RM){ measure(); window.addEventListener('resize',measure); return; }
    function tick(){
      if(dir>0){
        i++; show();
        if(i>=n){dir=-1;setTimeout(tick,2100);return;}
        setTimeout(tick,62);
      } else {
        i--; show();
        if(i<=0){dir=1;setTimeout(tick,650);return;}
        setTimeout(tick,32);
      }
    }
    measure(); show();
    (document.fonts ? document.fonts.ready : Promise.resolve()).then(()=>{ measure(); show(); setTimeout(tick,780); });
    let rz; window.addEventListener('resize',()=>{ clearTimeout(rz); rz=setTimeout(()=>{ measure(); show(); },150); });
  })();

  document.querySelectorAll('.faq-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const isOpen=btn.getAttribute('aria-expanded')==='true';
      document.querySelectorAll('.faq-btn').forEach(b=>{b.setAttribute('aria-expanded','false');const a=b.closest('.faq-item')?.querySelector('.faq-ans');if(a)a.hidden=true});
      if(!isOpen){btn.setAttribute('aria-expanded','true');const an=btn.closest('.faq-item')?.querySelector('.faq-ans');if(an)an.hidden=false}
    });
  });

  // Sections 4-10: services scroll story, proof viewer, engine signal map, off-screen pausing
  (function(){
    const RM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const liveIO = new IntersectionObserver(es => es.forEach(e => e.target.classList.toggle('is-live', e.isIntersecting)), { threshold: 0 });
    document.querySelectorAll('[data-live]').forEach(el => liveIO.observe(el));

    // Scene stepper: adds .st1 ... .stN, holds, fades out, snaps back, repeats
    function play(sc){
      if (!sc) return;
      const N = +sc.dataset.steps || 4;
      if (RM) { for (let i = 1; i <= N; i++) sc.classList.add('st' + i); return; }
      if (sc._run) return;
      sc._run = true;
      const tick = +sc.dataset.tick || 760, hold = +sc.dataset.hold || 2800;
      let k = 0;
      for (let i = 1; i <= N; i++) if (sc.classList.contains('st' + i)) k = i;
      const step = () => {
        if (!sc._run) return;
        if (k < N) { k++; sc.classList.add('st' + k); sc._t = setTimeout(step, k === N ? hold : tick); return; }
        sc.classList.add('fd');
        sc._t = setTimeout(() => {
          sc.classList.add('sn');
          for (let i = 1; i <= N; i++) sc.classList.remove('st' + i);
          void sc.offsetWidth;
          sc.classList.remove('sn', 'fd');
          k = 0;
          sc._t = setTimeout(step, 520);
        }, 480);
      };
      sc._t = setTimeout(step, 260);
    }
    function stop(sc){ if (!sc) return; sc._run = false; clearTimeout(sc._t); }

    const sv = document.querySelector('.sv');
    if (sv) {
      const desk = window.matchMedia('(min-width: 1025px)');
      const items = [...sv.querySelectorAll('.sv-item')];
      const scenes = [...sv.querySelectorAll('.sv-stage .sv-scene')];
      const dots = [...sv.querySelectorAll('.sv-dot')];
      let cur = 0, live = false;
      const sync = () => {
        items.forEach((el, j) => el.classList.toggle('is-on', j === cur));
        dots.forEach((el, j) => el.classList.toggle('is-on', j === cur));
        scenes.forEach((el, j) => {
          el.classList.toggle('is-on', j === cur);
          const sc = el.querySelector('.sc');
          if (j === cur && live && desk.matches) play(sc); else stop(sc);
        });
      };
      const itemIO = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { cur = items.indexOf(e.target); sync(); } }), { rootMargin: '-50% 0px -50% 0px' });
      items.forEach(el => itemIO.observe(el));
      new IntersectionObserver(es => { live = es[0].isIntersecting; sync(); }, { threshold: 0 }).observe(sv.querySelector('.sv-story'));
      const inlineIO = new IntersectionObserver(es => es.forEach(e => {
        const sc = e.target.querySelector('.sc');
        e.target.classList.toggle('is-on', e.isIntersecting);
        if (e.isIntersecting && !desk.matches) play(sc); else stop(sc);
      }), { threshold: 0.35 });
      sv.querySelectorAll('.sv-inline .sv-scene').forEach(el => inlineIO.observe(el));
      desk.addEventListener('change', sync);
      sync();
    }

    // Count-up that always lands on the exact text already in the HTML
    const fmt = (el, v) => {
      const dec = +(el.dataset.dec || 0);
      const s = el.dataset.comma === '1' ? v.toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec }) : v.toFixed(dec);
      return (el.dataset.pre || '') + s + (el.dataset.suf || '');
    };
    const countUp = el => {
      if (el._done) return;
      el._done = true;
      const to = parseFloat(el.dataset.to), fin = el.textContent;
      if (RM || !isFinite(to)) return;
      const t0 = performance.now(), dur = 1400;
      const fr = t => {
        const p = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - p, 3);
        el.textContent = p < 1 ? fmt(el, to * e) : fin;
        if (p < 1) requestAnimationFrame(fr);
      };
      requestAnimationFrame(fr);
    };

    const pv = document.querySelector('.pv');
    if (pv) {
      const tabs = [...pv.querySelectorAll('[role="tab"]')];
      const panels = tabs.map(t => document.getElementById(t.getAttribute('aria-controls')));
      let seen = false;
      const run = p => { if (!seen || !p || p._go) return; p._go = true; p.classList.add('go'); p.querySelectorAll('[data-to]').forEach(countUp); };
      const show = (i, focus) => {
        tabs.forEach((t, j) => { const on = j === i; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; t.classList.toggle('is-on', on); });
        panels.forEach((p, j) => { const on = j === i; p.classList.toggle('is-on', on); p.setAttribute('aria-hidden', String(!on)); });
        run(panels[i]);
        if (focus) tabs[i].focus();
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => show(i));
        t.addEventListener('keydown', e => {
          let n = null;
          if (e.key === 'ArrowDown' || e.key === 'ArrowRight') n = (i + 1) % tabs.length;
          else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
          else if (e.key === 'Home') n = 0;
          else if (e.key === 'End') n = tabs.length - 1;
          if (n !== null) { e.preventDefault(); show(n, true); }
        });
      });
      const pvIO = new IntersectionObserver(es => {
        if (!es[0].isIntersecting) return;
        seen = true;
        run(panels.find(p => p.classList.contains('is-on')));
        pvIO.disconnect();
      }, { threshold: 0.25 });
      pvIO.observe(pv);
    }

    // Engine map: hovering a description or a logo lights its signal; cycles on its own when idle
    const eg = document.querySelector('.eg');
    if (eg) {
      const groups = ['.eg-it', '.eg-node', '.eg-fl'].map(s => [...eg.querySelectorAll(s)]);
      let hot = 0, hover = false, timer = null;
      const set = i => { hot = i; groups.forEach(g => g.forEach((el, j) => el.classList.toggle('is-hot', j === i))); };
      [groups[0], groups[1]].forEach(list => list.forEach((el, i) => {
        el.addEventListener('mouseenter', () => { hover = true; set(i); });
        el.addEventListener('mouseleave', () => { hover = false; });
      }));
      new IntersectionObserver(es => {
        clearInterval(timer);
        if (es[0].isIntersecting && !RM) timer = setInterval(() => { if (!hover) set((hot + 1) % groups[0].length); }, 2600);
      }, { threshold: 0.2 }).observe(eg);
    }
  })();

  // About story: desktop = glyph rail + one chapter at a time with an autoplay timer (stops for good once the reader takes control); mobile = scroll timeline
  (function(){
    const ab = document.querySelector('.ab');
    if (!ab) return;
    const RM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const desk = window.matchMedia('(min-width: 981px)');
    const nodes = [...ab.querySelectorAll('.ab-node')];
    const panels = [...ab.querySelectorAll('.ab-panel')];
    const player = ab.querySelector('.ab-player');
    const stage = ab.querySelector('.ab-stage');
    const count = ab.querySelector('.ab-count b');
    const bar = ab.querySelector('.ab-time i');
    const N = panels.length;
    let cur = 0, auto = !RM, seen = false, hold = false, tm = null;
    if (!auto) ab.classList.add('is-manual');

    const run = () => { if (tm) { if (seen && !hold && !document.hidden) tm.play(); else tm.pause(); } };
    const timer = () => {
      if (tm) { tm.cancel(); tm = null; }
      if (!auto || !desk.matches || !bar || !bar.animate) return;
      const len = panels[cur].textContent.trim().length;
      tm = bar.animate([{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }], { duration: Math.min(12000, Math.max(6500, len * 38)), easing: 'linear', fill: 'forwards' });
      tm.onfinish = () => set(cur + 1);
      run();
    };
    function set(i){
      cur = (i + N) % N;
      nodes.forEach((n, j) => { n.classList.toggle('is-on', j === cur); n.classList.toggle('is-past', j < cur); n.setAttribute('aria-current', j === cur ? 'step' : 'false'); });
      panels.forEach((p, j) => { p.classList.toggle('is-on', j === cur); p.classList.toggle('is-past', j < cur); });
      ab.style.setProperty('--p', String(cur / (N - 1)));
      if (count) count.textContent = String(cur + 1).padStart(2, '0');
      timer();
    }
    const pick = i => { auto = false; ab.classList.add('is-manual'); set(i); };

    nodes.forEach((n, i) => {
      n.addEventListener('click', () => pick(i));
      n.addEventListener('keydown', e => {
        let k = null;
        if (e.key === 'ArrowRight') k = i + 1;
        else if (e.key === 'ArrowLeft') k = i - 1;
        else if (e.key === 'Home') k = 0;
        else if (e.key === 'End') k = N - 1;
        if (k === null) return;
        e.preventDefault();
        k = (k + N) % N;
        pick(k);
        nodes[k].focus();
      });
    });
    ab.querySelector('.ab-prev')?.addEventListener('click', () => pick(cur - 1));
    ab.querySelector('.ab-next')?.addEventListener('click', () => pick(cur + 1));

    // Horizontal swipe on the chapter text (vertical scroll stays native via touch-action: pan-y)
    let sx = 0, sy = 0;
    stage.addEventListener('pointerdown', e => { sx = e.clientX; sy = e.clientY; });
    stage.addEventListener('pointerup', e => {
      const dx = e.clientX - sx, dy = e.clientY - sy;
      if (desk.matches && Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.4) pick(cur + (dx < 0 ? 1 : -1));
    });

    // Timer pauses while the reader hovers or focuses the player, when it is off-screen, or the tab is hidden
    player.addEventListener('mouseenter', () => { hold = true; run(); });
    player.addEventListener('mouseleave', () => { hold = false; run(); });
    player.addEventListener('focusin', () => { hold = true; run(); });
    player.addEventListener('focusout', () => { hold = false; run(); });
    new IntersectionObserver(es => { seen = es[0].isIntersecting; run(); }, { threshold: 0.4 }).observe(player);
    document.addEventListener('visibilitychange', run);

    // Mobile: the chapter crossing the middle of the screen becomes active
    const mIO = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting && !desk.matches) set(panels.indexOf(e.target)); }), { rootMargin: '-42% 0px -52% 0px' });
    panels.forEach(p => mIO.observe(p));
    desk.addEventListener('change', () => set(cur));
    set(0);
  })();
  </script>
</Layout>
