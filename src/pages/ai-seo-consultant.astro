  .s2-left .s2-eyebrow::before{background:linear-gradient(90deg,transparent 0%,var(--acc) 100%)}
  .s2-left .s2-eyebrow:hover::before{background:linear-gradient(90deg,transparent 0%,var(--acc) 60%,var(--acc-lite) 100%)}
  html.light .s2-left .s2-eyebrow{color:var(--acc)}
  html.light .s2-left .s2-eyebrow::before{background:linear-gradient(90deg,transparent 0%,var(--acc) 100%)}
  .s2-title{margin:0;font-size:clamp(33px,4vw,55px);line-height:1.02;letter-spacing:-.022em}
  .s2-l1{display:block;font-family:var(--fu);font-weight:800;color:var(--w);letter-spacing:-.03em;text-shadow:0 3px 30px rgba(0,0,0,.6),0 1px 3px rgba(0,0,0,.5)}
  .s2-l2{display:block;margin-top:.04em;font-family:var(--fd);font-style:italic;font-weight:400;background:linear-gradient(110deg,var(--ac) 0%,#7BAEFF 25%,var(--ac2) 50%,#7BAEFF 75%,var(--ac) 100%);background-size:300% 100%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;filter:drop-shadow(0 8px 22px rgba(79,142,247,.28))}
  html.light .s2-l1{text-shadow:0 3px 24px rgba(120,70,20,.14)}
  html.light .s2-l2{background:linear-gradient(110deg,var(--am) 0%,var(--am-lite) 25%,var(--am2) 50%,var(--am-lite) 75%,var(--am) 100%);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;filter:drop-shadow(0 8px 22px rgba(232,145,60,.3))}
  .s2-right{max-width:560px}
  .s2-body{margin:0;font-family:var(--fu);font-size:clamp(15.5px,1.3vw,18px);line-height:1.8;color:var(--wd)}
  .s2-pull{margin:28px 0 0;padding:6px 0 6px 24px;border-left:2px solid var(--acc);font-family:var(--fu);font-size:clamp(16.5px,1.55vw,20px);font-weight:600;line-height:1.55;letter-spacing:-.01em;color:var(--w)}
  /* smooth, slow entrance only (no in-text gradient animation) */
  .s2-sec .rv{transition:opacity .95s cubic-bezier(.16,1,.3,1),transform .95s cubic-bezier(.16,1,.3,1)}
  @media(max-width:860px){.s2-sec{padding:64px 0}.s2-grid{grid-template-columns:1fr;gap:22px;align-items:start}.s2-right{max-width:none}.s2-left .s2-eyebrow{margin-bottom:18px}}

  /* ============ 3 · ABOUT — one rounded frame, wider, one-screen bento (v2: contained · borderless · dark accent tile) ============ */
  :root{
    --s3-bento-h:clamp(510px,58vh,590px);
    --s3-grid-line:rgba(255,255,255,.025);
    --s3-frame-bg:linear-gradient(158deg,#0f0f14 0%,#08080b 100%);
    --s3-tile:#161620;--s3-tile-h:#1d1d28;
    --s3-photo-bg:radial-gradient(115% 82% at 42% 30%,#1c1e29 0%,#0d0e14 74%);
    --s3-photo-bg2:#0c0d12;
    --s3-dark:radial-gradient(130% 100% at 100% 0%,rgba(79,142,247,.14),transparent 58%),linear-gradient(155deg,#191b24 0%,#0e0f15 100%);
    --s3-dark-tx:rgba(240,241,238,.82);
  }
  html.light{
    --s3-grid-line:rgba(0,0,0,.028);
    --s3-frame-bg:linear-gradient(158deg,#f7f4ed 0%,#ece5d8 100%);
    --s3-tile:#ffffff;--s3-tile-h:#fbf9f4;
    --s3-photo-bg:radial-gradient(115% 82% at 42% 30%,#ffffff 0%,#ece6db 74%);
    --s3-photo-bg2:#ece6db;
    --s3-dark:radial-gradient(130% 100% at 100% 0%,rgba(232,145,60,.16),transparent 58%),linear-gradient(155deg,#1c1d26 0%,#101118 100%);
    --s3-dark-tx:rgba(240,241,238,.85);
  }
  .s3-sec{padding:clamp(30px,3.6vw,52px) clamp(16px,3vw,40px);position:relative}
  .s3-sec .rv{transition:opacity .9s cubic-bezier(.16,1,.3,1),transform .9s cubic-bezier(.16,1,.3,1)}

  .s3-frame{position:relative;max-width:1440px;margin:0 auto;padding:clamp(20px,2.3vw,38px);border-radius:28px;border:1px solid var(--bd);background:var(--s3-frame-bg);overflow:hidden}
  .s3-frame::before{content:'';position:absolute;inset:0;z-index:0;background-image:linear-gradient(to right,var(--s3-grid-line) 1px,transparent 1px),linear-gradient(to bottom,var(--s3-grid-line) 1px,transparent 1px);background-size:46px 46px;-webkit-mask:radial-gradient(135% 100% at 50% 0%,#000 32%,transparent 82%);mask:radial-gradient(135% 100% at 50% 0%,#000 32%,transparent 82%);pointer-events:none}

  /* heading band */
  .s3-head{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:flex-end;gap:clamp(20px,3vw,48px);margin-bottom:clamp(14px,1.6vw,22px)}
  .s3-eyebrow{color:var(--acc)}
  .s3-eyebrow::before{background:linear-gradient(90deg,transparent 0%,var(--acc) 100%)}
  .s3-eyebrow:hover::before{background:linear-gradient(90deg,transparent 0%,var(--acc) 60%,var(--acc-lite) 100%)}
  html.light .s3-eyebrow{color:var(--acc)}
  html.light .s3-eyebrow::before{background:linear-gradient(90deg,transparent 0%,var(--acc) 100%)}
  .s3-head-l{min-width:0}
  .s3-title{margin:10px 0 0;font-size:clamp(29px,3.2vw,44px);line-height:1.04;letter-spacing:-.028em}
  .s3-l1{font-family:var(--fu);font-weight:800;color:var(--w);letter-spacing:-.03em}
  .s3-l2{font-family:var(--fd);font-style:italic;font-weight:400;background:linear-gradient(110deg,var(--ac) 0%,#7BAEFF 25%,var(--ac2) 50%,#7BAEFF 75%,var(--ac) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  html.light .s3-l2{background:linear-gradient(110deg,var(--am) 0%,var(--am-lite) 25%,var(--am2) 50%,var(--am-lite) 75%,var(--am) 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .s3-sub{flex:0 0 auto;max-width:320px;margin:0 0 6px;font-family:var(--fu);font-size:clamp(13px,1vw,15px);line-height:1.6;color:var(--wd);text-align:right}

  /* bento — deterministic heights, top-aligned (no stretch), borderless filled tiles */
  .s3-bento{position:relative;z-index:1;display:grid;grid-template-columns:auto 1fr;gap:clamp(11px,1vw,15px);align-items:start}
  .bt{position:relative;border:0;border-radius:16px;background:var(--s3-tile);transition:transform .5s cubic-bezier(.16,1,.3,1),background .5s}
  .bt:hover{transform:translateY(-4px);background:var(--s3-tile-h)}

  /* photo tile (4:5, contained, name plate + social) */
  .bt-photo{grid-column:1;height:var(--s3-bento-h);aspect-ratio:4/5;width:auto;overflow:hidden;background:var(--s3-photo-bg)}
  .bt-photo:hover{transform:none;background:var(--s3-photo-bg)}
  .s3-glow{position:absolute;z-index:0;top:40%;left:36%;transform:translate(-50%,-50%);width:min(112%,440px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--acc) 26%,transparent) 0%,transparent 66%);filter:blur(24px);opacity:.6;pointer-events:none}
  .s3-img{position:absolute;z-index:1;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top;display:block;filter:contrast(1.02) saturate(1.04);transition:transform .7s cubic-bezier(.16,1,.3,1)}
  .bt-photo:hover .s3-img{transform:scale(1.035)}
  .s3-veil{position:absolute;z-index:2;left:0;right:0;bottom:0;height:38%;background:linear-gradient(180deg,transparent 0%,var(--s3-photo-bg2) 82%);pointer-events:none}
  .s3-plate{position:absolute;z-index:3;left:0;right:0;bottom:0;margin:0;padding:0 18px 18px;display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center}
  .s3-plate-name{font-family:var(--fd);font-style:italic;font-weight:400;font-size:clamp(24px,2.2vw,30px);line-height:1;background:linear-gradient(110deg,var(--ac) 0%,#7BAEFF 32%,var(--ac2) 64%,#7BAEFF 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  html.light .s3-plate-name{background:linear-gradient(110deg,var(--am) 0%,var(--am-lite) 32%,var(--am2) 64%,var(--am-lite) 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .s3-plate-tag{font-family:var(--fm);font-size:9px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--wd)}
  .s3-social{display:flex;gap:8px;margin-top:4px}
  .s3-soc{width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;color:var(--wd);background:color-mix(in srgb,var(--w) 8%,transparent);transition:color .35s,background .35s,transform .35s}
  html.light .s3-soc{background:color-mix(in srgb,#000 6%,transparent)}
  .s3-soc svg{width:15px;height:15px}
  .s3-soc:hover{color:var(--acc);background:color-mix(in srgb,var(--acc) 16%,transparent);transform:translateY(-2px)}

  /* story tiles */
  .s3-stories{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:repeat(3,minmax(min-content,1fr));gap:clamp(11px,1vw,15px);min-height:var(--s3-bento-h)}
  .bt-step{display:flex;flex-direction:column;justify-content:flex-start;gap:clamp(8px,0.9vw,12px);padding:clamp(14px,1.4vw,20px)}
  .bt-s1{grid-column:1;grid-row:1}
  .bt-s2{grid-column:2;grid-row:1}
  .bt-s3{grid-column:1 / 3;grid-row:2}
  .bt-s4{grid-column:1;grid-row:3}
  .bt-s5{grid-column:2;grid-row:3}
  .tl-icon{width:40px;height:40px;border-radius:11px;display:flex;align-items:center;justify-content:center;background:color-mix(in srgb,var(--acc) 12%,transparent);color:var(--acc);flex-shrink:0;transition:background .5s}
  .bt:hover .tl-icon{background:color-mix(in srgb,var(--acc) 20%,transparent)}
  .tl-icon svg{width:20px;height:20px}
  .bt-step p{margin:0;font-family:var(--fu);font-size:clamp(12.5px,0.92vw,14px);line-height:1.55;color:var(--wd)}

  /* dark accent tile (SEO discovery) */
  .bt-s3{background:var(--s3-dark)}
  .bt-s3:hover{background:var(--s3-dark);transform:translateY(-4px)}
  .bt-s3 p{color:var(--s3-dark-tx)}
  .bt-s3 .tl-icon{background:rgba(255,255,255,.07);color:#7BAEFF}
  html.light .bt-s3 .tl-icon{color:#9CC0FF}
  .bt-s3:hover .tl-icon{background:rgba(255,255,255,.12)}

  @media(prefers-reduced-motion:reduce){.bt,.s3-img,.s3-soc{transition:none}}
  @media(max-width:1080px){
    .s3-bento{grid-template-columns:1fr;align-items:stretch}
    .bt-photo{grid-column:1;height:auto;width:100%;max-width:400px;margin:0 auto;aspect-ratio:4/5}
    .s3-stories{min-height:0;grid-template-rows:auto auto auto}
  }
  @media(max-width:640px){
    .s3-head{flex-direction:column;align-items:flex-start;gap:12px}
    .s3-sub{text-align:left;max-width:none}
    .s3-stories{grid-template-columns:1fr;grid-template-rows:auto}
    .bt-s1,.bt-s2,.bt-s3,.bt-s4,.bt-s5{grid-column:1;grid-row:auto}
    .bt-photo{max-width:340px}
  }

  /* VS TABLE */
  .hire-vs-sec{padding:88px 0;background:var(--s1);border-top:1px solid var(--bd);border-bottom:1px solid var(--bd)}
  .hire-vs-hdr{margin-bottom:44px}
  .hire-vs-table{border:1px solid var(--bd);border-radius:16px;overflow:hidden}
  .hire-vs-row{display:grid;grid-template-columns:200px 1fr 1fr;border-bottom:1px solid var(--bd)}
  .hire-vs-row:last-child{border-bottom:none}
  .hire-vs-head{background:var(--s2)}
  .hire-vs-col{padding:15px 20px;font-family:var(--fu);font-size:13.5px;color:var(--wd);line-height:1.5}
  .hire-vs-label{font-family:var(--fm);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--wm);display:flex;align-items:center}
  .hire-vs-label-h{padding:15px 20px}
  .hire-vs-them-h,.hire-vs-me-h{font-family:var(--fm);font-size:10px;letter-spacing:.1em;text-transform:uppercase;padding:15px 20px;display:flex;align-items:center}
  .hire-vs-them-h{color:var(--wm)}
  .hire-vs-me-h{color:var(--ac)}
  .hire-vs-them{color:var(--wm)}
  .hire-vs-me{color:var(--w);font-weight:500;background:rgba(79,142,247,.04)}

  /* RESULTS */
  .hire-results-sec{padding:88px 0}
  .hire-results-hdr{margin-bottom:44px}
  .hire-feat-cite{display:grid;grid-template-columns:300px 1fr;gap:48px;align-items:center;padding:36px;border:1px solid var(--bd);border-radius:20px;background:linear-gradient(180deg,var(--s1) 0%,rgba(15,15,15,.5) 100%);margin-bottom:24px}
  .hire-feat-cat{font-family:var(--fm);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--ac);margin-bottom:10px}
  .hire-feat-n{font-family:var(--fd);font-size:clamp(64px,8vw,104px);font-weight:400;line-height:.85;letter-spacing:-.03em}
  .hire-feat-label{font-family:var(--fu);font-size:13px;color:var(--wd);line-height:1.5;margin-top:10px;max-width:240px}
  .hire-feat-engines-l{font-family:var(--fm);font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--wm);margin-bottom:12px}
  .hire-feat-engines{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px}
  .hire-engine{font-family:var(--fm);font-size:11px;font-weight:500;letter-spacing:.04em;color:var(--ac);padding:6px 12px;border-radius:6px;background:var(--agl);border:1px solid rgba(79,142,247,.24)}
  .hire-feat-note{font-family:var(--fu);font-size:14.5px;color:var(--wd);line-height:1.7;margin:0;max-width:560px}
  .hire-results-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--bd);border:1px solid var(--bd);border-radius:16px;overflow:hidden}
  .hire-result-card{background:var(--s1);padding:28px 24px;display:flex;flex-direction:column;gap:6px;transition:background .2s}
  .hire-result-card:hover{background:var(--s2)}
  .hrc-head{display:flex;flex-direction:column;gap:4px;margin-bottom:6px}
  .hrc-cat{font-family:var(--fm);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--ac)}
  .hrc-service{font-family:var(--fm);font-size:9px;letter-spacing:.06em;text-transform:uppercase;color:var(--wm)}
  .hrc-n{font-family:var(--fd);font-size:clamp(40px,4vw,58px);font-weight:400;line-height:.9;background:var(--ag);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  .hrc-label{font-family:var(--fu);font-size:12px;color:var(--wd);line-height:1.4;margin-bottom:10px;min-height:34px}
  .hrc-metrics{display:flex;flex-direction:column;gap:8px;padding-top:12px;border-top:1px solid var(--bd)}
  .hrc-met{display:flex;flex-direction:column;gap:2px}
  .hrc-met-v{font-family:var(--fu);font-size:12px;font-weight:700;color:var(--w)}
  .hrc-met-l{font-family:var(--fm);font-size:8px;letter-spacing:.08em;text-transform:uppercase;color:var(--wm)}
  .hire-results-note{font-family:var(--fm);font-size:9px;letter-spacing:.06em;color:var(--wm);margin-top:24px;text-transform:uppercase}

  /* AI CITATION RECEIPTS (real browser-mockup screenshots) */
  .hire-proof-sec{padding:88px 0}
  .hire-proof-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:8px}
  .hire-proof-shot{margin:0;display:flex;flex-direction:column;gap:14px}
  .hire-proof-shot img{width:100%;height:auto;display:block;border-radius:16px;border:1px solid var(--bd)}
  .hire-proof-shot figcaption{font-family:var(--fm);font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--wd);line-height:1.55}
  @media(max-width:800px){.hire-proof-grid{grid-template-columns:1fr}}

  /* INDUSTRIES */
  .hire-ind-sec{padding:88px 0;background:var(--s1);border-top:1px solid var(--bd);border-bottom:1px solid var(--bd)}
  .hire-ind-grid{display:grid;grid-template-columns:360px 1fr;gap:64px;align-items:center}
  .hire-ind-p{font-family:var(--fu);font-size:15px;color:var(--wd);line-height:1.8;margin-top:20px;max-width:340px}
  .hire-ind-r{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
  .hire-ind-card{background:var(--bg);border:1px solid var(--bd);border-radius:14px;padding:22px 20px;display:flex;flex-direction:column;gap:6px;transition:border-color .25s,transform .25s}
  .hire-ind-card:hover{border-color:rgba(79,142,247,.4);transform:translateY(-3px)}
  .hire-ind-t{font-family:var(--fu);font-size:16px;font-weight:700;color:var(--w);letter-spacing:-.01em}
  .hire-ind-r-note{font-family:var(--fm);font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:var(--ac)}

  /* ABOUT */
  .hire-about-sec{padding:88px 0}
  .hire-about-grid{display:grid;grid-template-columns:420px 1fr;gap:64px;align-items:start}
  .hire-about-img-wrap{position:relative}
  .hire-about-img{width:100%;height:auto;border-radius:20px;display:block;object-fit:cover;border:1px solid var(--bd)}
  .hire-about-badge{position:absolute;left:16px;bottom:16px;display:inline-flex;align-items:center;gap:8px;background:rgba(8,8,8,.78);backdrop-filter:blur(8px);border:1px solid var(--bd);border-radius:100px;padding:8px 14px;font-family:var(--fm);font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--w)}
  .hire-about-badge-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 0 3px rgba(34,197,94,.18)}
  .hire-about-h{font-family:var(--fd);font-size:clamp(30px,4vw,52px);font-weight:400;line-height:1;letter-spacing:-.022em;color:var(--w);margin:14px 0 24px}
  .hire-about-h em{font-style:italic}
  .hire-about-body p{font-family:var(--fu);font-size:15.5px;color:var(--wd);line-height:1.8;margin:0 0 18px;max-width:640px}
  .hire-about-sign{display:flex;flex-direction:column;gap:4px;margin-top:28px;padding-top:24px;border-top:1px solid var(--bd)}
  .hire-about-sign-name{font-family:var(--fd);font-size:24px;font-style:italic;color:var(--w)}
  .hire-about-sign-role{font-family:var(--fm);font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:var(--wm)}
  .hire-about-link{margin-top:10px;font-family:var(--fu);font-size:14px}

  /* ENGAGEMENT TIERS */
  .hire-eng-sec{padding:88px 0;background:var(--s1);border-top:1px solid var(--bd);border-bottom:1px solid var(--bd)}
  .hire-eng-hdr{margin-bottom:48px}
  .hire-tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .hire-tier{background:var(--bg);border:1px solid var(--bd);border-radius:18px;padding:28px 26px;display:flex;flex-direction:column;gap:14px;transition:border-color .25s,transform .25s}
  .hire-tier:hover{border-color:rgba(79,142,247,.4);transform:translateY(-3px)}
  .hire-tier--mid{border-color:rgba(79,142,247,.45);background:linear-gradient(180deg,rgba(79,142,247,.05) 0%,var(--bg) 60%)}
  .hire-tier-top{display:flex;align-items:center;justify-content:space-between}
  .hire-tier-eye{font-family:var(--fm);font-size:10px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--ac)}
  .hire-tier-tag{font-family:var(--fm);font-size:8px;letter-spacing:.1em;text-transform:uppercase;color:var(--wm);border:1px solid var(--bd);border-radius:100px;padding:4px 9px}
  .hire-tier--mid .hire-tier-tag{color:var(--ac);border-color:rgba(79,142,247,.3)}
  .hire-tier-t{font-family:var(--fd);font-size:27px;font-weight:400;color:var(--w);letter-spacing:-.01em}
  .hire-tier-d{font-family:var(--fu);font-size:14px;color:var(--wd);line-height:1.7;margin:0}
  .hire-tier-list{list-style:none;margin:6px 0 0;padding:18px 0 0;border-top:1px solid var(--bd);display:flex;flex-direction:column;gap:11px}
  .hire-tier-list li{position:relative;padding-left:22px;font-family:var(--fu);font-size:13.5px;color:var(--wd);line-height:1.5}
  .hire-tier-list li::before{content:'';position:absolute;left:0;top:.6em;width:12px;height:2px;background:linear-gradient(90deg,var(--ac),var(--ac2));border-radius:2px}
  .hire-eng-note{font-family:var(--fu);font-size:14px;color:var(--wm);line-height:1.7;margin-top:28px;max-width:720px}

  .hire-faq-sec{padding:88px 0}

  @media(max-width:1100px){.hire-results-grid{grid-template-columns:1fr}.hire-ind-r{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:960px){
    .hire-hero-grid,.hire-ind-grid,.hire-about-grid{grid-template-columns:1fr;gap:40px}
    .hire-about-img-wrap{max-width:420px}
    .hire-tiers{grid-template-columns:1fr}
    .hire-vs-row{grid-template-columns:150px 1fr 1fr}
  }
  @media(max-width:640px){
    .hire-hero{padding:120px 0 0}
    .hire-stats{flex-wrap:wrap;gap:16px}
    .hire-stat-div{display:none}.hire-stat{padding:0}.hide-mob{display:none}
    .hire-vs-row{grid-template-columns:1fr}
    .hire-vs-head{display:none}
    .hire-ind-r{grid-template-columns:1fr 1fr}
  }
  </style>

  <script>
  const prog=document.getElementById('scrollProg');
  window.addEventListener('scroll',()=>{if(prog){const s=document.documentElement;prog.style.width=(s.scrollTop/(s.scrollHeight-s.clientHeight)*100)+'%'}},{passive:true});
  // Cursor handled globally by the .bcur system in Nav.astro (legacy loop removed).
  const ro=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');ro.unobserve(e.target)}})},{threshold:0.1,rootMargin:'0px 0px -40px 0px'});
  document.querySelectorAll('.rv').forEach(el=>ro.observe(el));

  // Hero line-2 repeating typewriter
  (function(){
    const t=document.querySelector('.nh-type');
    if(!t) return;
    const full=t.textContent;
    if(window.matchMedia && window.matchMedia('(prefers-reduced-motion:reduce)').matches) return;
    let i=0, dir=1;
    t.textContent='';
    function tick(){
      if(dir>0){
        t.textContent=full.slice(0,++i);
        if(i>=full.length){dir=-1;setTimeout(tick,2100);return;}
        setTimeout(tick,62);
      } else {
        t.textContent=full.slice(0,--i);
        if(i<=0){dir=1;setTimeout(tick,650);return;}
        setTimeout(tick,32);
      }
    }
    setTimeout(tick,780);
  })();

  document.querySelectorAll('.faq-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const isOpen=btn.getAttribute('aria-expanded')==='true';
      document.querySelectorAll('.faq-btn').forEach(b=>{b.setAttribute('aria-expanded','false');const a=b.closest('.faq-item')?.querySelector('.faq-ans');if(a)a.hidden=true});
      if(!isOpen){btn.setAttribute('aria-expanded','true');const an=btn.closest('.faq-item')?.querySelector('.faq-ans');if(an)an.hidden=false}
    });
  });
  </script>
</Layout>
