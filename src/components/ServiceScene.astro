---
// Animated scenes for the Services story on /ai-seo-consultant.
// The page script steps each scene by adding .st1 ... .stN to .sc; base styles are the start state.
interface Props { k: string }
const { k } = Astro.props;
const geo = ['chatgpt-icon', 'google-icon', 'perplexity-icon', 'copilot-icon', 'google-gemini', 'claude-icon', 'grok-icon', 'deepseek-icon'];
---
{k === 'seo' && (
  <div class="sc sc-seo" data-steps="4" data-tick="780" data-hold="2800">
    <div class="sc-in">
      <div class="sc-q">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
        <span class="sc-q-t"></span>
        <span class="sc-q-c"></span>
      </div>
      <div class="sc-serp">
        {[1, 2, 3].map((n) => (
          <div class={`sc-r sc-r${n}`}><span class="sc-fav"></span><span class="sc-rt"><span class="sc-bt"></span><span class="sc-bu"></span><span class="sc-bd"></span></span></div>
        ))}
        <div class="sc-r sc-you"><span class="sc-fav"></span><span class="sc-rt"><span class="sc-you-t">Your site</span><span class="sc-bu"></span><span class="sc-bd"></span></span><span class="sc-rank">#1</span></div>
      </div>
    </div>
  </div>
)}
{k === 'aeo' && (
  <div class="sc sc-aeo" data-steps="5" data-tick="720" data-hold="2800">
    <div class="sc-in">
      <div class="sc-ask"><span></span></div>
      <div class="sc-ans">
        <div class="sc-ans-h"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.1 6.4 6.4 2.1-6.4 2.1L12 19.5l-2.1-6.4L3.5 11l6.4-2.1z"/></svg><span></span></div>
        <span class="sc-ln sc-l1"></span><span class="sc-ln sc-l2"></span><span class="sc-ln sc-l3"></span><span class="sc-ln sc-l4"></span>
        <div class="sc-cite"><span class="sc-cite-n">1</span><span>Your site</span></div>
      </div>
    </div>
  </div>
)}
{k === 'geo' && (
  <div class="sc sc-geo" data-steps="8" data-tick="430" data-hold="2600">
    <div class="sc-in">
      <div class="sc-gg">
        {geo.map((f, i) => (
          <div class={`sc-g sc-g${i + 1}`}>
            <span class="sc-gt"><img src={`/icons/${f}.svg`} width="40" height="40" alt="" loading="lazy" decoding="async" /></span>
            <span class="sc-gk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
          </div>
        ))}
      </div>
      <div class="sc-gm"><span>Your brand</span><span class="sc-gb"><span class="sc-gf"></span></span></div>
    </div>
  </div>
)}
{k === 'web' && (
  <div class="sc sc-web" data-steps="5" data-tick="760" data-hold="2800">
    <div class="sc-in">
      <div class="sc-br">
        <div class="sc-br-top"><span></span><span></span><span></span><span class="sc-br-url"></span></div>
        <div class="sc-pg">
          <span class="sc-bk sc-bk-nav"></span>
          <span class="sc-bk sc-bk-hero"></span>
          <span class="sc-bk sc-bk-c sc-c1"></span><span class="sc-bk sc-bk-c sc-c2"></span><span class="sc-bk sc-bk-c sc-c3"></span>
          <span class="sc-scan"></span>
        </div>
      </div>
      <ul class="sc-ck">
        {['Semantic HTML', 'Fast load', 'AI-crawlable'].map((t) => (
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{t}</li>
        ))}
      </ul>
    </div>
  </div>
)}

<style>
  .sc{position:absolute;inset:0;container-type:size;border-radius:22px;overflow:hidden;color:var(--w);background:radial-gradient(120% 90% at 10% 0%,color-mix(in srgb,var(--acc) 11%,transparent),transparent 62%),var(--x-panel);box-shadow:var(--x-lift)}
  .sc-in{position:absolute;inset:0;display:flex;flex-direction:column;gap:4.4cqw;padding:7cqw;transition:opacity .45s ease}
  .sc.fd .sc-in{opacity:0}
  .sc.sn *{transition:none!important}

  /* SEO: your result climbs to #1 */
  .sc-q{display:flex;align-items:center;gap:2.4cqw;height:10cqw;padding:0 3.6cqw;border-radius:5cqw;background:var(--x-sk);color:var(--wd)}
  .sc-q svg{width:4cqw;height:4cqw;flex-shrink:0}
  .sc-q-t{display:block;height:1.8cqw;width:46%;border-radius:1cqw;background:var(--x-sk2);transform:scaleX(.08);transform-origin:left;transition:transform .75s cubic-bezier(.65,0,.35,1)}
  .sc-q-c{display:block;width:.5cqw;height:4cqw;border-radius:1px;background:var(--acc);animation:scBlink 1s steps(1) infinite}
  .sc-serp{position:relative;flex:1}
  .sc-r{position:absolute;left:0;right:0;top:0;height:25%;display:flex;align-items:center;gap:3cqw;padding:0 3.2cqw;opacity:0;transform:translateY(calc(var(--p) * 100%));transition:transform 1s cubic-bezier(.7,0,.2,1),opacity .55s ease}
  .sc-r::before{content:'';position:absolute;inset:1cqw 0;border-radius:3cqw;background:var(--x-sk);opacity:.6;transition:background .5s ease,opacity .5s ease}
  .sc-r>*{position:relative}
  .sc-r1{--p:0}.sc-r2{--p:1}.sc-r3{--p:2}.sc-you{--p:3}
  .sc-fav{display:block;width:6cqw;height:6cqw;border-radius:1.8cqw;background:var(--x-sk2);flex-shrink:0}
  .sc-rt{display:flex;flex-direction:column;gap:1.3cqw;flex:1;min-width:0}
  .sc-bt{display:block;height:1.9cqw;width:58%;border-radius:1cqw;background:var(--x-sk2)}
  .sc-bu{display:block;height:1.3cqw;width:34%;border-radius:1cqw;background:var(--x-sk)}
  .sc-bd{display:block;height:1.3cqw;width:82%;border-radius:1cqw;background:var(--x-sk)}
  .sc-you-t{display:block;font-family:var(--fu);font-weight:700;font-size:clamp(11px,3cqw,17px);line-height:1;letter-spacing:-.01em;color:var(--acc)}
  .sc-you .sc-fav{background:var(--acc)}
  .sc-you .sc-bu{background:color-mix(in srgb,var(--acc) 40%,transparent)}
  .sc-rank{margin-left:auto;font-family:var(--fu);font-weight:800;font-size:clamp(14px,5cqw,28px);line-height:1;color:var(--acc);opacity:0;transform:scale(.5);transition:opacity .4s ease,transform .5s cubic-bezier(.34,1.56,.64,1)}
  .sc.st1 .sc-q-t{transform:scaleX(1)}
  .sc.st1 .sc-r{opacity:1}
  .sc.st1 .sc-r2{transition-delay:0s,.08s}
  .sc.st1 .sc-r3{transition-delay:0s,.16s}
  .sc.st1 .sc-you{transition-delay:0s,.24s}
  .sc.st2 .sc-you::before{background:color-mix(in srgb,var(--acc) 16%,transparent);opacity:1}
  .sc.st3 .sc-r1{--p:1}.sc.st3 .sc-r2{--p:2}.sc.st3 .sc-r3{--p:3}.sc.st3 .sc-you{--p:0}
  .sc.st4 .sc-rank{opacity:1;transform:none}

  /* AEO: an answer writes itself and cites your site */
  .sc-ask{align-self:flex-end;display:flex;align-items:center;width:56%;height:10cqw;padding:0 3.6cqw;border-radius:4cqw 4cqw 1.2cqw 4cqw;background:color-mix(in srgb,var(--acc) 16%,transparent);opacity:0;transform:translateY(2.4cqw);transition:opacity .5s ease,transform .6s cubic-bezier(.16,1,.3,1)}
  .sc-ask span{display:block;height:1.8cqw;width:78%;border-radius:1cqw;background:color-mix(in srgb,var(--acc) 45%,transparent)}
  .sc-ans{flex:1;display:flex;flex-direction:column;gap:2.6cqw;padding:5cqw;border-radius:4cqw;background:var(--x-sk);opacity:0;transform:translateY(2.4cqw);transition:opacity .5s ease,transform .6s cubic-bezier(.16,1,.3,1)}
  .sc-ans-h{display:flex;align-items:center;gap:2cqw;margin-bottom:1.2cqw;color:var(--acc)}
  .sc-ans-h svg{width:4.6cqw;height:4.6cqw}
  .sc-ans-h span{display:block;height:1.8cqw;width:26%;border-radius:1cqw;background:var(--x-sk2)}
  .sc-ln{display:block;height:1.7cqw;border-radius:1cqw;background:var(--x-sk2);transform:scaleX(0);transform-origin:left;transition:transform .8s cubic-bezier(.65,0,.35,1),background .5s ease}
  .sc-l1{width:94%}.sc-l2{width:86%}.sc-l3{width:72%}.sc-l4{width:90%}
  .sc-cite{margin-top:auto;align-self:flex-start;display:flex;align-items:center;gap:2cqw;padding:1.6cqw 3.2cqw 1.6cqw 1.6cqw;border-radius:2.4cqw;background:color-mix(in srgb,var(--acc) 15%,transparent);color:var(--acc);font-family:var(--fu);font-weight:700;font-size:clamp(11px,2.9cqw,16px);line-height:1;opacity:0;transform:translateY(1.6cqw) scale(.95);transition:opacity .45s ease,transform .55s cubic-bezier(.34,1.56,.64,1)}
  .sc-cite-n{display:grid;place-items:center;width:4.4cqw;height:4.4cqw;border-radius:1.2cqw;background:var(--acc);color:#fff;font-size:clamp(9px,2.4cqw,13px)}
  .sc.st1 .sc-ask{opacity:1;transform:none}
  .sc.st2 .sc-ans{opacity:1;transform:none}
  .sc.st2 .sc-l1{transform:scaleX(1)}
  .sc.st3 .sc-l2{transform:scaleX(1)}
  .sc.st3 .sc-l3{transform:scaleX(1);transition-delay:.12s,0s}
  .sc.st4 .sc-l4{transform:scaleX(1)}
  .sc.st4 .sc-l3{background:color-mix(in srgb,var(--acc) 60%,transparent)}
  .sc.st5 .sc-cite{opacity:1;transform:none}

  /* GEO: the 8 engines pick up your brand one by one */
  .sc-gg{flex:1;display:grid;grid-template-columns:repeat(4,1fr);gap:4cqw;align-content:center;justify-items:center}
  .sc-g{position:relative}
  .sc-gt{display:grid;place-items:center;width:14cqw;height:14cqw;border-radius:3.6cqw;background:var(--x-tile2);transition:transform .5s cubic-bezier(.34,1.56,.64,1)}
  .sc-gt img{width:56%;height:56%;object-fit:contain}
  .sc-gk{position:absolute;top:-1.4cqw;right:-1.4cqw;display:grid;place-items:center;width:5cqw;height:5cqw;border-radius:50%;background:var(--acc);color:#fff;opacity:0;transform:scale(.3);transition:opacity .35s ease,transform .45s cubic-bezier(.34,1.56,.64,1)}
  .sc-gk svg{width:62%;height:62%}
  .sc-gm{display:flex;align-items:center;gap:3cqw;font-family:var(--fu);font-weight:700;font-size:clamp(11px,2.9cqw,16px);line-height:1;color:var(--w)}
  .sc-gb{display:block;flex:1;height:1.6cqw;border-radius:1cqw;background:var(--x-sk2);overflow:hidden}
  .sc-gf{display:block;height:100%;background:var(--acc);transform:scaleX(0);transform-origin:left;transition:transform .45s cubic-bezier(.65,0,.35,1)}
  .sc.st1 .sc-g1 .sc-gk,.sc.st2 .sc-g2 .sc-gk,.sc.st3 .sc-g3 .sc-gk,.sc.st4 .sc-g4 .sc-gk,.sc.st5 .sc-g5 .sc-gk,.sc.st6 .sc-g6 .sc-gk,.sc.st7 .sc-g7 .sc-gk,.sc.st8 .sc-g8 .sc-gk{opacity:1;transform:none}
  .sc.st1 .sc-g1 .sc-gt,.sc.st2 .sc-g2 .sc-gt,.sc.st3 .sc-g3 .sc-gt,.sc.st4 .sc-g4 .sc-gt,.sc.st5 .sc-g5 .sc-gt,.sc.st6 .sc-g6 .sc-gt,.sc.st7 .sc-g7 .sc-gt,.sc.st8 .sc-g8 .sc-gt{transform:translateY(-1.2cqw)}
  .sc.st1 .sc-gf{transform:scaleX(.125)}
  .sc.st2 .sc-gf{transform:scaleX(.25)}
  .sc.st3 .sc-gf{transform:scaleX(.375)}
  .sc.st4 .sc-gf{transform:scaleX(.5)}
  .sc.st5 .sc-gf{transform:scaleX(.625)}
  .sc.st6 .sc-gf{transform:scaleX(.75)}
  .sc.st7 .sc-gf{transform:scaleX(.875)}
  .sc.st8 .sc-gf{transform:scaleX(1)}

  /* Web: a page assembles, a crawler scans it */
  .sc-br{flex:1;display:flex;flex-direction:column;border-radius:3.6cqw;background:var(--x-sk);overflow:hidden}
  .sc-br-top{display:flex;align-items:center;gap:1.4cqw;height:8cqw;padding:0 3cqw;background:var(--x-sk)}
  .sc-br-top span{display:block;width:1.8cqw;height:1.8cqw;border-radius:50%;background:var(--x-sk2)}
  .sc-br-top .sc-br-url{width:42%;height:2.6cqw;margin-left:2cqw;border-radius:1.4cqw}
  .sc-pg{position:relative;flex:1;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:2.6cqw 1fr 11cqw;gap:2.6cqw;padding:3.6cqw}
  .sc-bk{display:block;border-radius:1.8cqw;background:var(--x-sk2);opacity:0;transform:translateY(2cqw);transition:opacity .5s ease,transform .6s cubic-bezier(.16,1,.3,1)}
  .sc-bk-nav{grid-column:1/-1}
  .sc-bk-hero{grid-column:1/-1;background:color-mix(in srgb,var(--acc) 20%,transparent)}
  .sc-scan{position:absolute;left:0;right:0;top:0;height:.6cqw;background:linear-gradient(90deg,transparent,var(--acc),transparent);opacity:0;transition:top 1.15s linear,opacity .3s ease}
  .sc-ck{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:1.6cqw 4cqw}
  .sc-ck li{display:flex;align-items:center;gap:1.6cqw;font-family:var(--fu);font-weight:600;font-size:clamp(10px,2.6cqw,15px);line-height:1;color:var(--wd);opacity:0;transform:translateY(1.4cqw);transition:opacity .45s ease,transform .5s cubic-bezier(.16,1,.3,1)}
  .sc-ck svg{width:3.6cqw;height:3.6cqw;color:var(--acc)}
  .sc.st1 .sc-bk-nav,.sc.st1 .sc-bk-hero{opacity:1;transform:none}
  .sc.st1 .sc-bk-hero{transition-delay:.12s}
  .sc.st2 .sc-bk-c{opacity:1;transform:none}
  .sc.st2 .sc-c2{transition-delay:.1s}
  .sc.st2 .sc-c3{transition-delay:.2s}
  .sc.st3 .sc-scan{opacity:1;top:calc(100% - .6cqw)}
  .sc.st4 .sc-scan{opacity:0}
  .sc.st4 .sc-ck li:nth-child(-n+2){opacity:1;transform:none}
  .sc.st4 .sc-ck li:nth-child(2){transition-delay:.15s}
  .sc.st5 .sc-ck li{opacity:1;transform:none}

  @keyframes scBlink{50%{opacity:0}}
  :global(.sv-scene:not(.is-on)) .sc-q-c{animation-play-state:paused}
  @media(prefers-reduced-motion:reduce){.sc-q-c{animation:none}}
</style>
